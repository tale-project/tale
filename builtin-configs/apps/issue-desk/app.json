{
  "name": "Issue resolution desk",
  "description": "A config-driven, repo-agnostic issue-resolution desk. GitHub issues flow through a shared sandbox with four phases — Advise, Execute, Grade, Dream — then a human merges.",
  "icon": "ticket",
  "scope": "project",
  "messageNamespace": "issueDesk",
  "workflows": ["issue-desk/desk-process", "issue-desk/reconcile"],
  "agents": [
    "desk-advisor",
    "desk-implementer",
    "desk-reviewer",
    "desk-dreamer"
  ],
  "roles": {
    "advisor": "issue-desk/desk-advisor",
    "implementer": "issue-desk/desk-implementer",
    "reviewer": "issue-desk/desk-reviewer",
    "dreamer": "issue-desk/desk-dreamer"
  },
  "capabilities": {
    "workflows": ["issue-desk/desk-process", "issue-desk/reconcile"],
    "roles": [
      "issue-desk/desk-advisor",
      "issue-desk/desk-implementer",
      "issue-desk/desk-reviewer",
      "issue-desk/desk-dreamer"
    ],
    "functions": [
      { "path": "tasks/queries:listTasksByProjectPaginated", "mode": "query" },
      {
        "path": "tasks/queries:listExternalKeysByProject",
        "mode": "query"
      },
      { "path": "workflow_executions/queries:listExecutions", "mode": "query" },
      { "path": "agents/file_actions:listAppAgents", "mode": "action" },
      { "path": "agents/file_actions:readAgent", "mode": "action" },
      { "path": "agents/file_actions:saveAgent", "mode": "action" },
      { "path": "agents/agent_env:listAgentEnv", "mode": "query" },
      { "path": "agents/agent_env_actions:setAgentEnvVar", "mode": "action" },
      { "path": "agents/agent_env:deleteAgentEnvVar", "mode": "mutation" },
      { "path": "workflows/file_actions:readWorkflow", "mode": "action" },
      { "path": "tasks/mutations:assignTask", "mode": "mutation" },
      { "path": "tasks/mutations:updateTaskStatus", "mode": "mutation" },
      { "path": "tasks/public_actions:startTaskWorkflow", "mode": "action" },
      {
        "path": "integrations/public_actions:listUntrackedGitHubIssues",
        "mode": "action"
      },
      {
        "path": "tasks/public_actions:createTaskFromExternalIssue",
        "mode": "action"
      },
      {
        "path": "tasks/public_actions:mergeTaskPullRequest",
        "mode": "action"
      }
    ]
  },
  "requires": {
    "integrations": ["github"],
    "config": [
      {
        "key": "repository",
        "type": "string",
        "labelKey": "issueDesk.config.repository",
        "placeholderKey": "issueDesk.config.repositoryPlaceholder",
        "derive": {
          "pattern": "^(?:https?://github\\.com/)?([^/\\s]+)/([^/\\s#]+?)(?:\\.git)?/?$",
          "into": ["owner", "repo"]
        }
      },
      {
        "key": "testCommand",
        "type": "string",
        "optional": true,
        "labelKey": "issueDesk.config.testCommand",
        "placeholderKey": "issueDesk.config.testCommandPlaceholder"
      },
      {
        "key": "repoNotes",
        "type": "string",
        "optional": true,
        "labelKey": "issueDesk.config.repoNotes",
        "placeholderKey": "issueDesk.config.repoNotesPlaceholder",
        "multiline": true
      }
    ]
  }
}
