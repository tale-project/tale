{
  "title": "GitHub",
  "description": "Manage repositories, issues, and pull requests on GitHub.",
  "labels": ["Developer"],
  "version": 1,
  "bundles": {
    "agents": ["pull-request-reviewer", "issue-triager"],
    "workflows": [
      "github/sync-issues-from-github",
      "github/review-pull-request-in-github"
    ]
  },
  "authMethod": "bearer_token",
  "supportedAuthMethods": ["bearer_token"],
  "secretBindings": ["accessToken"],
  "allowedHosts": ["api.github.com"],
  "operations": [
    {
      "name": "list_repos",
      "title": "List Repositories",
      "description": "List repositories for the authenticated user",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number",
            "description": "Number of results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "required": false
          },
          "sort": {
            "type": "string",
            "description": "Sort field: created, updated, pushed, or full_name",
            "required": false
          },
          "visibility": {
            "type": "string",
            "description": "Filter by visibility: all, public, or private",
            "required": false
          }
        }
      }
    },
    {
      "name": "get_repo",
      "title": "Get Repository",
      "description": "Get a single repository by owner and name",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          }
        }
      }
    },
    {
      "name": "list_issues",
      "title": "List Issues",
      "description": "List issues for a repository",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "state": {
            "type": "string",
            "description": "Filter by state: open, closed, or all",
            "required": false
          },
          "per_page": {
            "type": "number",
            "description": "Number of results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "required": false
          },
          "labels": {
            "type": "string",
            "description": "Comma-separated list of label names to filter by",
            "required": false
          },
          "sort": {
            "type": "string",
            "description": "Sort field: created, updated, or comments",
            "required": false
          },
          "direction": {
            "type": "string",
            "description": "Sort direction: asc or desc",
            "required": false
          }
        }
      }
    },
    {
      "name": "get_issue",
      "title": "Get Issue",
      "description": "Get a single issue by number",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "issue_number": {
            "type": "number",
            "description": "Issue number",
            "required": true
          }
        }
      }
    },
    {
      "name": "create_issue",
      "title": "Create Issue",
      "description": "Create a new issue in a repository",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "title": {
            "type": "string",
            "description": "Issue title",
            "required": true
          },
          "body": {
            "type": "string",
            "description": "Issue body content (Markdown supported)",
            "required": false
          },
          "labels": {
            "type": "array",
            "description": "Array of label names to apply",
            "required": false
          },
          "assignees": {
            "type": "array",
            "description": "Array of usernames to assign",
            "required": false
          }
        }
      }
    },
    {
      "name": "list_pull_requests",
      "title": "List Pull Requests",
      "description": "List pull requests for a repository",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "head": {
            "type": "string",
            "description": "Filter by head branch in the form user:ref-name (e.g. octocat:feature-1)",
            "required": false
          },
          "base": {
            "type": "string",
            "description": "Filter by base branch name (e.g. main)",
            "required": false
          },
          "state": {
            "type": "string",
            "description": "Filter by state: open, closed, or all",
            "required": false
          },
          "per_page": {
            "type": "number",
            "description": "Number of results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "required": false
          },
          "sort": {
            "type": "string",
            "description": "Sort field: created, updated, popularity, or long-running",
            "required": false
          },
          "direction": {
            "type": "string",
            "description": "Sort direction: asc or desc",
            "required": false
          }
        }
      }
    },
    {
      "name": "get_pull_request",
      "title": "Get Pull Request",
      "description": "Get a single pull request by number",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          }
        }
      }
    },
    {
      "name": "merge_pull_request",
      "title": "Merge Pull Request",
      "description": "Merge a pull request into its base branch",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          },
          "merge_method": {
            "type": "string",
            "description": "merge | squash | rebase (defaults to merge)",
            "required": false
          },
          "commit_title": {
            "type": "string",
            "description": "Title for the merge commit",
            "required": false
          },
          "commit_message": {
            "type": "string",
            "description": "Extra detail appended to the merge commit message",
            "required": false
          }
        }
      }
    },
    {
      "name": "create_pull_request",
      "title": "Create Pull Request",
      "description": "Create a new pull request in a repository",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "title": {
            "type": "string",
            "description": "Pull request title",
            "required": true
          },
          "head": {
            "type": "string",
            "description": "The branch (or user:branch) containing the changes",
            "required": true
          },
          "base": {
            "type": "string",
            "description": "The branch to merge changes into",
            "required": true
          },
          "body": {
            "type": "string",
            "description": "Pull request body content (Markdown supported)",
            "required": false
          }
        }
      }
    },
    {
      "name": "get_pull_request_files",
      "title": "Get Pull Request Files",
      "description": "List the files changed in a pull request (filename, status, additions, deletions, patch)",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          },
          "per_page": {
            "type": "number",
            "description": "Results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number",
            "required": false
          }
        }
      }
    },
    {
      "name": "get_pull_request_diff",
      "title": "Get Pull Request Diff",
      "description": "Get the raw unified diff for a pull request",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          }
        }
      }
    },
    {
      "name": "create_pull_request_review",
      "title": "Create Pull Request Review",
      "description": "Submit a review on a pull request (APPROVE, REQUEST_CHANGES, or COMMENT) with an optional body and inline comments",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          },
          "event": {
            "type": "string",
            "description": "APPROVE | REQUEST_CHANGES | COMMENT",
            "required": true
          },
          "body": {
            "type": "string",
            "description": "Overall review summary (Markdown). Required for REQUEST_CHANGES and COMMENT; optional for APPROVE.",
            "required": false
          },
          "commit_id": {
            "type": "string",
            "description": "SHA the review applies to (defaults to latest)",
            "required": false
          },
          "comments": {
            "type": "array",
            "description": "Inline review comments [{ path, line, body }]",
            "required": false
          }
        }
      }
    },
    {
      "name": "create_pull_request_review_comment",
      "title": "Create Pull Request Review Comment",
      "description": "Add a single inline comment on a line of a pull request diff",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "pull_number": {
            "type": "number",
            "description": "Pull request number",
            "required": true
          },
          "body": {
            "type": "string",
            "description": "Comment body (Markdown)",
            "required": true
          },
          "commit_id": {
            "type": "string",
            "description": "SHA the comment applies to",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "File path the comment is on",
            "required": true
          },
          "line": {
            "type": "number",
            "description": "Line number in the diff",
            "required": false
          },
          "side": {
            "type": "string",
            "description": "LEFT or RIGHT",
            "required": false
          },
          "start_line": {
            "type": "number",
            "description": "Start line for a multi-line comment",
            "required": false
          }
        }
      }
    },
    {
      "name": "list_issue_comments",
      "title": "List Issue Comments",
      "description": "List comments on an issue or pull request conversation",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "issue_number": {
            "type": "number",
            "description": "Issue or pull request number",
            "required": true
          },
          "per_page": {
            "type": "number",
            "description": "Results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number",
            "required": false
          }
        }
      }
    },
    {
      "name": "create_issue_comment",
      "title": "Create Issue Comment",
      "description": "Add a comment to an issue or pull request conversation",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "issue_number": {
            "type": "number",
            "description": "Issue or pull request number",
            "required": true
          },
          "body": {
            "type": "string",
            "description": "Comment body (Markdown)",
            "required": true
          }
        }
      }
    },
    {
      "name": "update_issue",
      "title": "Update Issue",
      "description": "Update an issue's title, body, state, labels, assignees, or milestone",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "issue_number": {
            "type": "number",
            "description": "Issue number",
            "required": true
          },
          "title": {
            "type": "string",
            "description": "New title",
            "required": false
          },
          "body": {
            "type": "string",
            "description": "New body (Markdown)",
            "required": false
          },
          "state": {
            "type": "string",
            "description": "open | closed",
            "required": false
          },
          "labels": {
            "type": "array",
            "description": "Replace the issue's labels",
            "required": false
          },
          "assignees": {
            "type": "array",
            "description": "Replace the issue's assignees (logins)",
            "required": false
          },
          "milestone": {
            "type": "number",
            "description": "Milestone number (or null to clear)",
            "required": false
          }
        }
      }
    },
    {
      "name": "add_labels_to_issue",
      "title": "Add Labels to Issue",
      "description": "Add labels to an issue or pull request (additive, does not remove existing labels)",
      "operationType": "write",
      "requiresApproval": true,
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "issue_number": {
            "type": "number",
            "description": "Issue or pull request number",
            "required": true
          },
          "labels": {
            "type": "array",
            "description": "Label names to add",
            "required": true
          }
        }
      }
    },
    {
      "name": "list_commits",
      "title": "List Commits",
      "description": "List commits for a repository",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or organization)",
            "required": true
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "required": true
          },
          "per_page": {
            "type": "number",
            "description": "Number of results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "required": false
          },
          "sha": {
            "type": "string",
            "description": "Branch name or commit SHA to list commits from",
            "required": false
          }
        }
      }
    },
    {
      "name": "search_code",
      "title": "Search Code",
      "description": "Search for code across GitHub repositories",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query (supports GitHub search qualifiers like repo:, language:, path:)",
            "required": true
          },
          "per_page": {
            "type": "number",
            "description": "Number of results per page (max 100)",
            "required": false
          },
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "required": false
          }
        }
      }
    }
  ],
  "connectionConfig": {
    "apiEndpoint": "https://api.github.com",
    "timeout": 30000
  },
  "capabilities": {
    "canSync": true,
    "syncFrequency": "0 */6 * * *"
  }
}
