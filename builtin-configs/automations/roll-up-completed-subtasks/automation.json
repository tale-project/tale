{
  "name": "Roll up completed subtasks",
  "description": "Moves a parent task forward once all of its subtasks have finished.",
  "i18n": {
    "de": {
      "name": "Erledigte Unteraufgaben zusammenführen",
      "description": "Bringt eine übergeordnete Aufgabe voran, sobald alle ihre Unteraufgaben abgeschlossen sind."
    },
    "fr": {
      "name": "Consolider les sous-tâches terminées",
      "description": "Fait avancer la tâche parente une fois toutes ses sous-tâches terminées."
    }
  },
  "hidden": true,
  "autoInstall": true,
  "icon": "git-merge",
  "folder": "tasks",
  "labels": ["Tasks"],
  "scope": "org",
  "workflow": {
    "version": "1.0.0",
    "triggers": {
      "events": [
        {
          "eventType": "task.status_changed",
          "eventFilter": {
            "toStatus": "done"
          }
        },
        {
          "eventType": "task.status_changed",
          "eventFilter": {
            "toStatus": "cancelled"
          }
        }
      ]
    },
    "config": {
      "timeout": 600000,
      "variables": {
        "workflowId": "tasks_subtask_rollup"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "guard"
        }
      },
      {
        "stepSlug": "guard",
        "name": "Subtasks only",
        "stepType": "condition",
        "config": {
          "expression": "input.task.parentTaskId",
          "description": "Root tasks have no parent to roll up into."
        },
        "nextSteps": {
          "true": "progress",
          "false": "done"
        }
      },
      {
        "stepSlug": "progress",
        "name": "Check sibling completion",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "subtask_progress",
            "taskId": "{{input.task._id}}"
          }
        },
        "nextSteps": {
          "success": "all_closed"
        }
      },
      {
        "stepSlug": "all_closed",
        "name": "All siblings closed and parent still open?",
        "stepType": "condition",
        "config": {
          "expression": "steps.progress.output.data.allClosed == true && steps.progress.output.data.parentArchived == false && steps.progress.output.data.parentStatus != 'done' && steps.progress.output.data.parentStatus != 'cancelled' && steps.progress.output.data.parentStatus != 'in_review'",
          "description": "Only the run that closes the LAST subtask advances the parent; a parent already at In review (or closed) is left alone."
        },
        "nextSteps": {
          "true": "rollup_comment",
          "false": "done"
        }
      },
      {
        "stepSlug": "rollup_comment",
        "name": "Post the rollup note",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "comment",
            "taskId": "{{steps.progress.output.data.parentTaskId}}",
            "body": "[automated] 📦 All {{steps.progress.output.data.total}} subtasks are closed — moving this task to In review for sign-off."
          }
        },
        "nextSteps": {
          "success": "parent_to_review"
        }
      },
      {
        "stepSlug": "parent_to_review",
        "name": "Move the parent to In review",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "update_status",
            "taskId": "{{steps.progress.output.data.parentTaskId}}",
            "status": "in_review"
          }
        },
        "nextSteps": {
          "success": "done"
        }
      },
      {
        "stepSlug": "done",
        "name": "Done",
        "stepType": "output",
        "config": {},
        "nextSteps": {}
      }
    ]
  }
}
