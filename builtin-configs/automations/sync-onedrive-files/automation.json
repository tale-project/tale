{
  "name": "Sync OneDrive files",
  "description": "Keeps the knowledge library in step with a OneDrive folder on a schedule.",
  "i18n": {
    "de": {
      "name": "OneDrive-Dateien synchronisieren",
      "description": "Hält die Wissensbibliothek nach Zeitplan mit einem OneDrive-Ordner auf gleichem Stand."
    },
    "fr": {
      "name": "Synchroniser les fichiers OneDrive",
      "description": "Garde la bibliothèque de connaissances alignée sur un dossier OneDrive selon un planning."
    }
  },
  "hidden": true,
  "autoInstall": true,
  "icon": "refresh-cw",
  "folder": "onedrive/sync-files",
  "labels": ["Knowledge", "OneDrive"],
  "scope": "org",
  "workflow": {
    "version": "2.0.0",
    "triggers": {
      "schedules": [
        {
          "cron": "*/15 * * * *",
          "timezone": "UTC"
        }
      ]
    },
    "config": {
      "timeout": 600000,
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMs": 2000
      },
      "variables": {
        "organizationId": "org_demo"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "list_active_configs"
        }
      },
      {
        "stepSlug": "list_active_configs",
        "name": "List Active Sync Configurations",
        "stepType": "action",
        "config": {
          "type": "onedrive",
          "parameters": {
            "operation": "list_active_configs"
          }
        },
        "nextSteps": {
          "success": "check_has_configs"
        }
      },
      {
        "stepSlug": "check_has_configs",
        "name": "Skip Loop If No Active Configs",
        "stepType": "condition",
        "config": {
          "expression": "(steps.list_active_configs.output.data.configs | length) > 0",
          "description": "Loop steps throw on an empty items array; route the empty case straight to the terminal so a org with no active sync configs completes cleanly."
        },
        "nextSteps": {
          "true": "loop_configs",
          "false": "noop"
        }
      },
      {
        "stepSlug": "loop_configs",
        "name": "Loop Through Sync Configurations",
        "stepType": "loop",
        "config": {
          "continueOnError": true,
          "itemVariable": "config",
          "items": "{{steps.list_active_configs.output.data.configs}}"
        },
        "nextSteps": {
          "done": "noop",
          "loop": "sync_one_config"
        }
      },
      {
        "stepSlug": "sync_one_config",
        "name": "Sync One Configuration",
        "stepType": "action",
        "config": {
          "type": "onedrive",
          "parameters": {
            "operation": "sync_one_config",
            "configId": "{{loop.item.configId}}",
            "userId": "{{loop.item.userId}}",
            "itemType": "{{loop.item.itemType}}",
            "itemId": "{{loop.item.itemId}}",
            "itemName": "{{loop.item.itemName}}",
            "itemPath": "{{loop.item.itemPath}}",
            "teamId": "{{loop.item.teamId}}"
          }
        },
        "nextSteps": {
          "success": "loop_configs"
        }
      },
      {
        "stepSlug": "noop",
        "name": "Done",
        "stepType": "output",
        "config": {},
        "nextSteps": {}
      }
    ]
  }
}
