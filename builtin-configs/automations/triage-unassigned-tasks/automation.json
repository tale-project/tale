{
  "name": "Triage unassigned tasks",
  "description": "Scores new and reopened tasks and routes each to the best-suited agent.",
  "i18n": {
    "de": {
      "name": "Unzugewiesene Aufgaben sichten",
      "description": "Bewertet neue und wiedereröffnete Aufgaben und leitet jede an den passendsten Agenten weiter."
    },
    "fr": {
      "name": "Trier les tâches non assignées",
      "description": "Évalue les tâches nouvelles ou rouvertes et les confie à l'agent le plus adapté."
    }
  },
  "hidden": true,
  "autoInstall": true,
  "icon": "list-checks",
  "folder": "tasks",
  "labels": ["Tasks"],
  "scope": "org",
  "workflow": {
    "version": "1.0.0",
    "triggers": {
      "events": [
        {
          "eventType": "task.created"
        },
        {
          "eventType": "task.status_changed",
          "eventFilter": {
            "fromStatus": "backlog",
            "toStatus": "todo"
          }
        }
      ]
    },
    "config": {
      "timeout": 600000,
      "variables": {
        "workflowId": "tasks_unassigned_triage"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "guard"
        }
      },
      {
        "stepSlug": "guard",
        "name": "Unassigned root tasks at To do only",
        "stepType": "condition",
        "config": {
          "expression": "!input.task.assigneeId && !input.task.parentTaskId && !input.task.archivedAt && input.task.status == 'todo'",
          "description": "Pre-assigned tasks already have an owner; subtasks were just placed by a decomposing manager. A task.created at 'backlog' (a synced proposal) is EXCLUDED here on purpose — it is scored only when the second trigger (task.status_changed backlog->todo) fires on a human 'Start', never on the bare creation event."
        },
        "nextSteps": {
          "true": "candidates",
          "false": "done"
        }
      },
      {
        "stepSlug": "candidates",
        "name": "List assignable agents",
        "stepType": "action",
        "config": {
          "type": "agent",
          "parameters": {
            "operation": "list_task_candidates",
            "taskId": "{{input.task._id}}"
          }
        },
        "nextSteps": {
          "success": "has_candidates"
        }
      },
      {
        "stepSlug": "has_candidates",
        "name": "Any candidates?",
        "stepType": "condition",
        "config": {
          "expression": "(steps.candidates.output.data.candidates | length) > 0"
        },
        "nextSteps": {
          "true": "score",
          "false": "done"
        }
      },
      {
        "stepSlug": "score",
        "name": "Score candidates against the task",
        "stepType": "llm",
        "config": {
          "name": "Task triage scorer",
          "outputFormat": "json",
          "outputSchema": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "description": "The best-matching agent slug, exactly as it appears in the candidate list."
              },
              "confidence": {
                "type": "number",
                "description": "0 to 1: how confident you are this agent should own the task."
              },
              "reason": {
                "type": "string",
                "description": "One short sentence explaining the match (shown to humans)."
              }
            },
            "required": ["slug", "confidence", "reason"]
          },
          "systemPrompt": "You route project-board tasks to AI agents. Pick the single best agent for the task from the candidate list using their descriptions; prefer candidates marked preferred. Score conservatively: use confidence above 0.7 only when the task clearly falls inside one agent's specialty; use a low confidence when several agents fit equally, the task is ambiguous, or it likely needs a human. Reply with the JSON object only.",
          "userPrompt": "Task title: {{input.task.title}}\n\nTask description:\n{{input.task.description}}\n\nLabels: {{input.task.labels}}\n\nCandidates (slug, description, isManager, preferred):\n{{steps.candidates.output.data.candidates}}"
        },
        "nextSteps": {
          "success": "recheck"
        }
      },
      {
        "stepSlug": "recheck",
        "name": "Re-check the task (still unassigned?)",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "get",
            "taskId": "{{input.task._id}}"
          }
        },
        "nextSteps": {
          "success": "still_unassigned"
        }
      },
      {
        "stepSlug": "still_unassigned",
        "name": "Nobody claimed it meanwhile?",
        "stepType": "condition",
        "config": {
          "expression": "steps.recheck.output.data.task != null && !steps.recheck.output.data.task.assigneeId && !steps.recheck.output.data.task.archivedAt",
          "description": "A human (or an agent claim) may have assigned the task while scoring ran — their choice wins."
        },
        "nextSteps": {
          "true": "confident",
          "false": "done"
        }
      },
      {
        "stepSlug": "confident",
        "name": "Confident enough to auto-assign?",
        "stepType": "condition",
        "config": {
          "expression": "steps.score.output.data.confidence >= 0.7",
          "description": "The auto-assign bar. Lower it for more automation, raise it for more human routing."
        },
        "nextSteps": {
          "true": "assign_comment",
          "false": "suggest"
        }
      },
      {
        "stepSlug": "assign_comment",
        "name": "Explain the auto-assignment",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "comment",
            "taskId": "{{input.task._id}}",
            "body": "[automated] 🤖 Auto-assigned to {{steps.score.output.data.slug}} — {{steps.score.output.data.reason}}"
          }
        },
        "nextSteps": {
          "success": "assign"
        }
      },
      {
        "stepSlug": "assign",
        "name": "Assign the agent (starts the execution loop)",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "assign",
            "taskId": "{{input.task._id}}",
            "assigneeType": "agent",
            "assigneeId": "{{steps.score.output.data.slug}}"
          }
        },
        "nextSteps": {
          "success": "done"
        }
      },
      {
        "stepSlug": "suggest",
        "name": "Leave an assignment suggestion",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "comment",
            "taskId": "{{input.task._id}}",
            "body": "[automated] 💡 Assignment suggestion: {{steps.score.output.data.slug}} (confidence {{steps.score.output.data.confidence}}) — {{steps.score.output.data.reason}} Assign from the board to start work."
          }
        },
        "nextSteps": {
          "success": "done"
        }
      },
      {
        "stepSlug": "done",
        "name": "Done",
        "stepType": "output",
        "config": {},
        "nextSteps": {}
      }
    ]
  }
}
