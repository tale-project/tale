{
  "name": "Archive closed tasks",
  "description": "Nightly cleanup that archives tasks that have been done or cancelled for a while.",
  "i18n": {
    "de": {
      "name": "Geschlossene Aufgaben archivieren",
      "description": "Nächtliche Aufräumrunde, die länger erledigte oder abgebrochene Aufgaben archiviert."
    },
    "fr": {
      "name": "Archiver les tâches fermées",
      "description": "Nettoyage nocturne qui archive les tâches terminées ou annulées depuis un moment."
    }
  },
  "hidden": true,
  "autoInstall": true,
  "icon": "archive",
  "folder": "projects/tasks/archive-closed",
  "labels": ["Tasks"],
  "scope": "org",
  "workflow": {
    "version": "1.0.0",
    "triggers": {
      "schedules": [
        {
          "cron": "30 3 * * *",
          "timezone": "UTC"
        }
      ]
    },
    "config": {
      "timeout": 600000,
      "variables": {
        "workflowId": "tasks_auto_archive"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "sweep"
        }
      },
      {
        "stepSlug": "sweep",
        "name": "Find long-closed tasks",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "sweep",
            "kind": "archivable",
            "olderThanDays": 30,
            "limit": 50
          }
        },
        "nextSteps": {
          "success": "has_items"
        }
      },
      {
        "stepSlug": "has_items",
        "name": "Anything to archive?",
        "stepType": "condition",
        "config": {
          "expression": "(steps.sweep.output.data.tasks | length) > 0",
          "description": "The loop step throws on an empty items array — route the empty case straight to done."
        },
        "nextSteps": {
          "true": "loop_archive",
          "false": "done"
        }
      },
      {
        "stepSlug": "loop_archive",
        "name": "Loop over archivable tasks",
        "stepType": "loop",
        "config": {
          "continueOnError": true,
          "itemVariable": "closedTask",
          "items": "{{steps.sweep.output.data.tasks}}"
        },
        "nextSteps": {
          "loop": "archive",
          "done": "done"
        }
      },
      {
        "stepSlug": "archive",
        "name": "Archive (re-checks it is still closed)",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "archive",
            "taskId": "{{loop.item.taskId}}"
          }
        },
        "nextSteps": {
          "success": "loop_archive"
        }
      },
      {
        "stepSlug": "done",
        "name": "Done",
        "stepType": "output",
        "config": {},
        "nextSteps": {}
      }
    ]
  }
}
