{
  "name": "Remind pending reviewers",
  "description": "Nudges reviewers twice an hour while work sits waiting at In review.",
  "i18n": {
    "de": {
      "name": "Ausstehende Prüfer erinnern",
      "description": "Erinnert Prüfer zweimal pro Stunde, solange Arbeit auf die Prüfung wartet."
    },
    "fr": {
      "name": "Relancer les relecteurs en attente",
      "description": "Relance les relecteurs deux fois par heure tant que le travail attend en relecture."
    }
  },
  "hidden": true,
  "autoInstall": true,
  "icon": "bell",
  "labels": ["Tasks"],
  "scope": "org",
  "workflow": {
    "version": "1.0.0",
    "triggers": {
      "schedules": [
        {
          "cron": "10,40 * * * *",
          "timezone": "UTC"
        }
      ]
    },
    "config": {
      "timeout": 600000,
      "variables": {
        "workflowId": "tasks_review_reminders"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "sweep_reviews"
        }
      },
      {
        "stepSlug": "sweep_reviews",
        "name": "Sweep pending task reviews",
        "stepType": "action",
        "config": {
          "type": "approval",
          "parameters": {
            "operation": "sweep_pending",
            "resourceType": "task_review",
            "remindAfterHours": 4,
            "escalateAfterHours": 24,
            "limit": 50
          }
        },
        "nextSteps": {
          "success": "has_reviews"
        }
      },
      {
        "stepSlug": "has_reviews",
        "name": "Any review reminders due?",
        "stepType": "condition",
        "config": {
          "expression": "(steps.sweep_reviews.output.data.approvals | length) > 0"
        },
        "nextSteps": {
          "true": "loop_reviews",
          "false": "sweep_inputs"
        }
      },
      {
        "stepSlug": "loop_reviews",
        "name": "Loop over due review reminders",
        "stepType": "loop",
        "config": {
          "continueOnError": true,
          "itemVariable": "review",
          "items": "{{steps.sweep_reviews.output.data.approvals}}"
        },
        "nextSteps": {
          "loop": "review_is_remind",
          "done": "sweep_inputs"
        }
      },
      {
        "stepSlug": "review_is_remind",
        "name": "Remind stage with a known reviewer?",
        "stepType": "condition",
        "config": {
          "expression": "loop.item.stage == 'remind' && loop.item.requestedFor",
          "description": "Reminders go to the designated reviewer; if none is recorded the 24h escalation to admins will catch it."
        },
        "nextSteps": {
          "true": "remind_reviewer",
          "false": "review_is_escalate"
        }
      },
      {
        "stepSlug": "remind_reviewer",
        "name": "Remind the reviewer",
        "stepType": "action",
        "config": {
          "type": "notification",
          "parameters": {
            "operation": "notify_users",
            "audience": "user_ids",
            "type": "task_review_requested",
            "titleKey": "taskReviewReminder",
            "bodyKey": "taskReviewReminderBody",
            "params": {
              "title": "{{loop.item.taskTitle}}",
              "approvalId": "{{loop.item.approvalId}}",
              "taskId": "{{loop.item.taskId}}",
              "projectId": "{{loop.item.projectId}}"
            },
            "taskId": "{{loop.item.taskId}}",
            "userIds": ["{{loop.item.requestedFor}}"]
          }
        },
        "nextSteps": {
          "success": "loop_reviews"
        }
      },
      {
        "stepSlug": "review_is_escalate",
        "name": "Escalate stage?",
        "stepType": "condition",
        "config": {
          "expression": "loop.item.stage == 'escalate'"
        },
        "nextSteps": {
          "true": "escalate_review",
          "false": "loop_reviews"
        }
      },
      {
        "stepSlug": "escalate_review",
        "name": "Escalate the stale review to admins",
        "stepType": "action",
        "config": {
          "type": "notification",
          "parameters": {
            "operation": "notify_users",
            "audience": "org_admins",
            "type": "task_review_requested",
            "titleKey": "taskReviewEscalated",
            "bodyKey": "taskReviewEscalatedBody",
            "params": {
              "title": "{{loop.item.taskTitle}}",
              "approvalId": "{{loop.item.approvalId}}",
              "taskId": "{{loop.item.taskId}}",
              "projectId": "{{loop.item.projectId}}"
            },
            "taskId": "{{loop.item.taskId}}"
          }
        },
        "nextSteps": {
          "success": "loop_reviews"
        }
      },
      {
        "stepSlug": "sweep_inputs",
        "name": "Sweep pending human-input requests",
        "stepType": "action",
        "config": {
          "type": "approval",
          "parameters": {
            "operation": "sweep_pending",
            "resourceType": "human_input_request",
            "remindAfterHours": 4,
            "escalateAfterHours": 24,
            "limit": 50
          }
        },
        "nextSteps": {
          "success": "has_inputs"
        }
      },
      {
        "stepSlug": "has_inputs",
        "name": "Any input requests waiting too long?",
        "stepType": "condition",
        "config": {
          "expression": "(steps.sweep_inputs.output.data.approvals | length) > 0"
        },
        "nextSteps": {
          "true": "loop_inputs",
          "false": "done"
        }
      },
      {
        "stepSlug": "loop_inputs",
        "name": "Loop over waiting input requests",
        "stepType": "loop",
        "config": {
          "continueOnError": true,
          "itemVariable": "inputRequest",
          "items": "{{steps.sweep_inputs.output.data.approvals}}"
        },
        "nextSteps": {
          "loop": "input_is_escalate",
          "done": "done"
        }
      },
      {
        "stepSlug": "input_is_escalate",
        "name": "Escalate stage?",
        "stepType": "condition",
        "config": {
          "expression": "loop.item.stage == 'escalate'",
          "description": "Human-input requests have no designated reviewer on record — only the escalation stage notifies (org admins)."
        },
        "nextSteps": {
          "true": "escalate_input",
          "false": "loop_inputs"
        }
      },
      {
        "stepSlug": "escalate_input",
        "name": "Tell admins a workflow is waiting",
        "stepType": "action",
        "config": {
          "type": "notification",
          "parameters": {
            "operation": "notify_users",
            "audience": "org_admins",
            "type": "agent_escalation",
            "titleKey": "humanInputEscalated",
            "bodyKey": "humanInputEscalatedBody",
            "params": {
              "ageHours": "{{loop.item.ageHours}}"
            }
          }
        },
        "nextSteps": {
          "success": "loop_inputs"
        }
      },
      {
        "stepSlug": "done",
        "name": "Done",
        "stepType": "output",
        "config": {},
        "nextSteps": {}
      }
    ]
  }
}
