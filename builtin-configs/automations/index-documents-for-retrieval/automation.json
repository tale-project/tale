{
  "name": "Index documents for retrieval",
  "description": "Indexes newly uploaded documents so agents can search and cite them.",
  "i18n": {
    "de": {
      "name": "Dokumente für die Suche indexieren",
      "description": "Indexiert neu hochgeladene Dokumente, damit Agenten sie durchsuchen und zitieren können."
    },
    "fr": {
      "name": "Indexer les documents pour la recherche",
      "description": "Indexe les documents fraîchement importés pour que les agents puissent les rechercher et les citer."
    }
  },
  "icon": "file-search",
  "folder": "knowledge",
  "labels": ["Knowledge"],
  "scope": "org",
  "workflow": {
    "version": "1.0.0",
    "config": {
      "timeout": 120000,
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMs": 2000
      },
      "variables": {
        "organizationId": "org_demo",
        "backoffHours": 72,
        "includeMetadata": true,
        "workflowId": "document_rag_sync"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "find_unprocessed_document"
        }
      },
      {
        "stepSlug": "find_unprocessed_document",
        "name": "Find Unprocessed Document",
        "stepType": "action",
        "config": {
          "type": "workflow_processing_records",
          "parameters": {
            "operation": "find_unprocessed",
            "tableName": "documents",
            "backoffHours": "{{config.backoffHours}}"
          }
        },
        "nextSteps": {
          "success": "check_document_found"
        }
      },
      {
        "stepSlug": "check_document_found",
        "name": "Check Document Found",
        "stepType": "condition",
        "config": {
          "expression": "steps.find_unprocessed_document.output.data != null",
          "description": "Check if any unprocessed document was found"
        },
        "nextSteps": {
          "true": "upload_to_rag",
          "false": "noop"
        }
      },
      {
        "stepSlug": "upload_to_rag",
        "name": "Upload to RAG",
        "stepType": "action",
        "config": {
          "type": "rag",
          "parameters": {
            "operation": "upload_document",
            "fileId": "{{steps.find_unprocessed_document.output.data.fileId}}",
            "fileName": "{{steps.find_unprocessed_document.output.data.title}}",
            "contentType": "{{steps.find_unprocessed_document.output.data.mimeType}}"
          }
        },
        "nextSteps": {
          "success": "record_processed"
        }
      },
      {
        "stepSlug": "record_processed",
        "name": "Record Processed",
        "stepType": "action",
        "config": {
          "type": "workflow_processing_records",
          "parameters": {
            "operation": "record_processed",
            "tableName": "documents",
            "recordId": "{{steps.find_unprocessed_document.output.data._id}}"
          }
        },
        "nextSteps": {
          "success": "noop"
        }
      }
    ]
  }
}
