{
  "version": "1.0.0",
  "metadata": {
    "labels": ["Tasks", "Automation"],
    "autoInstall": true
  },
  "triggers": {
    "events": [
      {
        "eventType": "task.status_changed",
        "eventFilter": {
          "toStatus": "in_review",
          "task.assigneeType": "agent"
        }
      }
    ]
  },
  "config": {
    "timeout": 600000,
    "variables": {
      "workflowId": "tasks_review_gate"
    }
  },
  "steps": [
    {
      "stepSlug": "start",
      "name": "start",
      "stepType": "start",
      "config": {},
      "nextSteps": {
        "success": "guard"
      }
    },
    {
      "stepSlug": "guard",
      "name": "Agent-assigned tasks only",
      "stepType": "condition",
      "config": {
        "expression": "input.task.assigneeType == 'agent' && !input.task.archivedAt",
        "description": "Human-assigned tasks moved to In review follow the team's own review habits — the automated gate only fronts agent work."
      },
      "nextSteps": {
        "true": "request_review",
        "false": "done"
      }
    },
    {
      "stepSlug": "request_review",
      "name": "Request human review (pauses here)",
      "stepType": "action",
      "config": {
        "type": "approval",
        "parameters": {
          "operation": "request_review",
          "taskId": "{{input.task._id}}",
          "agentSlug": "{{input.task.assigneeId}}",
          "question": "Agent work on this task is ready for review. Approve to complete, or request changes with feedback."
        }
      },
      "nextSteps": {
        "success": "decide"
      }
    },
    {
      "stepSlug": "decide",
      "name": "Approved?",
      "stepType": "condition",
      "config": {
        "expression": "steps.request_review.output.data.decision == 'approve'",
        "description": "After the human responds, the engine re-executes request_review, which returns the recorded decision instead of creating a duplicate request."
      },
      "nextSteps": {
        "true": "complete",
        "false": "feedback_comment"
      }
    },
    {
      "stepSlug": "complete",
      "name": "Complete (the only automated path to Done)",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "update_status",
          "taskId": "{{input.task._id}}",
          "status": "done"
        }
      },
      "nextSteps": {
        "success": "done"
      }
    },
    {
      "stepSlug": "feedback_comment",
      "name": "Post the requested changes",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "comment",
          "taskId": "{{input.task._id}}",
          "body": "[automated] 🔁 Changes requested by the reviewer: {{steps.request_review.output.data.feedback || 'see review'}}"
        }
      },
      "nextSteps": {
        "success": "back_in_progress"
      }
    },
    {
      "stepSlug": "back_in_progress",
      "name": "Back to In progress",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "update_status",
          "taskId": "{{input.task._id}}",
          "status": "in_progress"
        }
      },
      "nextSteps": {
        "success": "revise"
      }
    },
    {
      "stepSlug": "revise",
      "name": "Re-engage the agent with the feedback",
      "stepType": "action",
      "config": {
        "type": "agent",
        "parameters": {
          "operation": "run_on_task",
          "agentSlug": "{{input.task.assigneeId}}",
          "taskId": "{{input.task._id}}",
          "trigger": "revision",
          "instructions": "The human reviewer requested changes to your earlier work on this task (their feedback is in the trigger context below and in the latest comments). Address the feedback precisely, then post the revised result as a task comment.",
          "promptContext": "{{steps.request_review.output.data.feedback || ''}}"
        }
      },
      "nextSteps": {
        "success": "revise_ok"
      }
    },
    {
      "stepSlug": "revise_ok",
      "name": "Did the revision succeed?",
      "stepType": "condition",
      "config": {
        "expression": "steps.revise.output.data.ok == true && steps.revise.output.data.external != true"
      },
      "nextSteps": {
        "true": "back_to_review",
        "false": "revise_external"
      }
    },
    {
      "stepSlug": "revise_external",
      "name": "Revision dispatched externally?",
      "stepType": "condition",
      "config": {
        "expression": "steps.revise.output.data.ok == true && steps.revise.output.data.external == true",
        "description": "External revisions are asynchronous — the daemon's completion re-parks the task at In review, which opens a fresh gate."
      },
      "nextSteps": {
        "true": "done",
        "false": "fail_comment"
      }
    },
    {
      "stepSlug": "back_to_review",
      "name": "Park revision at In review (fresh gate)",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "update_status",
          "taskId": "{{input.task._id}}",
          "status": "in_review"
        }
      },
      "nextSteps": {
        "success": "done"
      }
    },
    {
      "stepSlug": "fail_comment",
      "name": "Explain the failed revision",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "comment",
          "taskId": "{{input.task._id}}",
          "body": "[automated] ⚠️ The revision run failed: {{steps.revise.output.data.error || 'unknown error'}} — returned to To do."
        }
      },
      "nextSteps": {
        "success": "rollback"
      }
    },
    {
      "stepSlug": "rollback",
      "name": "Roll back to To do",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "update_status",
          "taskId": "{{input.task._id}}",
          "status": "todo"
        }
      },
      "nextSteps": {
        "success": "done"
      }
    },
    {
      "stepSlug": "done",
      "name": "Done",
      "stepType": "output",
      "config": {},
      "nextSteps": {}
    }
  ]
}
