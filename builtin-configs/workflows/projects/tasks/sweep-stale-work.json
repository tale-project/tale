{
  "version": "1.0.0",
  "metadata": {
    "labels": ["Tasks", "Automation"],
    "autoInstall": true
  },
  "triggers": {
    "schedules": [
      {
        "cron": "0 * * * *",
        "timezone": "UTC"
      }
    ]
  },
  "config": {
    "timeout": 600000,
    "variables": {
      "workflowId": "tasks_stale_work_sweep"
    }
  },
  "steps": [
    {
      "stepSlug": "start",
      "name": "start",
      "stepType": "start",
      "config": {},
      "nextSteps": {
        "success": "sweep"
      }
    },
    {
      "stepSlug": "sweep",
      "name": "Find stale agent tasks",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "sweep",
          "kind": "stale",
          "staleAfterHours": 24,
          "limit": 50
        }
      },
      "nextSteps": {
        "success": "has_items"
      }
    },
    {
      "stepSlug": "has_items",
      "name": "Anything stale?",
      "stepType": "condition",
      "config": {
        "expression": "(steps.sweep.output.data.tasks | length) > 0",
        "description": "The loop step throws on an empty items array — route the empty case straight to done."
      },
      "nextSteps": {
        "true": "loop_stale",
        "false": "requeue"
      }
    },
    {
      "stepSlug": "loop_stale",
      "name": "Loop over stale tasks",
      "stepType": "loop",
      "config": {
        "continueOnError": true,
        "itemVariable": "staleTask",
        "items": "{{steps.sweep.output.data.tasks}}"
      },
      "nextSteps": {
        "loop": "nudge_comment",
        "done": "requeue"
      }
    },
    {
      "stepSlug": "nudge_comment",
      "name": "Explain the rollback",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "comment",
          "taskId": "{{loop.item.taskId}}",
          "body": "[automated] ⏰ No progress for 24h — returned to To do. Reassign or re-trigger when ready."
        }
      },
      "nextSteps": {
        "success": "rollback"
      }
    },
    {
      "stepSlug": "rollback",
      "name": "Roll back to To do",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "update_status",
          "taskId": "{{loop.item.taskId}}",
          "status": "todo"
        }
      },
      "nextSteps": {
        "success": "loop_stale"
      }
    },
    {
      "stepSlug": "requeue",
      "name": "Re-wake stuck queued runs (lost-event backstop)",
      "stepType": "action",
      "config": {
        "type": "agent",
        "parameters": {
          "operation": "requeue_queued_runs",
          "olderThanMinutes": 15,
          "limit": 20
        }
      },
      "nextSteps": {
        "success": "done"
      }
    },
    {
      "stepSlug": "done",
      "name": "Done",
      "stepType": "output",
      "config": {},
      "nextSteps": {}
    }
  ]
}
