{
  "name": "Sync emails from IMAP mailbox",
  "description": "Sync new inbound emails from a private IMAP mailbox into conversations. Each scheduled run reads the most recently delivered inbound message as a cursor, fetches messages newer than it over IMAP, and creates conversations from them.",
  "i18n": {
    "en": {
      "name": "Sync emails from IMAP mailbox",
      "description": "Imports new IMAP mailbox messages into Tale conversations."
    },
    "de": {
      "name": "E-Mails aus IMAP-Postfach synchronisieren",
      "description": "Importiert neue Nachrichten aus dem IMAP-Postfach als Tale-Konversationen."
    },
    "fr": {
      "name": "Synchroniser les e-mails depuis la boîte IMAP",
      "description": "Importe les nouveaux messages de la boîte IMAP dans les conversations Tale."
    }
  },
  "version": "1.0.0",
  "metadata": {
    "labels": ["Email", "IMAP"]
  },
  "triggers": {
    "schedules": [
      {
        "cron": "0 */6 * * *",
        "timezone": "UTC"
      }
    ]
  },
  "config": {
    "timeout": 300000,
    "retryPolicy": {
      "maxRetries": 3,
      "backoffMs": 2000
    },
    "variables": {
      "organizationId": "",
      "conversationStatus": "open"
    }
  },
  "requires": {
    "integrations": [
      {
        "name": "imap_smtp",
        "operations": ["list_messages"]
      }
    ]
  },
  "steps": [
    {
      "stepSlug": "start",
      "name": "Start",
      "stepType": "start",
      "config": {},
      "nextSteps": {
        "success": "query_latest_inbound_message"
      }
    },
    {
      "stepSlug": "query_latest_inbound_message",
      "name": "Query Latest Inbound Message",
      "stepType": "action",
      "config": {
        "type": "conversation",
        "parameters": {
          "operation": "query_latest_message_by_delivery_state",
          "channel": "email",
          "direction": "inbound",
          "deliveryState": "delivered",
          "integrationName": "imap_smtp"
        }
      },
      "nextSteps": {
        "success": "check_has_cursor"
      }
    },
    {
      "stepSlug": "check_has_cursor",
      "name": "Check Has Cursor",
      "stepType": "condition",
      "config": {
        "expression": "steps.query_latest_inbound_message.output.data.message != null",
        "description": "Check if we have a previously synced message to use as the cursor"
      },
      "nextSteps": {
        "true": "fetch_new_emails",
        "false": "fetch_latest_emails"
      }
    },
    {
      "stepSlug": "fetch_new_emails",
      "name": "Fetch New Emails (Incremental)",
      "stepType": "action",
      "config": {
        "type": "integration",
        "parameters": {
          "name": "imap_smtp",
          "operation": "list_messages",
          "params": {
            "since": "{{steps.query_latest_inbound_message.output.data.message.deliveredAt}}",
            "maxResults": 25
          }
        }
      },
      "nextSteps": {
        "success": "check_has_emails"
      }
    },
    {
      "stepSlug": "fetch_latest_emails",
      "name": "Fetch Latest Emails (First Run)",
      "stepType": "action",
      "config": {
        "type": "integration",
        "parameters": {
          "name": "imap_smtp",
          "operation": "list_messages",
          "params": {
            "maxResults": 25
          }
        }
      },
      "nextSteps": {
        "success": "check_has_emails"
      }
    },
    {
      "stepSlug": "check_has_emails",
      "name": "Check Has Emails",
      "stepType": "condition",
      "config": {
        "expression": "(steps.fetch_new_emails.output.data.result.data|length > 0) || (steps.fetch_latest_emails.output.data.result.data|length > 0)",
        "description": "Check if any emails were fetched from either path"
      },
      "nextSteps": {
        "true": "insert_emails_to_conversation",
        "false": "noop"
      }
    },
    {
      "stepSlug": "insert_emails_to_conversation",
      "name": "Insert Emails to Conversation",
      "stepType": "action",
      "config": {
        "type": "conversation",
        "parameters": {
          "operation": "create_from_email",
          "emails": "{{steps.fetch_new_emails.output.data.result.data || steps.fetch_latest_emails.output.data.result.data}}",
          "status": "{{config.conversationStatus}}",
          "integrationName": "imap_smtp"
        }
      },
      "nextSteps": {
        "success": "noop"
      }
    }
  ]
}
