                          "name": "paragraph1",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Hi team,",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "zzEqK",
                          "name": "paragraph2",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Wanted to share the final wrap-up for our Q3 marketing campaign. The results exceeded our initial projections across all channels.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "k8iWp",
                          "name": "paragraph3",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Key highlights: Email open rates were up 23% compared to Q2, social engagement doubled on our primary platforms, and the landing page conversion rate hit 4.8%.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "G0wTb",
                          "name": "paragraph4",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The creative assets performed particularly well — the video series drove most of the engagement. I've attached the full analytics report for reference.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "XRXRS",
                          "name": "paragraph5",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Let's use these insights to shape our Q4 strategy. I've already started drafting some ideas based on what worked best.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
