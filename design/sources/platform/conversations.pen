                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "50EOt",
                          "name": "paragraph3",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Thanks for looking into this so quickly. I see the additional charge was for the extra storage tier we added last month.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "E9DPJ",
                          "name": "paragraph4",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "That makes sense now. I've confirmed the payment on our end and everything looks good.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "gtetN",
                          "name": "paragraph5",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Appreciate the quick turnaround on this. No further questions from my side.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
