                        {
                          "type": "text",
                          "id": "x2cl2",
                          "name": "paragraph1",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Hi team,",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "E9lvv",
                          "name": "paragraph2",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Thanks for sending over the proposal. I had a few thoughts on the timeline section that I wanted to discuss before we move forward.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "g5bVN",
                          "name": "paragraph3",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The Q4 milestones look solid, but I think we should consider pushing the beta launch by two weeks. The engineering team flagged some concerns about the authentication module that might need more time to resolve.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "ipEY5",
                          "name": "paragraph4",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Also, could we add a section covering the risk mitigation strategy? I think stakeholders would appreciate seeing that before the next review.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "oKQzm",
                          "name": "paragraph5",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Let me know your thoughts. Happy to jump on a call this afternoon if that's easier.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "SfqkF",
                          "name": "signoff",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Best,\nSarah",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        }
