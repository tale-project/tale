                          "name": "paragraph4",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Also, could we add a section covering the risk mitigation strategy? I think stakeholders would appreciate seeing that before the next review.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
