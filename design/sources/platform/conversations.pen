                        24
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "dBpfz",
                          "name": "paragraph1",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Hi team,",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "FEs8A",
                          "name": "paragraph2",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Thanks for sending over the proposal. I had a few thoughts on the timeline section that I wanted to discuss before we move forward.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "7PkqJ",
                          "name": "paragraph3",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The Q4 milestones look solid, but I think we should consider pushing the beta launch by two weeks. The engineering team flagged some concerns about the authentication module that might need more time to resolve.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "oiMy0",
                          "name": "paragraph4",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Also, could we add a section covering the risk mitigation strategy? I think stakeholders would appreciate seeing that before the next review.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "36ATV",
                          "name": "paragraph5",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Let me know your thoughts. Happy to jump on a call this afternoon if that's easier.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        },
                        {
                          "type": "text",
                          "id": "KR68R",
                          "name": "signoff",
                          "fill": "#FAFAFA",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Best,\nSarah",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
                        }
