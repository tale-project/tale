        {
          "type": "note",
          "id": "BEYhp",
          "x": 38640,
          "y": 780,
          "width": 400,
          "height": 0,
          "content": "After user clicks Done or closes the upload modal, the modal dismisses and a success toast notification appears on the main page. This confirms the upload is complete without keeping the modal open, avoiding confusion about whether files still need action."
        },
        {
          "type": "note",
          "id": "PTkcf",
          "x": 37260,
          "y": 780,
          "width": 500,
          "height": 0,
          "content": "UX Flow: Upload modal stays open showing upload results with per-file status (checkmarks/errors). User reviews results, then clicks Close to dismiss. After dismissal, a success toast notification appears on the main documents page (see next screen) confirming the uploads are complete."
        }
      ]
    }
