                    {
                      "type": "frame",
                      "id": "j2jex",
                      "x": 232,
                      "y": -80,
                      "name": "earlier-ai-response",
                      "width": 768,
                      "layout": "vertical",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "ESpsq",
                          "name": "earlierText",
                          "fill": "#030712",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "...implementing webhooks allows your server to receive real-time notifications when certain events occur, rather than continuously polling the API. This is more efficient and reduces unnecessary API calls.\n\n**Key Security Considerations:**\n- Always verify webhook signatures to ensure requests are legitimate\n- Use HTTPS endpoints exclusively\n- Implement idempotency to handle duplicate deliveries",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal",
                          "letterSpacing": -0.084
