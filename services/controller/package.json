{
  "name": "@tale/controller",
  "version": "0.1.0",
  "private": true,
  "description": "Tale controller — privileged control-plane sidecar that restarts allowlisted compose services on HMAC-signed request",
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --hot src/server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
