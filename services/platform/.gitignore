# Playwright E2E
tests/e2e/.auth/
playwright-report/
test-results/
# The org scaffold creates a sibling config dir per organization an E2E run
# creates; only the seed templates (default/, docs-demo/) are source-controlled.
tests/e2e/fixtures/config/*/
!tests/e2e/fixtures/config/default/
# The QA-guides org ships pinned copies of automation bundles (verbatim
# builtin copies + slug-renamed variants); a drift test keeps them in
# lockstep with builtin-configs/automations.
!tests/e2e/fixtures/config/qa-guides-org/
!tests/e2e/fixtures/config/docs-demo/
# The backend bootstraps the deployment's object-store connection under the
# `default` org tree when a stack runs against these fixtures — rig output
# (with secrets), never a fixture.
tests/e2e/fixtures/config/default/object-storage/

# Docs screenshot pipeline: cached auth/org state between capture runs
tests/docs-screenshots/.state/

# Storybook
storybook-static/

# Stress test reports
stress-tests/report-*.json

# TanStack
.tanstack/tmp
# vitest browser-mode failure-capture screenshots (not snapshot baselines)
__screenshots__/
.vitest-attachments/
tests/docs-videos/.state/
