{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-hook-form",
            "importNames": ["useForm"],
            "message": "Import { useForm } from '@/app/components/ui/forms/use-form' so validation timing (mode: 'onTouched') stays consistent app-wide (#1943)."
          }
        ]
      }
    ],
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/hooks": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/capitalized-calls": "off",
    "react/preserve-manual-memoization": "off",
    "react/static-components": "off",
    "react/incompatible-library": "off",
    "react/no-did-update-set-state": "off",
    "promise/always-return": "off",
    "import/no-cycle": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off"
  },
  "overrides": [
    {
      "files": ["app/components/ui/forms/use-form.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["backend/core/**/*.ts"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "snakeCase"
          }
        ]
      }
    },
    {
      "files": ["app/routes/**/$*.tsx"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.testkit.ts",
        "tests/**/*.ts",
        "scripts/**/*.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".output",
    ".vinxi",
    "node_modules",
    "out",
    "build",
    "dist",
    "**/_generated",
    "**/connectors/**/_generated",
    "lib/shared",
    "*.gen.ts",
    "*.gen.tsx",
    "storybook-static",
    "public/**",
    "tests/e2e/fixtures/config/**"
  ]
}
