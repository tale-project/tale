{
  "name": "Sync Outlook emails",
  "description": "Read, triage, and reply to your organization's email conversations in Outlook.",
  "i18n": {
    "de": {
      "name": "Outlook-E-Mails synchronisieren",
      "description": "Lies, sortiere und beantworte die E-Mail-Konversationen deiner Organisation in Outlook."
    },
    "fr": {
      "name": "Synchroniser les e-mails Outlook",
      "description": "Lis, trie et réponds aux conversations e-mail de ton organisation dans Outlook."
    }
  },
  "icon": "mail",
  "labels": ["Email", "Outlook"],
  "scope": "org",
  "builtinViews": [
    {
      "id": "inbox"
    }
  ],
  "workflow": {
    "version": "1.0.0",
    "config": {
      "timeout": 300000,
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMs": 2000
      },
      "variables": {
        "organizationId": "",
        "conversationStatus": "open"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "Start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "read_sync_cursor"
        }
      },
      {
        "stepSlug": "read_sync_cursor",
        "name": "Read Sync Cursor",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "get_email_sync_cursor",
            "connectorName": "outlook"
          }
        },
        "nextSteps": {
          "success": "check_has_cursor"
        }
      },
      {
        "stepSlug": "check_has_cursor",
        "name": "Check Has Cursor",
        "stepType": "condition",
        "config": {
          "expression": "steps.read_sync_cursor.output.data.cursor != null",
          "description": "Check if we have a previously stored sync cursor"
        },
        "nextSteps": {
          "true": "fetch_new_emails",
          "false": "fetch_latest_email"
        }
      },
      {
        "stepSlug": "fetch_latest_email",
        "name": "Fetch Latest Email (First Run)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "outlook",
            "operation": "list_messages",
            "params": {
              "orderby": "receivedDateTime desc",
              "top": 1,
              "select": "id,subject,from,toRecipients,ccRecipients,bccRecipients,receivedDateTime,sentDateTime,body,internetMessageId,conversationId,isRead,hasAttachments,bodyPreview",
              "expand": "attachments"
            }
          }
        },
        "nextSteps": {
          "success": "check_has_emails"
        }
      },
      {
        "stepSlug": "fetch_new_emails",
        "name": "Fetch New Emails (Incremental)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "outlook",
            "operation": "list_messages",
            "params": {
              "cursor": "{{steps.read_sync_cursor.output.data.cursor}}",
              "orderby": "receivedDateTime asc",
              "top": 1,
              "select": "id,subject,from,toRecipients,ccRecipients,bccRecipients,receivedDateTime,sentDateTime,body,internetMessageId,conversationId,isRead,hasAttachments,bodyPreview",
              "expand": "attachments"
            }
          }
        },
        "nextSteps": {
          "success": "check_has_emails"
        }
      },
      {
        "stepSlug": "check_has_emails",
        "name": "Check Has Emails",
        "stepType": "condition",
        "config": {
          "expression": "(steps.fetch_new_emails.output.data.result.data|length > 0) || (steps.fetch_latest_email.output.data.result.data|length > 0)",
          "description": "Check if any emails were fetched from either path"
        },
        "nextSteps": {
          "true": "set_conversation_id",
          "false": "noop"
        }
      },
      {
        "stepSlug": "set_conversation_id",
        "name": "Extract Conversation ID",
        "stepType": "action",
        "config": {
          "type": "set_variables",
          "parameters": {
            "variables": [
              {
                "name": "outlookConversationId",
                "value": "{{(steps.fetch_new_emails.output.data.result.data|first || steps.fetch_latest_email.output.data.result.data|first).conversationId}}"
              }
            ]
          }
        },
        "nextSteps": {
          "success": "fetch_thread_messages"
        }
      },
      {
        "stepSlug": "fetch_thread_messages",
        "name": "Fetch Thread Messages",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "outlook",
            "operation": "list_messages",
            "params": {
              "filter": "conversationId eq '{{variables.outlookConversationId}}'",
              "orderby": "receivedDateTime asc",
              "top": 50,
              "select": "id,subject,from,toRecipients,ccRecipients,bccRecipients,receivedDateTime,sentDateTime,body,internetMessageId,conversationId,isRead,hasAttachments,bodyPreview",
              "expand": "attachments"
            }
          }
        },
        "nextSteps": {
          "success": "insert_email_to_conversation"
        }
      },
      {
        "stepSlug": "insert_email_to_conversation",
        "name": "Insert Emails to Conversation",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "create_from_email",
            "emails": "{{steps.fetch_thread_messages.output.data.result.data}}",
            "status": "{{config.conversationStatus}}",
            "connectorName": "outlook"
          }
        },
        "nextSteps": {
          "success": "update_sync_cursor"
        }
      },
      {
        "stepSlug": "update_sync_cursor",
        "name": "Update Sync Cursor",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "update_email_sync_cursor",
            "connectorName": "outlook",
            "cursor": "{{steps.fetch_new_emails.output.data.result.nextCursor || steps.fetch_latest_email.output.data.result.nextCursor}}"
          }
        },
        "nextSteps": {
          "success": "noop"
        }
      }
    ],
    "triggers": {
      "schedules": [
        {
          "cron": "0 */6 * * *",
          "timezone": "UTC",
          "variables": {}
        }
      ]
    }
  },
  "requires": {
    "connectors": ["outlook"]
  }
}
