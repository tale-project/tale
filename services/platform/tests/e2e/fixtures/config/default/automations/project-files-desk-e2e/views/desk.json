{
  "id": "desk",
  "title": "Project files desk",
  "description": "One project per client. Period folders are top-level project folders; setup lives in `_setup`.",
  "tabs": [
    {
      "id": "quarters",
      "label": "Periods",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "Text",
            "props": {
              "text": "1. Ensure `_setup` exists (create it in Project Files if missing).\n2. Create a period folder and drop source files.\n3. Click Start on the period row.\n4. Track retries on Jobs — Periods Start does not re-run an existing job.",
              "variant": "muted"
            }
          },
          {
            "type": "Alert",
            "props": {
              "variant": "info",
              "title": "Getting started",
              "description": "Start stays hidden until `_setup` exists. After success, review artifacts in the period folder; Mark done when the human review is finished."
            }
          },
          {
            "type": "Collection",
            "props": {
              "id": "quarters",
              "title": "Period folders",
              "query": {
                "path": "projects/queries:listProjectRootFolders",
                "args": {
                  "organizationId": "$orgId",
                  "projectId": "$projectId",
                  "setupFolderName": "_setup",
                  "externalSystem": "desk-e2e"
                }
              },
              "columns": [{ "field": "name", "labelKey": "Period folder" }],
              "actions": [
                {
                  "labelKey": "list.start",
                  "doneLabelKey": "list.created",
                  "variant": "primary",
                  "path": "tasks/public_actions:createTaskFromExternalIssue",
                  "mode": "action",
                  "when": "setupFolderId && !hasTask",
                  "args": {
                    "organizationId": "$orgId",
                    "projectId": "$projectId",
                    "externalSystem": "desk-e2e",
                    "externalId": "$selected._id",
                    "externalUrl": "$selected.setupFolderId",
                    "title": "$tpl:Period job — {name}",
                    "description": "E2E stub prepare for this period folder.",
                    "runWorkflowSlug": "project-files-desk-e2e"
                  },
                  "onSuccess": {
                    "kind": "toast",
                    "titleKey": "list.created"
                  },
                  "onAlreadyExists": {
                    "kind": "toast",
                    "titleKey": "This period already has a job — open Jobs and click Start to retry."
                  }
                },
                {
                  "label": "Open files",
                  "when": "setupFolderId",
                  "variant": "ghost",
                  "effect": {
                    "kind": "navigate",
                    "to": "/dashboard/$id/projects/$projectId/files",
                    "params": { "id": "$orgId", "projectId": "$projectId" },
                    "search": { "folderId": "$selected._id" }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "returns",
      "label": "Jobs",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "Text",
            "props": {
              "text": "Start re-runs from backlog, todo, or cancelled. Cancel stops the in-flight job. Mark done when human review is finished.",
              "variant": "muted"
            }
          },
          {
            "type": "Collection",
            "props": {
              "id": "returns",
              "title": "Period jobs",
              "query": {
                "path": "tasks/queries:listTasksByProjectPaginated",
                "args": {
                  "projectId": "$projectId",
                  "organizationId": "$orgId",
                  "externalSystem": "desk-e2e"
                }
              },
              "perPage": 50,
              "columns": [
                { "field": "title", "labelKey": "Job" },
                {
                  "field": "status",
                  "kind": "badge",
                  "labelKey": "Status",
                  "valueLabels": {
                    "backlog": "Backlog",
                    "todo": "To do",
                    "in_progress": "In progress",
                    "in_review": "In review",
                    "done": "Done",
                    "cancelled": "Cancelled"
                  }
                }
              ],
              "subjectType": "task",
              "onRowClick": {
                "kind": "openDetail",
                "subjectType": "task",
                "id": "$selected._id"
              },
              "actions": [
                {
                  "labelKey": "list.start",
                  "path": "tasks/public_actions:startTaskWorkflow",
                  "mode": "action",
                  "when": "status == backlog || status == todo || status == cancelled",
                  "args": {
                    "organizationId": "$orgId",
                    "taskId": "$selected._id",
                    "workflowSlug": "project-files-desk-e2e"
                  }
                },
                {
                  "labelKey": "list.cancel",
                  "label": "Cancel",
                  "path": "tasks/public_actions:cancelTaskWorkflow",
                  "mode": "action",
                  "variant": "destructive",
                  "confirm": {
                    "title": "Cancel this job?",
                    "description": "Stops the in-flight run and marks the job cancelled so you can Start again."
                  },
                  "when": "status == in_progress",
                  "args": {
                    "organizationId": "$orgId",
                    "taskId": "$selected._id"
                  }
                },
                {
                  "labelKey": "list.markDone",
                  "path": "tasks/mutations:updateTaskStatus",
                  "mode": "mutation",
                  "variant": "primary",
                  "confirm": {
                    "title": "Mark done after review?",
                    "description": "Confirm only after the human review is finished."
                  },
                  "when": "status == in_review",
                  "args": {
                    "taskId": "$selected._id",
                    "status": "done"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
