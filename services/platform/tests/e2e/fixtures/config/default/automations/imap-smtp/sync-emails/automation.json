{
  "name": "Sync emails via SMTP/IMAP",
  "description": "Read, triage, and reply to your organization's email conversations via SMTP/IMAP.",
  "i18n": {
    "de": {
      "name": "E-Mails über SMTP/IMAP synchronisieren",
      "description": "Lies, sortiere und beantworte die E-Mail-Konversationen deiner Organisation über SMTP/IMAP."
    },
    "fr": {
      "name": "Synchroniser les e-mails via SMTP/IMAP",
      "description": "Lis, trie et réponds aux conversations e-mail de ton organisation via SMTP/IMAP."
    }
  },
  "icon": "mail",
  "labels": ["Email", "IMAP"],
  "scope": "org",
  "builtinViews": [
    {
      "id": "inbox"
    }
  ],
  "workflow": {
    "version": "1.1.0",
    "triggers": {
      "schedules": [
        {
          "cron": "*/5 * * * *",
          "timezone": "UTC"
        }
      ]
    },
    "config": {
      "timeout": 300000,
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMs": 2000
      },
      "variables": {
        "organizationId": "",
        "conversationStatus": "open"
      }
    },
    "requires": {
      "connectors": [
        {
          "name": "imap_smtp",
          "operations": ["list_messages"]
        }
      ]
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "Start",
        "stepType": "start",
        "config": {},
        "nextSteps": {
          "success": "query_latest_inbound_message"
        }
      },
      {
        "stepSlug": "query_latest_inbound_message",
        "name": "Query Latest Inbound Message",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "query_latest_message_by_delivery_state",
            "channel": "email",
            "direction": "inbound",
            "deliveryState": "delivered",
            "connectorName": "imap_smtp"
          }
        },
        "nextSteps": {
          "success": "check_has_cursor"
        }
      },
      {
        "stepSlug": "check_has_cursor",
        "name": "Check Has Cursor",
        "stepType": "condition",
        "config": {
          "expression": "steps.query_latest_inbound_message.output.data.message != null",
          "description": "Check if we have a previously synced message to use as the cursor"
        },
        "nextSteps": {
          "true": "fetch_new_emails",
          "false": "fetch_latest_emails"
        }
      },
      {
        "stepSlug": "fetch_new_emails",
        "name": "Fetch New Emails (Incremental)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "imap_smtp",
            "operation": "list_messages",
            "params": {
              "since": "{{steps.query_latest_inbound_message.output.data.message.deliveredAt}}",
              "maxResults": 25
            }
          }
        },
        "nextSteps": {
          "success": "check_has_emails"
        }
      },
      {
        "stepSlug": "fetch_latest_emails",
        "name": "Fetch Latest Emails (First Run)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "imap_smtp",
            "operation": "list_messages",
            "params": {
              "maxResults": 25
            }
          }
        },
        "nextSteps": {
          "success": "check_has_emails"
        }
      },
      {
        "stepSlug": "check_has_emails",
        "name": "Check Has Emails",
        "stepType": "condition",
        "config": {
          "expression": "(steps.fetch_new_emails.output.data.result.data|length > 0) || (steps.fetch_latest_emails.output.data.result.data|length > 0)",
          "description": "Check if any emails were fetched from either path"
        },
        "nextSteps": {
          "true": "insert_emails_to_conversation",
          "false": "query_latest_outbound_message"
        }
      },
      {
        "stepSlug": "insert_emails_to_conversation",
        "name": "Insert Emails to Conversation",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "create_from_email",
            "emails": "{{steps.fetch_new_emails.output.data.result.data || steps.fetch_latest_emails.output.data.result.data}}",
            "status": "{{config.conversationStatus}}",
            "connectorName": "imap_smtp"
          }
        },
        "nextSteps": {
          "success": "query_latest_outbound_message"
        }
      },
      {
        "stepSlug": "query_latest_outbound_message",
        "name": "Query Latest Outbound Message",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "query_latest_outbound_message_for_sync",
            "channel": "email",
            "connectorName": "imap_smtp"
          }
        },
        "nextSteps": {
          "success": "check_has_sent_cursor"
        }
      },
      {
        "stepSlug": "check_has_sent_cursor",
        "name": "Check Has Sent Cursor",
        "stepType": "condition",
        "config": {
          "expression": "steps.query_latest_outbound_message.output.data.message != null",
          "description": "Check if we have a previously synced outbound message to use as the sent-folder cursor"
        },
        "nextSteps": {
          "true": "fetch_new_sent_emails",
          "false": "fetch_latest_sent_emails"
        }
      },
      {
        "stepSlug": "fetch_new_sent_emails",
        "name": "Fetch New Sent Emails (Incremental)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "imap_smtp",
            "operation": "list_messages",
            "params": {
              "mailbox": "sent",
              "since": "{{steps.query_latest_outbound_message.output.data.message.sentAt || steps.query_latest_outbound_message.output.data.message.deliveredAt}}",
              "maxResults": 25
            }
          }
        },
        "nextSteps": {
          "success": "check_has_sent_emails"
        }
      },
      {
        "stepSlug": "fetch_latest_sent_emails",
        "name": "Fetch Latest Sent Emails (First Run)",
        "stepType": "action",
        "config": {
          "type": "connector",
          "parameters": {
            "name": "imap_smtp",
            "operation": "list_messages",
            "params": {
              "mailbox": "sent",
              "maxResults": 25
            }
          }
        },
        "nextSteps": {
          "success": "check_has_sent_emails"
        }
      },
      {
        "stepSlug": "check_has_sent_emails",
        "name": "Check Has Sent Emails",
        "stepType": "condition",
        "config": {
          "expression": "(steps.fetch_new_sent_emails.output.data.result.data|length > 0) || (steps.fetch_latest_sent_emails.output.data.result.data|length > 0)",
          "description": "Check if any sent emails were fetched from either path"
        },
        "nextSteps": {
          "true": "insert_sent_emails_to_conversation",
          "false": "noop"
        }
      },
      {
        "stepSlug": "insert_sent_emails_to_conversation",
        "name": "Insert Sent Emails to Conversation",
        "stepType": "action",
        "config": {
          "type": "conversation",
          "parameters": {
            "operation": "create_from_sent_email",
            "emails": "{{steps.fetch_new_sent_emails.output.data.result.data || steps.fetch_latest_sent_emails.output.data.result.data}}",
            "status": "{{config.conversationStatus}}",
            "connectorName": "imap_smtp"
          }
        },
        "nextSteps": {
          "success": "noop"
        }
      }
    ]
  },
  "requires": {
    "connectors": ["imap_smtp"]
  }
}
