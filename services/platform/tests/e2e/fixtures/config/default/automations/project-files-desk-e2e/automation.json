{
  "name": "Project files desk",
  "description": "Hermetic fixture for project-scoped automation desk isolation. Period folders are top-level project folders; setup lives in `_setup`. Thin status-flip workflow — no sandbox.",
  "i18n": {
    "en": {
      "name": "Project files desk",
      "description": "Hermetic fixture for project-scoped automation desk isolation."
    },
    "de": {
      "name": "Projektdateien-Desk",
      "description": "Hermetische Fixture für projektbezogene Automation-Desk-Isolation."
    },
    "fr": {
      "name": "Bureau fichiers projet",
      "description": "Fixture hermétique pour l'isolation du desk d'automatisation projet."
    }
  },
  "icon": "folder",
  "labels": ["E2E", "Files"],
  "scope": "project",
  "workflow": {
    "specification": "# Prepare period job (e2e stub)\n\nHermetic stub: acknowledge the task and park it In review. Real pack work is out of scope for this fixture.",
    "version": "1.0.0-e2e",
    "metadata": {
      "pack": "project-files-desk-e2e",
      "autoInstall": false
    },
    "config": {
      "timeout": 60000,
      "variables": {
        "workflowId": "project_files_desk_e2e"
      }
    },
    "steps": [
      {
        "stepSlug": "start",
        "name": "start",
        "stepType": "start",
        "config": {
          "inputSchema": {
            "properties": {
              "task": {
                "description": "Task from desk Start. externalId = period folderId; externalUrl = _setup folderId.",
                "type": "object"
              }
            },
            "required": ["task"]
          }
        },
        "nextSteps": {
          "success": "ack"
        }
      },
      {
        "stepSlug": "ack",
        "name": "Acknowledge (In progress)",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "update_status",
            "taskId": "{{input.task._id}}",
            "status": "in_progress"
          }
        },
        "nextSteps": {
          "success": "park"
        }
      },
      {
        "stepSlug": "park",
        "name": "Park for review",
        "stepType": "action",
        "config": {
          "type": "task",
          "parameters": {
            "operation": "update_status",
            "taskId": "{{input.task._id}}",
            "status": "in_review"
          }
        },
        "nextSteps": {
          "success": "done"
        }
      },
      {
        "stepSlug": "done",
        "name": "done",
        "stepType": "output",
        "config": {}
      }
    ]
  },
  "capabilities": {
    "workflows": ["project-files-desk-e2e"],
    "functions": [
      {
        "path": "projects/queries:listProjectRootFolders",
        "mode": "query"
      },
      {
        "path": "tasks/queries:listTasksByProjectPaginated",
        "mode": "query"
      },
      {
        "path": "tasks/queries:getTask",
        "mode": "query"
      },
      {
        "path": "tasks/queries:listTaskActivity",
        "mode": "query"
      },
      {
        "path": "tasks/public_actions:createTaskFromExternalIssue",
        "mode": "action"
      },
      {
        "path": "tasks/public_actions:startTaskWorkflow",
        "mode": "action"
      },
      {
        "path": "tasks/mutations:updateTaskStatus",
        "mode": "mutation"
      }
    ]
  }
}
