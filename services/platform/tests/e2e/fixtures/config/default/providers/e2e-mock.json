{
  "displayName": "E2E Mock Provider",
  "description": "OpenAI-compatible mock provider for the Playwright E2E suite, served by the lib/mocks gateway (chat override + Prism-mocked AI endpoints).",
  "baseUrl": "http://127.0.0.1:4141/v1",
  "secretsEnv": "TALE_PROVIDER_KEY_E2E_MOCK",
  "defaults": {
    "chat": "e2e-chat-model",
    "transcription": "e2e-transcription-model",
    "text-to-speech": "e2e-tts-model",
    "image-generation": "e2e-image-model"
  },
  "models": [
    {
      "id": "e2e-chat-model",
      "displayName": "E2E Chat Model",
      "description": "Deterministic canned-reply model served by the lib/mocks chat override",
      "tags": ["chat"],
      "contextWindow": 32768,
      "qualityScore": 0.5,
      "cost": {
        "inputCentsPerMillion": 0,
        "outputCentsPerMillion": 0
      }
    },
    {
      "id": "e2e-chat-model-b",
      "displayName": "E2E Chat Model B",
      "description": "Second deterministic model so the E2E suite can exercise arena (two-model) mode",
      "tags": ["chat"],
      "contextWindow": 32768,
      "qualityScore": 0.5,
      "cost": {
        "inputCentsPerMillion": 0,
        "outputCentsPerMillion": 0
      }
    },
    {
      "id": "e2e-transcription-model",
      "displayName": "E2E Transcription Model",
      "description": "Deterministic speech-to-text served by the gateway (/v1/audio/transcriptions, multipart verbose_json)",
      "tags": ["transcription"],
      "transcriptionMode": "multipart",
      "cost": { "centsPerAudioMinute": 0 }
    },
    {
      "id": "e2e-tts-model",
      "displayName": "E2E TTS Model",
      "description": "Deterministic text-to-speech served by the gateway (/v1/audio/speech)",
      "tags": ["text-to-speech"],
      "audioFormat": "mp3",
      "defaultVoice": "alloy",
      "voicesByLocale": { "en": "alloy" },
      "cost": { "centsPerMillionCharacters": 0 }
    },
    {
      "id": "e2e-image-model",
      "displayName": "E2E Image Model",
      "description": "Deterministic image generation served by the gateway (/v1/images/generations, images-api mode)",
      "tags": ["image-generation"],
      "imageGenerationMode": "images-api",
      "cost": { "imageCentsPerImage": 0 }
    }
  ]
}
