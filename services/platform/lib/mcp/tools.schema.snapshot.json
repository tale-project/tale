  "search_capabilities": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S",
          "description": "What you want to do, in the words a person would use."
        },
        "limit": {
          "description": "How many matches to return (default 8).",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": ["id"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["capabilities"],
      "additionalProperties": {}
    }
  },
  "invoke_capability": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The capability id from search_capabilities, e.g. \"automation.billing/dunning-reminder\"."
        },
        "input": {
          "description": "Arguments — any JSON value the capability's own input schema accepts; the surface validates them."
        },
        "credential": {
          "description": "Which stored credential to act as. Omit to use the organization's default.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[\\x20-\\x7e]*[\\x21-\\x7e][\\x20-\\x7e]*$",
          "description": "Names this start so a retry of a timed-out call answers the run it already started (`duplicate: true`) instead of starting another — the same ledger as the REST `Idempotency-Key`: one key, one run, for a day; a repeat with a different input is refused (`IDEMPOTENCY_KEY_REUSED`). Printable ASCII, 1–255 characters."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    }
  },
  "get_knowledge": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S",
          "description": "What to look for, in the words a person would use (at most 2,000 characters — the REST search’s cap)."
        },
        "limit": {
          "description": "How many passages to return (default 10).",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "corpus": {
          "description": "Which knowledge to search: the organization's own documents ('private' — the REST search spells it 'documents'), its crawled web pages ('public-web' — REST: 'web'), or both ('all', the default). Either spelling is taken.",
          "type": "string",
          "enum": ["private", "public-web", "all", "documents", "web"]
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "passages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        }
      },
      "required": ["status", "passages"],
      "additionalProperties": {}
    }
  }
}
