{
  "get_docs": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": {
          "description": "Which reference: \"authoring\" (the default — the automation grammar and every method), \"triggers\" (what starts an automation, each kind's fields and the events), \"validation\" (how to read a validation result, and every issue code) or \"skill\" (the Tale skill, SKILL.md). Each is also the resource tale://docs/<topic>.",
          "type": "string",
          "enum": ["authoring", "triggers", "validation", "skill"]
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "string"
        }
      },
      "required": ["docs"],
      "additionalProperties": {}
    }
  },
  "get_catalog": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "Only node types of this kind.",
          "type": "string",
          "enum": ["transform", "llm", "agent", "subautomation", "connector"]
        },
        "compact": {
          "description": "Names and descriptions only — no input schemas. The full catalog is large (over 100 KB); prefer search_catalog or compact for discovery.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "node_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            },
            "required": ["type", "kind"],
            "additionalProperties": {}
          }
        },
        "hint": {
          "type": "string"
        }
      },
      "required": ["node_types"],
      "additionalProperties": {}
    }
  },
  "search_catalog": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Capability keywords — verbs and objects, e.g. \"send email\"."
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "required": ["type"],
            "additionalProperties": {}
          }
        },
        "hint": {
          "type": "string"
        }
      },
      "required": ["matches"],
      "additionalProperties": {}
    }
  },
  "validate_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "automation": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "The automation document — name, inputs, nodes, output, tests. get_docs is the grammar; the engine validates it and answers with the problems."
        },
        "detail": {
          "description": "What to answer beside the errors and warnings: \"analysis\" (which nodes run on which ways a run can go) and \"types\" (the shape of every value). Left out, both; [] answers the issues alone — the types of a large document run to tens of KB.",
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["analysis", "types"]
          }
        }
      },
      "required": ["automation"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": {}
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": {}
          }
        },
        "analysis": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        "types": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        }
      },
      "required": ["valid", "errors", "warnings"],
      "additionalProperties": {}
    }
  },
  "run_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "automation": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "The automation document — name, inputs, nodes, output, tests. get_docs is the grammar; the engine validates it and answers with the problems."
        },
        "input": {
          "description": "The run's input — any JSON value the automation's own inputs schema accepts; the engine validates it."
        },
        "mode": {
          "description": "Always \"mock\" here: the document runs against deterministic mocks, and nothing leaves Tale. To run it for real, save and deploy it, then run_deployed or start_run.",
          "type": "string",
          "enum": ["mock"]
        }
      },
      "required": ["automation"],
      "additionalProperties": false
    }
  },
  "test_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "automation": {
          "description": "A draft to test — the automation document with its tests: block. Leave it out to test a saved version (name).",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "A saved automation to test instead of a draft; its verdict is recorded on the version."
        },
        "version": {
          "description": "Which saved version of name to test — the latest when omitted, \"deployed\" for the live one.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "deployed"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "save_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "automation": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "The automation document — name, inputs, nodes, output, tests. get_docs is the grammar; the engine validates it and answers with the problems."
        },
        "message": {
          "description": "Why this version — shown in the version history.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "baseVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The version your edit started from (get_automation answers it). If another version was saved since, the save is refused with the latest version number instead of overwriting it. Always pass it."
        },
        "create": {
          "description": "true: refuse the save when an automation of that name already exists (a new automation, never a new version of someone else’s).",
          "type": "boolean"
        },
        "projectId": {
          "description": "Install a NEW automation in this project with its first version; you need edit access to it. Ignored for an automation that exists.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "settings": {
          "description": "The settings form the task screen shows. Leave it out to keep the latest version’s; null stores none.",
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "taskContract": {
          "description": "The task contract (how tasks start and review this automation). Leave it out to keep the latest version’s; null stores none.",
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "description": "The display name, description and icon on the automations list. Leave it out to keep the latest version’s; null stores none on this version, and the list keeps showing the newest earlier one.",
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["automation"],
      "additionalProperties": false
    }
  },
  "get_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "version": {
          "description": "Read this saved version instead of the latest one; \"deployed\" reads the version that actually runs (list_automations shows deployedVersion).",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "deployed"
            }
          ]
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number"
            }
          },
          "required": ["version"],
          "additionalProperties": {}
        },
        "automation": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "number"
        },
        "latestVersion": {
          "type": "number"
        },
        "deployedVersion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdVia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "clientName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["meta", "automation"],
      "additionalProperties": {}
    }
  },
  "list_automations": {
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "automations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["automations"],
      "additionalProperties": {}
    }
  },
  "deploy_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The saved version to promote — list_versions shows them. An older version rolls back."
        },
        "expectedDeployedVersion": {
          "description": "The version you read as live (list_versions answers deployedVersion; null while nothing is deployed). If another one is live now, the deploy is refused and nothing changes.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    }
  },
  "delete_automation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "expectedLatestVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The latest version you read (get_automation answers latestVersion). If a version was saved since, the delete is refused and nothing is removed."
        }
      },
      "required": ["name", "expectedLatestVersion"],
      "additionalProperties": false
    }
  },
  "set_trigger": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "trigger": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "schedule"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the trigger starts runs; false keeps it bound but paused."
                },
                "cron": {
                  "description": "Five fields — minute hour day-of-month month day-of-week — e.g. \"0 9 * * 1\" for 09:00 every Monday; required. An expression that can never fire (a 30 February) is refused.",
                  "type": "string",
                  "maxLength": 200
                },
                "timezone": {
                  "description": "The IANA time zone the cron reads its clock in, e.g. \"Europe/Zurich\"; UTC when omitted.",
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "webhook"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the trigger starts runs; false keeps it bound but paused."
                },
                "rotateToken": {
                  "description": "true mints a new token, answered once in this call, and the URL of the old one stops working; re-binding the webhook without it keeps its token.",
                  "type": "boolean"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "event"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the trigger starts runs; false keeps it bound but paused."
                },
                "event": {
                  "description": "The event that starts a run — one list_events names; required.",
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            }
          ],
          "description": "The trigger — {kind: \"schedule\" | \"webhook\" | \"event\", …}, one shape per kind (a key of another kind is refused by name); get_docs with topic \"triggers\" describes each kind. A webhook trigger answers its token ONCE, in this call — list_triggers never returns it; rotateToken: true mints a new one."
        }
      },
      "required": ["name", "trigger"],
      "additionalProperties": false
    }
  },
  "run_deployed": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "input": {
          "description": "The run's input — any JSON value the automation's own inputs schema accepts; the engine validates it."
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[\\x20-\\x7e]*[\\x21-\\x7e][\\x20-\\x7e]*$",
          "description": "Names this start so a retry of a timed-out call answers the run it already started (`duplicate: true`) instead of starting another — the same ledger as the REST `Idempotency-Key`: one key, one run, for a day; a repeat with a different input is refused (`IDEMPOTENCY_KEY_REUSED`). Printable ASCII, 1–255 characters."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  },
  "start_run": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        },
        "input": {
          "description": "The run's input — any JSON value the automation's own inputs schema accepts; the engine validates it."
        },
        "mode": {
          "description": "live (default): the deployed version, with real effects — needs the owner, admin or developer role. mock: any saved version against the deterministic mocks, recorded in the run history; any member may start one. Use mock while testing.",
          "type": "string",
          "enum": ["live", "mock"]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The saved version to run. A live run takes only the deployed one (the default); a mock run takes any, the latest saved when omitted."
        },
        "projectId": {
          "description": "The project the run operates in — its task and document tools act there. The caller must have edit access to this active project. Omit only for an organization-wide automation or when the host already pins a project. A bound automation requires an explicit allowed project.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[\\x20-\\x7e]*[\\x21-\\x7e][\\x20-\\x7e]*$",
          "description": "Names this start so a retry of a timed-out call answers the run it already started (`duplicate: true`) instead of starting another — the same ledger as the REST `Idempotency-Key`: one key, one run, for a day; a repeat with a different input is refused (`IDEMPOTENCY_KEY_REUSED`). Printable ASCII, 1–255 characters."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  },
  "list_runs": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Only this automation's runs. Omit for every run the caller can read in the current scope."
        },
        "limit": {
          "description": "How many runs to return (default 50).",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "mode": {
          "description": "Only live runs, or only mock runs.",
          "type": "string",
          "enum": ["live", "mock"]
        },
        "statuses": {
          "description": "Only runs in one of these statuses.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "waiting",
              "quarantined",
              "success",
              "failed",
              "cancelled"
            ]
          }
        },
        "cursor": {
          "description": "The nextCursor the previous page answered — the next older page. Pass it unchanged, with the same filters.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": ["runId", "status"],
            "additionalProperties": {}
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["runs", "nextCursor"],
      "additionalProperties": {}
    }
  },
  "get_run": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The run handle start_run and list_runs return."
        },
        "detail": {
          "description": "What to answer beside the status: \"input\", \"output\", \"trace\", \"effects\". Left out, all of them; [] the status alone (and the question a waiting run asks) — poll a run with [], then read it whole once it finished.",
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["input", "output", "trace", "effects"]
          }
        }
      },
      "required": ["runId"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "run": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "ask": {
              "type": "object",
              "properties": {
                "askId": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                }
              },
              "required": ["askId", "question"],
              "additionalProperties": {}
            }
          },
          "required": ["runId", "status"],
          "additionalProperties": {}
        }
      },
      "required": ["run"],
      "additionalProperties": {}
    }
  },
  "cancel_run": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The run handle start_run and list_runs return."
        }
      },
      "required": ["runId"],
      "additionalProperties": false
    }
  },
  "answer_run_ask": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The run handle start_run and list_runs return."
        },
        "askId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The question to answer — get_run answers it as run.ask.askId while the run waits on one (waitingFor: \"ask\")."
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S",
          "description": "Your answer, in words — the run resumes on it as the person’s answer."
        }
      },
      "required": ["runId", "askId", "answer"],
      "additionalProperties": false
    }
  },
  "list_versions": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The automation name — a \"/\"-separated path, e.g. \"billing/dunning-reminder\"."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "deployedVersion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number"
              }
            },
            "required": ["version"],
            "additionalProperties": {}
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number"
              },
              "previousVersion": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deployedAt": {
                "type": "number"
              }
            },
            "required": ["version", "previousVersion", "deployedAt"],
            "additionalProperties": {}
          }
        }
      },
