  "get_automation_metrics": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "periodDays": {
          "description": "The window, in days (default 7); compared with the window before it.",
          "anyOf": [
            {
              "type": "number",
              "const": 7
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 90
            }
          ]
        },
        "mode": {
          "description": "Which runs to count: live (the default) or mock.",
          "type": "string",
          "enum": ["live", "mock"]
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
