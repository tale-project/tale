            "total": {
              "type": "number"
            },
            "successRate": {
              "type": "number"
            }
          },
          "required": ["total", "successRate"],
          "additionalProperties": {}
        },
        "previousSummary": {
          "type": "object",
          "properties": {
            "total": {
              "type": "number"
            }
          },
          "required": ["total"],
          "additionalProperties": {}
        },
