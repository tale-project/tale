            "additionalProperties": {}
          }
        },
        "topAutomations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["summary", "previousSummary", "series", "topAutomations"],
      "additionalProperties": {}
    }
