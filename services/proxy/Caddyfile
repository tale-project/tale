# Caddy Configuration for Tale Platform
# Single entry point for both local development and production
#
# Supports blue-green deployments with automatic health-based routing
#
# TLS Configuration (environment variables):
# - TLS_MODE: Certificate mode
#   - "selfsigned" (default): Self-signed certificates via Caddy's internal CA
#   - "letsencrypt": Free trusted certificates from Let's Encrypt
#
# - TLS_EMAIL: Email for Let's Encrypt notifications (optional but recommended)
#
# Users always access via HTTPS regardless of TLS mode.
#
# Development: https://localhost (TLS_MODE=selfsigned)
# Production:  https://yourdomain.com (TLS_MODE=letsencrypt)
#
# Blue-Green Deployment:
# - Routes to "platform" DNS alias (resolves to whichever color is running)
# - Only one platform instance can be healthy at a time (DB constraint)
# - Shows loading page during the brief transition window

# Global options
{
	default_sni {$HOST:localhost}
	servers {
		# Only TCP 443 is published (compose and the CLI map no UDP port), so
		# an advertised HTTP/3 (`Alt-Svc: h3`) only invites clients to race a
		# QUIC connection that cannot arrive; name the protocols we serve.
		protocols h1 h2
		# The header budget — the request target included — and what Go
		# does above it is not Caddy's to choose: over HTTP/1.1 a request a
		# few KiB past the cap still reaches the route (the reader keeps
		# 4 KiB of slack) and a larger one answers a bare text 431; over
		# HTTP/2 a header LIST past the cap answers a bare HTML 431, but a
		# single field past it (a long URL is one field) fails HPACK
		# decoding and CLOSES THE CONNECTION with no response at all. At
		# 32KB (32,000 bytes) that cliff sat exactly where the contract
		# promised a refusal for a 32 KiB URL, so a 33 KB URL died as a
		# network fault a client retries forever. The documented URL cap is
		# answered by the backend's own guard alone (lib/http-hygiene.ts):
		# 414 in the full JSON envelope — `requestId`, `X-Tale-Api-Version`,
		# `Cache-Control` — which an edge rule could not produce (this image
		# knows no contract version, and its matcher counted code points,
		# not bytes), so the twin the entrypoint once injected is gone. This
		# budget sits well above the URL cap, so every URL a client could
		# still have shortened reaches that guard and the cliff is only
		# reachable by a request no client could mean. The backend
		# listener's cap (main.ts) stays above this plus Go's slack, so a
		# request the edge forwards is never a bare 431 upstream either.
		max_header_size 64KiB
	}
}

# The JSON refusal an edge rule answers before any lane: the envelope the
# API reference promises, uncacheable, with the same transport headers the
# backend stamps and a request id of its own (`{http.request.uuid}` lands
# in the access log's resp_headers, so it can be quoted). The entrypoint
# fills the HSTS placeholder when the public origin is https.
(edge_json_refusal) {
	header Content-Type application/json
	header X-Request-Id {http.request.uuid}
	header Cache-Control no-store
	header X-Content-Type-Options nosniff
	header X-Frame-Options DENY
	header Referrer-Policy strict-origin-when-cross-origin
	# HSTS_PLACEHOLDER
}

# Health check endpoint (internal only, not exposed externally)
# Separate port avoids interfering with Caddy's automatic ACME challenge handling on :80
:2020 {
	respond /health "OK" 200
}

# ============================================================================
# Docs site — separate host block proxying to services/docs.
# The Caddy entrypoint substitutes the TLS placeholder line below and the
# {$DOCS_ORIGIN} placeholder on the next line.
# ============================================================================
{$DOCS_ORIGIN:https://docs.localhost} {
	# TLS_PLACEHOLDER

	log {
		output stdout
		format console
		level INFO
	}

	handle /health {
		respond "OK" 200
	}

	encode gzip zstd

	# Passive health checking only (circuit breaker) — deliberately no active
	# health checks here. The docs service is optional: the CLI-generated
	# stacks and the bare compose.yml don't ship it (only the dev chain with
	# compose.docs.yml does), and an active checker dials `docs` on every
	# interval, filling the proxy log with "dial tcp: lookup docs ... no such
	# host" errors forever on stacks without it. Passive checks only observe
	# real requests, so an absent upstream stays silent; a present-but-down
	# docs container still gets circuit-broken after max_fails.
	reverse_proxy docs:3002 {
		# Dedicated analytics provenance; ignore any browser-supplied value.
		header_up X-Analytics-Client-IP {client_ip}
		fail_duration 10s
		max_fails 2
		unhealthy_status 500 502 503 504

		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		-Server
	}
}

{$SITE_ORIGIN:https://localhost} {
	# TLS Configuration - This line is replaced by entrypoint based on TLS_MODE
	# DO NOT MODIFY - entrypoint will replace this placeholder
	# TLS_PLACEHOLDER

	log {
		output stdout
		format console
		level INFO
	}

	# Strip base path prefix for subpath deployments (no-op when empty)
	# BASE_PATH_PLACEHOLDER

	# Remove WebSocket compression extension header before proxying
	# This prevents "Invalid frame header" errors caused by permessage-deflate
	# compression negotiation issues between browser, Caddy, and backend
	request_header -Sec-WebSocket-Extensions

	# Health check endpoint for the proxy itself
	handle /health {
		respond "OK" 200
	}

	# ============================================================================
	# 0.5 backend-api lanes (the Convex→Postgres cutover)
	# ============================================================================
	# The entrypoint replaces the placeholder below with the `handle` blocks
	# routing the migrated surface to `backend-api` when BACKEND_UPSTREAM is
	# set (the `backend` compose profile), and deletes the line otherwise —
	# so an un-migrated stack keeps flowing entirely to Convex. Declared
	# BEFORE the Convex handles because Caddy takes the first matching
	# `handle` in file order.
	# BACKEND_PLACEHOLDER

	# ============================================================================
	# Everything else under /api
	# ============================================================================
	# The Convex fallbacks that used to live here are GONE with the runtime:
	# `/ws_api`, `/http_api`, `/api/*/sync`, `/api/actions`, `/api/storage`, the
	# dashboard and its root assets all addressed a service that no longer
	# exists, so they answered 502 rather than falling back to anything. The 0.5
	# lanes are injected above (BACKEND_PLACEHOLDER) and are explicit; what
	# remains is the platform's own surface.

	# HTTP: Platform health endpoint (/api/health -> platform:3000)
	# The platform owns this route (see services/platform/server.ts); README.md
	# and the manual-test SETUP.md document {SITE_URL}/api/health as the external
	# readiness probe, so it must route through the proxy (#2553).
	handle /api/health {
		reverse_proxy platform:3000
	}

	# Anything else under /api belongs to the backend. Naming it here rather
	# than 404ing keeps a lane the injected list has not caught up with working,
	# and a path the backend does not own answers ITS 404 — which is the honest
	# answer, not a 502 from a dead upstream.
	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend-api:3005}
	}

	# ============================================================================
	# Metrics Proxy (enabled when METRICS_BEARER_TOKEN is set)
	# Proxies /metrics/{service} → internal {service}:{port}/metrics
	# ============================================================================

	@metricsAuth {
		path /metrics/platform /metrics/sla-rules /metrics/backend
		expression `"{$METRICS_BEARER_TOKEN:}" != ""`
		header Authorization "Bearer {$METRICS_BEARER_TOKEN:}"
	}
	handle @metricsAuth {
		# The entrypoint replaces this with the `/metrics/backend` scrape lane
		# once BACKEND_UPSTREAM is set; unset, the path falls through to the
		# 401 block below rather than silently serving another service's
		# numbers under the backend's name.
		# BACKEND_METRICS_PLACEHOLDER

		handle /metrics/platform {
			rewrite * /metrics
			reverse_proxy platform:3000
		}
		handle /metrics/sla-rules {
			reverse_proxy platform:3000
		}

		# Any gated metrics path with no lane on THIS deployment (e.g.
		# /metrics/backend before the cutover) answers 404. Without this the
		# request falls out of the block into the platform catch-all below
		# and serves the platform's numbers under another service's name —
		# observed live while building the backend lane.
		handle {
			respond "Not Found" 404
		}
	}

	# Block all other /metrics requests (no token, wrong token, or unknown service)
	# Returns 401 so scrapers (e.g. Grafana Cloud) know auth is required
	@metricsBlock {
		path_regexp (?i)^/metrics(/.*)?$
	}
	handle @metricsBlock {
		header WWW-Authenticate "Bearer"
		respond "Unauthorized" 401
	}

	# ============================================================================
	# WebDAV uploads — defense-in-depth body cap (RAM blow-up protection)
	# ============================================================================
	# The platform process enforces a per-method limit (XML methods ~64 KB,
	# PUT default 5 GB) but a malicious client streaming an unbounded body
	# can still tie up Caddy's buffer. Cap at the proxy too. Driven by the
	# same WEBDAV_MAX_PUT_BYTES the platform uses (a raw byte count; Caddy
	# accepts a plain integer as bytes) so the two ceilings stay in sync.
	# Operators raising the platform limit above 5 GB must also set this env
	# on the proxy container, or the proxy stays the binding cap (default 5 GB).
	handle /dav/* {
		request_body {
			max_size {$WEBDAV_MAX_PUT_BYTES:5GB}
		}
		# The entrypoint exports WEBDAV_UPSTREAM = BACKEND_UPSTREAM once the
		# 0.5 lanes are on; the default keeps un-migrated stacks on the
		# platform's own WebDAV handler.
		reverse_proxy {$WEBDAV_UPSTREAM:platform:3000} {
			# Forward the real client IP. The WebDAV failed-auth throttle
			# keys its per-IP bucket on the first X-Forwarded-For hop, so an
			# attacker is rate-limited by their own source rather than locking
			# out a whole org. Without this the platform sees only Caddy's IP.
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ============================================================================
	# Express Server (static files + HTML env injection only)
	# ============================================================================

	# Default: Express server for static files and index.html with env injection
	reverse_proxy platform:3000 {
		# The application forwards this only to its authenticated collector.
		header_up X-Analytics-Client-IP {client_ip}
		# Active health checking. Interval is 5s (not 2s): the platform has a
		# long cold boot (Convex connect + asset load — see its 180s compose
		# start_period), and a 2s probe logged a failed health check every two
		# seconds until it came up, which read as "repeated proxy failures"
		# during normal startup (#1447). Caddy still routes correctly once the
		# backend is up; 5s cuts the boot noise. Unlike the optional docs
		# upstream above, the platform is always part of the stack, so active
		# checks never probe a permanently absent host.
		health_uri /api/health
		health_interval 5s
		health_timeout 2s
		health_status 200
		health_passes 2

		# Passive health checking (circuit breaker)
		fail_duration 10s
		max_fails 2
		unhealthy_status 500 502 503 504

		# Retry on failure
		lb_try_duration 5s
		lb_try_interval 250ms

		# Headers
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Encode responses, but skip WebSocket endpoints — and HEAD. The encoder
	# judges a HEAD by the upstream's Content-Length: past its 512-byte
	# floor it opened a gzip/zstd stream for a body that never comes and
	# stamped that stream's 20-byte empty frame as the length, where the
	# API reference promises the length the GET would carry (2026-09-13
	# round-e evaluation). Left alone, a HEAD passes the upstream's own
	# uncompressed length through.
	@notWebSocket {
		not path /api/*/sync
		not path /ws_api/*
		not method HEAD
	}
	encode @notWebSocket gzip zstd

	# What a 502/503/504 answers depends on who asked. During a deployment
	# there is a brief window when the old platform loses its DB connection
	# and the new one is not ready yet: a browser navigation gets the
	# friendly loading page instead of a raw error, as before. A machine
	# door gets the JSON envelope the API reference promises — a client that
	# parses JSON cannot branch on an HTML page, and 4 KiB of markup with a
	# meta-refresh read as "the API is broken" to every integrator who met
	# it mid-roll. The first `handle` that matches wins, so the order below
	# IS the rule.
	handle_errors 502 503 504 {
		# A 502 the CLIENT caused, judged first and on every path: over
		# HTTP/2 a body that ends before its declared Content-Length makes
		# Go's server fail the request body with "request declared a
		# Content-Length of N but only wrote M bytes", the round trip to the
		# backend fails, and a truncated upload became the maintenance page
		# — for a declared length under the cap too, so the platform never
		# saw it. That is a malformed request (400), not an outage. Matched
		# on that sentence alone (never the wider "unexpected EOF", which an
		# upstream abort says too) and never echoed: the message names
		# internal addresses. Over HTTP/1.1 the missing bytes are simply
		# waited for (the backend's 15-minute 408), so there is no twin.
		@shortBody expression `{http.error.status_code} == 502 && {http.error.message}.matches("request declared a Content-Length of")`
		handle @shortBody {
			import edge_json_refusal
			respond `{"error":"The request body ended before the declared Content-Length was reached — send exactly the bytes the header declares (a length past the route's cap is refused by the platform's 413 instead)","code":"BODY_LENGTH_MISMATCH","requestId":"{http.request.uuid}"}` 400
		}
		# A 502 the CLIENT caused, the HTTP/1.1 twin: a chunked request body
		# whose framing is malformed ("ZZZZ" as a chunk size, a bare LF, a
		# missing CRLF) makes Go's chunked reader fail the body read with one
		# of the sentences below, the round trip fails, and the caller was told
		# "a deployment may be rolling; retry with backoff" for a request that
		# can never succeed (2026-09-14 evaluation, g8-1). None of these
		# sentences can name an upstream fault at 502 time — a response-body
		# framing error surfaces only after the round trip — so they are a
		# safe 400. Substrings, never anchored; never echoed.
		@badChunk expression `{http.error.status_code} == 502 && {http.error.message}.matches("invalid byte in chunk length|empty hex number for chunk length|http chunk length too large|malformed chunked encoding|chunked encoding contains too much non-data|chunked line ends with bare LF|invalid CR in chunked line|header line too long")`
		handle @badChunk {
			import edge_json_refusal
			respond `{"error":"The request body's chunked encoding is malformed — each chunk is a hexadecimal size line, its bytes and CRLF, ended by a zero-size chunk; send a well-formed body or declare a Content-Length","code":"BODY_CHUNK_MALFORMED","requestId":"{http.request.uuid}"}` 400
		}
		# The machine doors: every lane the entrypoint injects plus the
		# platform's keyless JSON doors (/api/health, /status.json,
		# /openapi.json). Judged on the PATH alone — no Accept sniffing — so
		# the answer is deterministic for the caller and for the access log,
		# and on the raw request-URI, which Caddy restores before the error
		# routes run: the optional leading segment keeps the rule true under
		# a subpath deployment. `respond` without a status keeps the error's
		# own (502, 503 or 504); the wait is a hint, not a promise — the
		# platform is usually back within seconds of a roll.
		@machineDoor expression `{http.request.uri}.matches("(?i)^(/[^/?]+)?/(api|scim|http_api)(/|$)") || {http.request.uri}.matches("(?i)^(/[^/?]+)?/(events|status[.]json|openapi[.]json)([?]|$)") || {http.request.uri}.matches("(?i)^(/[^/?]+)?/[.]well-known/")`
		handle @machineDoor {
			import edge_json_refusal
			header Retry-After 5
			respond `{"error":"The platform is not answering right now — a deployment may be rolling; retry with backoff","code":"UPSTREAM_UNAVAILABLE","requestId":"{http.request.uuid}"}`
		}
		# Everyone else — a navigation, an asset, the SPA — gets the page.
		handle {
			root * /var/www
			rewrite * /maintenance.html
			file_server
		}
	}

	header {
		-Server
		# Caddy stamps `Via: 1.1 Caddy` on every proxied response — the same
		# product disclosure `-Server` removes.
		-Via
		# Content security headers (CSP, HSTS, X-Frame-Options, X-Content-Type-Options,
		# Referrer-Policy, Permissions-Policy) are emitted by the platform server via
		# Hono `secureHeaders` middleware (see services/platform/server.ts) so the
		# app is the single source of truth. Caddy keeps only transport concerns.
	}
}
