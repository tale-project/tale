# =============================================================================
# AI Gateway — environment
# =============================================================================
# Copy to services/ai-gateway/.env and fill in.
#
# Generate a set:
#   bun -e 'const c=require("node:crypto");console.log(`AI_GATEWAY_API_KEY=${c.randomBytes(32).toString("base64url")}`);console.log(`AI_GATEWAY_ENCRYPTION_KEY=${c.randomBytes(32).toString("base64")}`)'
#
# `bun run --filter @tale/ai-gateway dev` generates either of the two that is
# absent and prints them once. Production refuses to start without them.
#
# The panel has NO login of its own — put a gateway in front of it. See the
# README's "Who may open the panel".

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Guards every GET /api/tokens* — the endpoints that hand out stored tokens.
AI_GATEWAY_API_KEY=

# 32 base64-encoded bytes. Encrypts the stored OAuth tokens (AES-256-GCM).
# IRREPLACEABLE: a new key cannot decrypt what the previous one sealed, and
# every account would have to be authorized again.
AI_GATEWAY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Where accounts.json lives. This file IS the credential pool — back it up.
# AI_GATEWAY_DATA_DIR=.data

# Cadence of the background pass that refreshes tokens and usage readings.
# AI_GATEWAY_REFRESH_INTERVAL_SECONDS=300

# Floor between two usage reads for one account; both vendors rate-limit the
# usage endpoint per token, hard.
# AI_GATEWAY_USAGE_MIN_INTERVAL_SECONDS=180

# How long before its stated expiry an access token is refreshed anyway.
# AI_GATEWAY_TOKEN_REFRESH_SKEW_SECONDS=300

# Reported as `claude-code/<version>` to Anthropic's usage endpoint, which
# throttles anything that does not identify itself as the CLI.
# AI_GATEWAY_CLAUDE_CODE_VERSION=1.0.0

# The vendors' public CLI OAuth clients. Set only if one is ever rotated.
# AI_GATEWAY_ANTHROPIC_CLIENT_ID=
# AI_GATEWAY_OPENAI_CLIENT_ID=

# Error reporting. Absent, nothing is reported and nothing is sent anywhere.
# A deployment supplies the DSN of its own error-tracking project.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Port the server listens on (the Vite dev server uses 3004 regardless).
# PORT=3004
