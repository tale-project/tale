{
  "name": "@tale/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-provider AI subscription credential gateway",
  "type": "module",
  "scripts": {
    "setup": "echo 'Dependencies managed by root workspace'",
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "start": "bun server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest --coverage --passWithNoTests",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "dependencies": {
    "@tale/ui": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "hono": "4.13.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tale/e2e": "workspace:*",
    "@types/bun": "1.3.11"
  }
}
