# =============================================================================
# Session Manager — Dockerfile.dockerignore
# =============================================================================
# BuildKit picks this file (adjacent to the Dockerfile) over the root
# .dockerignore. It does NOT merge — so this file must list everything we want
# excluded from the image's build context.
#
# Unlike the other React services, the runner stage COPYs the server's own
# sources (`backend/`, `lib/`, `server.ts`) straight from the context, so they
# must NOT be ignored here: the builder stage lists the page's inputs file by
# file instead, and a backend edit leaves the page build cached.
#
# Build (from repo root):
#   docker build -f services/session-manager/Dockerfile -t tale-session-manager .

# =============================================================================
# Local environment files
# =============================================================================
**/.env
**/.env.*

# =============================================================================
# Git
# =============================================================================
.git
.gitignore
.gitattributes

# =============================================================================
# CI / tooling
# =============================================================================
.github/
.husky/
.claude/
.agents/
.vscode/
.idea/
.ruff_cache/
.turbo/
**/.turbo/
.trivyignore
.oxlintrc.json
.oxfmtrc.json

# =============================================================================
# Documentation
# =============================================================================
**/*.md
docs/

# =============================================================================
# IDE / OS
# =============================================================================
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Node
# =============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Build artifacts
# =============================================================================
*.tsbuildinfo
**/*.tsbuildinfo
**/dist/
**/build/
**/.output/
**/.vinxi/
**/.vite/
# TanStack Router's scratch directory next to the generated route tree.
**/.tanstack/

# =============================================================================
# Testing
# =============================================================================
tests/
**/coverage/
.nyc_output/
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
**/test-results/
**/playwright-report/
# Test-only support (`backend/testing/`: the fakes the backend's tests share) and
# the whole test tree: Playwright specs, the guards, the manual layer, the
# page's test utilities (`tests/utils`).
services/session-manager/backend/testing/
services/session-manager/tests/
# A real Camoufox build the browser tests install next to the service
# (hundreds of MB), and the data directory of a local run (the database, the
# profiles, secrets): neither belongs in a build context, let alone an image.
**/.camoufox-tests/
services/session-manager/data/

# =============================================================================
# Storybook
# =============================================================================
.storybook/
**/.storybook/
**/*.stories.tsx
**/*.stories.ts
**/*.stories.jsx
**/*.stories.js
storybook-static/

# =============================================================================
# Logs / temp / cache / misc
# =============================================================================
*.log
*.tmp
*.temp
.cache/
.playwright-mcp/
knip-results.json
design/
configs/
scripts/

# =============================================================================
# Docker files
# =============================================================================
docker-compose.yml
docker-compose.*.yml
compose.yml
compose.*.yml
.dockerignore
**/Dockerfile.dockerignore

# =============================================================================
# Session-Manager-specific: the image needs only services/session-manager
# + the packages/ui workspace (the page is built from it, and the server
# imports `@tale/ui/server` unbundled). All other trees stay out of the build
# context — `bun install` only needs each workspace's package.json
# (re-included below).
# =============================================================================
services/platform/
services/web/
services/docs/
services/ui-docs/
services/db/
services/proxy/
services/sandbox/
services/sandbox-egress/
services/sandbox-buildkitd/
services/sandbox-llm-gateway/
services/sandbox-runtime/
!services/sandbox-runtime/daemon/package.json
packages/shared/
packages/marketing-ui/
tools/

# `bun install` needs every workspace package.json present at its declared
# path so the workspace graph resolves (the root manifest names
# `services/sandbox-runtime/daemon` explicitly). Re-include just the
# manifests — source trees stay excluded by the rules above.
!services/platform/package.json
!services/web/package.json
!services/docs/package.json
!services/ui-docs/package.json
!services/db/package.json
!services/proxy/package.json
!services/sandbox/package.json
!packages/shared/package.json
!packages/marketing-ui/package.json
!tools/cli/package.json
!tools/plop/package.json
!tools/opengrep/package.json
