# Session Manager reads everything from the environment; no value is required.
# Copy this file to `.env` (git-ignored) in services/session-manager, where Bun
# loads it when `bun run start` or `bun run dev` starts, or export the variables
# in the shell. Empty means "use the default".

# Port the server listens on: the page, the HTTP API and /mcp. `bun run dev` serves the page from Vite on 3004 and starts the
# backend itself on 3204, so this one is for `bun run start`.
PORT=3004

# Interface to bind. There is no login: keep the loopback address unless
# something in front of the server authenticates every request.
SESSION_MANAGER_HOST=127.0.0.1

# More values of the Host header the app answers to, comma separated, each with
# its port (for example the name a reverse proxy forwards). Any other Host gets
# 403 forbidden_host, which blocks DNS rebinding. 127.0.0.1, localhost and
# SESSION_MANAGER_HOST on PORT are always allowed.
SESSION_MANAGER_ALLOWED_HOSTS=

# Holds manager.db (proxy passwords and secrets, in plain text), profiles/<id>/
# (each session's cookies and storage) and, unless CAMOUFOX_INSTALL_DIR says
# otherwise, the browser. Created with mode 0700; relative paths resolve against
# the working directory.
SESSION_MANAGER_DATA_DIR=./data

# Where the Camoufox browser build (about 1.3 GB) and the GeoIP database are
# installed. Empty: <SESSION_MANAGER_DATA_DIR>/camoufox. Point it at an existing
# install of the same build to skip the download. Use a directory of its own:
# the build in use is recorded in a config.json there, so a directory another
# Camoufox program shares would switch that program's browser too.
CAMOUFOX_INSTALL_DIR=

# Remove WebRTC (RTCPeerConnection) from every browser: 1, true, yes or on.
# Empty or off: WebRTC stays available and reports the proxy's exit IP only.
# Blocking is the safest against leaks, but a page can tell WebRTC is missing.
SESSION_MANAGER_BLOCK_WEBRTC=

# The largest screen the fingerprint of a new session may have, WIDTHxHEIGHT
# (1920x1080, say). A session's window is as large as its fingerprint says, so
# empty means the room for windows on the largest display of this computer
# (on macOS, without the menu bar and the Dock; elsewhere 1920x1080). Only
# sessions created afterwards are affected.
SESSION_MANAGER_MAX_SCREEN=

# The version the About section (Settings, General), /api/meta, /api/health and
# the MCP server report.
TALE_VERSION=dev

# Debug lines about what the browser layer, the proxy checks and bridge and the
# AI tools ignored on purpose (an input a page refused, a socket a proxy reset,
# an action that ended after its tool had answered): session-manager, or * for
# all.
DEBUG=

# Development only (`bun run dev` sets it): where the Vite dev server forwards
# /api and /mcp. Default
# http://127.0.0.1:3204, the backend `bun run dev` starts beside Vite.
# SESSION_MANAGER_BACKEND_URL=http://127.0.0.1:3204

# Browser tests only (bun run test:e2e). The suite runs one fake backend per
# Playwright worker, all started by tests/e2e/launcher.ts: server i listens on
# E2E_BACKEND_PORT + i and its control server on E2E_CONTROL_PORT + i (default:
# the backend's port + 1000). See tests/manual/setup.md for how a manual round
# uses a single server (`bun tests/e2e/server.ts`).
# E2E_BACKEND_PORT=3204
# E2E_CONTROL_PORT=4204
# Workers, one server each (default: 4, or the cores if fewer; 1 runs the suite
# serially), and the servers the launcher starts (default: as many as the
# workers).
# E2E_WORKERS=4
# E2E_SERVERS=4
# 1: the page is built already (CI restores it through Turbo), so nothing is
# built before the servers start. E2E_DIST_DIR serves a page built elsewhere (a
# private build), which leaves dist/ alone.
# E2E_USE_BUILD=0
# E2E_DIST_DIR=
# A Vite dev server the page is opened through (one place to go, so one worker:
# E2E_WORKERS=1), and its port, which the fake backend names in the Host values
# it answers to (default 3004).
# E2E_BASE_URL=http://localhost:3004
# E2E_APP_PORT=3004
# How long the fake browser takes to start a session, and a fake proxy check to
# answer, in milliseconds.
# E2E_LAUNCH_DELAY_MS=400
# E2E_CHECK_DELAY_MS=150
