{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/components/docs/*.ts",
        "$TURBO_ROOT$/packages/ui/src/markdown/heading-id.ts"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/components/docs/*.ts"
      ],
      "outputs": [
        "$TURBO_EXTENDS$",
        "dist-ssr/**",
        "dist-seo/**",
        "app/content/frontmatter.json",
        "public/search-index.json"
      ]
    },
    "test:prerender": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/e2e/src/crawl.ts"
      ]
    }
  }
}
