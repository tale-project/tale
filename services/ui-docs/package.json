{
  "name": "@tale/ui-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Tale design-system documentation site (ui.tale.dev)",
  "type": "module",
  "scripts": {
    "setup": "echo 'Dependencies managed by root workspace'",
    "dev": "bun --bun scripts/build-content.ts && bun --bun vite",
    "build": "bun --bun scripts/build-content.ts && bun --bun vite build && bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr && bun --bun scripts/prerender.ts && bun run seo:compile",
    "build:client": "bun --bun vite build",
    "build:ssr": "bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr",
    "build:content": "bun --bun scripts/build-content.ts",
    "prerender": "bun --bun scripts/prerender.ts",
    "seo:compile": "bun --bun ../../packages/ui/bin/seo-compile.ts ./scripts/seo.config.ts --out dist-seo",
    "start": "bun server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "dependencies": {
    "@tale/marketing-ui": "workspace:*",
    "@tale/ui": "workspace:*",
    "@tanstack/react-table": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tale/e2e": "workspace:*",
    "@types/bun": "1.3.11",
    "vitest-axe": "1.0.0-pre.5"
  }
}
