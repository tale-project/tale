{
  "name": "@tale/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tale marketing site",
  "type": "module",
  "scripts": {
    "setup": "echo 'Dependencies managed by root workspace'",
    "dev": "bun --bun vite",
    "build": "bun run fetch-releases && bun --bun vite build && bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr && bun --bun scripts/prerender.ts && bun run seo:compile",
    "build:client": "bun --bun vite build",
    "build:ssr": "bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr",
    "prerender": "bun --bun scripts/prerender.ts",
    "fetch-releases": "bun --bun scripts/fetch-releases.ts",
    "seo:compile": "bun --bun ../../packages/ui/bin/seo-compile.ts ./scripts/seo.config.ts --out dist-seo",
    "optimize-images": "bun --bun scripts/optimize-images.ts",
    "start": "bun server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest --coverage --passWithNoTests",
    "test:prerender": "bunx vitest --run --config vitest.prerender.config.ts",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "storybook": "bunx --bun storybook dev -p 6010",
    "storybook:build": "bunx --bun storybook build -o storybook-static"
  },
  "dependencies": {
    "@tale/ui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "framer-motion": "12.38.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tale/e2e": "workspace:*",
    "@types/bun": "1.3.11",
    "sharp": "0.35.3"
  }
}
