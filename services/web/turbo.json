{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "!app/generated/releases-manifest.ts"
      ],
      "outputs": [
        "$TURBO_EXTENDS$",
        "dist-ssr/**",
        "dist-seo/**",
        "app/generated/releases-manifest.ts"
      ]
    }
  }
}
