# Tale Web (marketing site) — environment configuration
# Copy to services/web/.env for local Docker runs, or set at deploy time.

# HTTP listen port (default 3001; the Dockerfile sets this).
PORT=3001

# Optional Playwright test setting: 0 keeps the normal local preview build.
# 1 reuses complete output from bunx turbo run build --filter=@tale/web.
# CI sets 1 after that build; build first before opting in locally.
E2E_USE_BUILD=0

# Explicit local preview for unpublished Markdown pages. Honored by Vite dev
# only; production routes and all SEO discovery always exclude draft pages.
VITE_MARKETING_CONTENT_PREVIEW=false

# Discord webhook for Contact / Request Demo form submissions.
# Create in Discord: Server Settings → Connectors → Webhooks → New Webhook.
# Required for production tale.dev — without it, /api/forms/submit returns 503.
WEB_DISCORD_WEBHOOK_URL=

# When true, /api/health returns 503 if WEB_DISCORD_WEBHOOK_URL is unset so
# deploy health checks surface the misconfiguration before users hit the form.
# Recommended for production deployments that expose contact/demo forms.
WEB_FORMS_REQUIRED=false

# Optional Sentry-compatible error metadata, configured at runtime for both
# browser and server. Empty disables all reporting. No visitor/form data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
TALE_VERSION=dev

# Optional aggregate analytics, read at runtime; all three values are required.
# Empty UMAMI_WEBSITE_ID disables tracking. The token stays server-side.
# UMAMI_URL is the HTTPS origin of the authenticated /_collect gateway.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_PROXY_TOKEN=
