{
  "name": "@tale/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Tale documentation site",
  "type": "module",
  "scripts": {
    "setup": "echo 'Dependencies managed by root workspace'",
    "dev": "bun --bun scripts/build-search-index.ts && bun --bun vite",
    "build": "bun --bun scripts/build-search-index.ts && bun --bun vite build && bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr && bun --bun scripts/prerender.ts && bun run seo:compile",
    "build:client": "bun --bun vite build",
    "build:ssr": "bun --bun vite build --ssr app/entry-server.tsx --outDir dist-ssr",
    "prerender": "bun --bun scripts/prerender.ts",
    "build:search-index": "bun --bun scripts/build-search-index.ts",
    "seo:compile": "bun --bun ../../packages/ui/bin/seo-compile.ts ./scripts/seo.config.ts --out dist-seo",
    "start": "bun server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:prerender": "bunx vitest --run --config vitest.prerender.config.ts",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "storybook": "bunx --bun storybook dev -p 6011",
    "storybook:build": "bunx --bun storybook build -o storybook-static"
  },
  "dependencies": {
    "@tale/ui": "workspace:*",
    "framer-motion": "12.42.2",
    "minisearch": "7.2.0",
    "vite-plugin-pwa": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tale/e2e": "workspace:*",
    "@types/bun": "1.3.11",
    "yaml": "2.9.0"
  }
}
