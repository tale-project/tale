#!/usr/bin/env python3
"""Tale sandbox wrapper for Gemini CLI — selects system config, then runs
`gemini --output-format stream-json` (NDJSON on stdout, passed through).

The platform harness sends ONE JSON object on stdin:
  {"prompt": ..., "system_prompt"?: ..., "settings": {...}}
and its stream parser normalizes the CLI's stdout into HarnessEvent[].
Two inputs have no CLI flag and must be ON DISK before the CLI starts:

  - settings (auth-type pin, tools.exclude, mcpServers, maxSessionTurns) —
    selected from immutable image files generated by build-gemini-settings.ts
    from the SAME harness interpreter that builds stdin. Gemini 0.60+ requires
    root-owned system settings and ancestors; a private agent-owned temp file
    is silently ignored. Content-addressing fails closed on an incompatible
    platform/image pair instead of dropping policy. Only string substitutions
    (bridge URL and context filename) travel through per-exec environment.
    System scope still wins over any repo .gemini/settings.json.
  - the system-prompt APPEND — staged as a per-exec context file under
    ~/.gemini/ and added to `context.fileName` alongside GEMINI.md, so it is
    appended to the model context without replacing the CLI's core system
    prompt (GEMINI_SYSTEM_MD would replace it). The per-exec filename keeps
    concurrent execs sharing this HOME from reading each other's append.

The prompt itself rides the child's stdin — Gemini CLI's native headless
prompt source — never argv (process lists leak argv, and a leading-dash
prompt would parse as a flag).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import signal
import subprocess
import sys
import uuid
from pathlib import Path


SETTINGS_DIR = Path(__file__).resolve().parent.parent / "share/tale/gemini-settings"
BRIDGE_URL_VAR = "${TALE_GEMINI_BRIDGE_URL}"


def select_settings(settings: dict, env: dict) -> str:
    """Select only a policy baked from the platform's harness facts. A repo
    cannot replace these root-owned files, and unknown settings fail before
    Gemini launches. Never fall back to mutable user settings (lower priority
    than a repository's settings)."""
    normalized = json.loads(json.dumps(settings))
    servers = normalized.get("mcpServers")
    if isinstance(servers, dict) and "connectors" in servers:
        bridge = servers["connectors"]
        bridge_env = bridge.get("env") if isinstance(bridge, dict) else None
        url = (
            bridge_env.get("TALE_CONNECTORS_URL")
            if isinstance(bridge_env, dict)
            else None
        )
        if not isinstance(url, str) or not url:
            raise ValueError("connector settings must contain a bridge URL")
        env["TALE_GEMINI_BRIDGE_URL"] = url
        bridge_env["TALE_CONNECTORS_URL"] = BRIDGE_URL_VAR
    fingerprint = hashlib.sha256(
        json.dumps(
            normalized, sort_keys=True, separators=(",", ":"), ensure_ascii=False
        ).encode("utf-8")
    ).hexdigest()
    path = SETTINGS_DIR / f"{fingerprint}.json"
    if not path.is_file():
        raise ValueError(
            "Gemini settings do not match this sandbox image; update the runtime image"
        )
    return str(path)


def emit(event: dict) -> None:
    """One NDJSON line on stdout, in the CLI's own stream-json dialect so the
    platform parser handles wrapper failures like CLI failures."""
    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def fail(message: str, code: int = 1) -> int:
    emit({"type": "error", "severity": "error", "message": message})
    emit(
        {
            "type": "result",
            "status": "error",
            "error": {"type": "wrapper", "message": message},
        }
    )
    return code


def read_stdin_payload() -> dict | None:
    try:
        payload = json.loads(sys.stdin.read())
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(payload, dict):
        return None
    prompt = payload.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        return None
    return payload


def main() -> int:
    parser = argparse.ArgumentParser(description="Run Gemini CLI for Tale sandbox")
    parser.add_argument("--workdir", default="/user/workspace")
    parser.add_argument("--model")
    parser.add_argument("--resume")
    parser.add_argument("--include-directories", action="append", default=[])
    args = parser.parse_args()

    payload = read_stdin_payload()
    if payload is None:
        return fail(
            'stdin must carry {"prompt": ..., "system_prompt"?: ..., "settings": {...}} as JSON'
        )
    prompt = payload["prompt"]
    system_prompt = payload.get("system_prompt")
    if not isinstance(system_prompt, str) or not system_prompt.strip():
        system_prompt = None
    settings = payload.get("settings")
    if not isinstance(settings, dict):
        return fail("stdin settings must be an object")

    home = os.environ.get("HOME") or os.path.expanduser("~")
    gemini_dir = os.path.join(home, ".gemini")
    context_path = None
    try:
        env = dict(os.environ)
        env["GEMINI_CLI_SYSTEM_SETTINGS_PATH"] = select_settings(settings, env)
        # A unique nonexistent filename also keeps an exec without appended
        # instructions from loading another exec's context.
        context_name = f"tale-context-{uuid.uuid4().hex}.md"
        env["TALE_GEMINI_CONTEXT_FILE"] = context_name
        if system_prompt is not None:
            # Per-exec context file: ~/.gemini/<name> is a global context path
            # for every name in context.fileName (verified 0.62.0
            # memoryDiscovery). Keep GEMINI.md first so the working repo's own
            # context files still load.
            os.makedirs(gemini_dir, mode=0o700, exist_ok=True)
            context_path = os.path.join(gemini_dir, context_name)
            fd = os.open(context_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(system_prompt)

        # --approval-mode yolo: fully autonomous — the container is the safety
        # boundary. --skip-trust: headless folder-trust gate would otherwise
        # silently downgrade yolo to interactive approvals (verified 0.62.0).
        cmd = [
            "gemini",
            "--output-format",
            "stream-json",
            "--approval-mode",
            "yolo",
            "--skip-trust",
        ]
        if args.model:
            cmd += ["--model", args.model]
        if args.resume:
            cmd += ["--resume", args.resume]
        for directory in args.include_directories:
            cmd += ["--include-directories", directory]

        proc = subprocess.Popen(
            # nosemgrep: tools.opengrep.rules.python.lang.security.audit.dangerous-subprocess-use-tainted-env-args.dangerous-subprocess-use-tainted-env-args -- fixed gemini argv plus adapter-provided flags, list-form exec (no shell); launching the agent CLI inside the sandbox is this runner's purpose, same trust model as the sibling tale-*-run launchers
            cmd,
            cwd=args.workdir,
            env=env,
            stdin=subprocess.PIPE,
            # stdout/stderr inherit: the CLI's stream-json goes straight to the
            # platform's stdout reader; human-oriented noise stays on stderr.
        )
        try:
            proc.stdin.write(prompt.encode("utf-8"))
            proc.stdin.close()
        except BrokenPipeError:
            print(
                "[tale-gemini-run] gemini exited before reading stdin", file=sys.stderr
            )
        return proc.wait()
    except FileNotFoundError as exc:
        return fail(f"gemini-cli not installed or file missing: {exc}")
    except Exception as exc:  # noqa: BLE001 — surface anything as a run error
        return fail(f"wrapper failure: {exc}")
    finally:
        if context_path is not None:
            try:
                os.unlink(context_path)
            except OSError as exc:
                print(
                    f"[tale-gemini-run] context cleanup failed: {exc}", file=sys.stderr
                )


class Cancelled(BaseException):
    """Raised when runnerd ends the exec (a process-group SIGTERM on cancel,
    at the exec's deadline or when it exits). Python's default SIGTERM
    disposition runs no `finally`, which left the per-exec context file
    behind; a BaseException unwinds through its cleanup and
    past the generic `except Exception` in main()."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def _cancel(signum: int, _frame: object) -> None:
    # The cleanup this starts must not be cut short by a second signal (a
    # group SIGTERM after a Ctrl-C, the session's stop after a cancel).
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    raise Cancelled(signum)


if __name__ == "__main__":
    for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(_sig, _cancel)
    try:
        raise SystemExit(main())
    except Cancelled as cancelled:
        raise SystemExit(128 + cancelled.signum) from None
