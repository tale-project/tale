{
  "name": "@tale/sandbox-runtime-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "runnerd — in-container control daemon for persistent sandbox sessions; bundled to dist/runnerd.mjs and run by the runtime image's Node 24",
  "type": "module",
  "scripts": {
    "build": "bun build --target=node src/main.ts --outfile dist/runnerd.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0"
  }
}
