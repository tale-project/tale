#!/usr/bin/env python3
"""Tale sandbox wrapper for Pi — stages per-exec config, then runs
`pi --mode json` (NDJSON on stdout, passed through).

The platform adapter (pi/adapter.ts) sends ONE JSON object on stdin:
  {"prompt": ..., "system_prompt"?: ..., "models"?: {...}, "settings"?: {...}}
and pi/parse.ts normalizes the CLI's JSON event stream into AgentEvent[]. The
wrapper exists because three inputs have no safe CLI flag and must be ON DISK
before the CLI starts (verified @earendil-works/pi-coding-agent 1.0.1):

  - models.json (managed gateway provider: baseUrl <gateway>/openai/v1 +
    apiKey "$TALE_GATEWAY_TOKEN" env interpolation, so the file never holds
    the key) — staged into a PRIVATE per-exec config dir pointed at via
    PI_CODING_AGENT_DIR, so concurrent execs sharing this HOME never read
    each other's provider config.
  - settings.json (enableInstallTelemetry off) — same per-exec dir.
  - the system-prompt APPEND — staged as <config dir>/APPEND_SYSTEM.md,
    which Pi auto-discovers and APPENDS to its default system prompt
    (SYSTEM.md would replace it and drop the defaults).

Sessions stay OUT of the per-exec dir: PI_CODING_AGENT_SESSION_DIR pins them
to a stable HOME path so `--resume <id>` (Pi `--session <id>`) finds prior
turns. Global skills keep working because Pi also loads ~/.agents/skills, a
homedir path independent of the config-dir override.

The prompt itself rides the CLI's stdin — Pi's native headless prompt
source — never argv (process lists leak argv, and a leading-dash prompt would
parse as a flag). `--approve` trusts the workspace's project-local files for
the run: the container is the safety boundary (parity with Claude Code
bypassPermissions / Gemini yolo).

The wrapper then becomes the CLI (exec, same pid) instead of waiting for it,
so no Python process stays resident for the turn: the CLI's exit status and
signals are the exec's own. Nothing is left to remove the per-exec config dir
when the CLI exits. It sits in $TMPDIR, which the runtime empties at every
container start, and its name carries the exec's pid, so the next wrapper to
start also removes every config dir whose pid no longer runs.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import sys
import tempfile
from typing import NoReturn

# tale-pi-<pid of the exec that staged it>-<mkdtemp suffix>
STAGE_DIR = re.compile(r"tale-pi-(?P<pid>[1-9][0-9]{0,6})-[A-Za-z0-9_]+")


def emit(event: dict) -> None:
    """One NDJSON line on stdout. `wrapper_error` is the wrapper's own
    dialect (documented in pi/parse.ts) — Pi has no generic error event."""
    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def fail(message: str, code: int = 1) -> int:
    emit({"type": "wrapper_error", "message": message})
    return code


def read_stdin_payload() -> dict | None:
    try:
        payload = json.loads(sys.stdin.read())
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(payload, dict):
        return None
    prompt = payload.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        return None
    return payload


def pid_running(pid: int) -> bool:
    """Whether a process with this pid runs in this container. One owned by
    another user counts as running."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def remove_ended_stage_dirs(tmp: str) -> None:
    """Remove the config dirs of execs that have ended. A dir whose pid runs
    stays: it is a live exec's, or a pid reused since the last container
    start, which only keeps the dir until that process ends. Best effort: a
    failure is logged and never stops this exec."""
    try:
        names = os.listdir(tmp)
    except OSError as exc:
        print(f"[tale-pi-run] config cleanup failed: {exc}", file=sys.stderr)
        return
    for name in names:
        match = STAGE_DIR.fullmatch(name)
        if match is None or pid_running(int(match["pid"])):
            continue
        path = os.path.join(tmp, name)
        if os.path.islink(path) or not os.path.isdir(path):
            continue
        try:
            shutil.rmtree(path)
        except FileNotFoundError:
            # Another wrapper starting at the same time got there first.
            continue
        except OSError as exc:
            print(f"[tale-pi-run] config cleanup failed: {exc}", file=sys.stderr)


def stdin_from(prompt: str) -> None:
    """Make the prompt this process's stdin, for the CLI to read to its end.
    An anonymous temporary file holds it: nothing named is left to remove,
    and unlike a pipe nobody reads yet it takes a prompt of any size."""
    with tempfile.TemporaryFile() as staged:
        staged.write(prompt.encode("utf-8"))
        staged.flush()
        staged.seek(0)
        os.dup2(staged.fileno(), 0)


def become(cmd: list[str], workdir: str, env: dict) -> NoReturn:
    """Replace this process with the CLI. Raises when the CLI cannot be
    started; never returns."""
    os.chdir(workdir)
    # Python ignores SIGPIPE and SIGXFSZ for itself, and an ignored signal
    # stays ignored across exec; the CLI gets their defaults, as a
    # subprocess child would.
    for name in ("SIGPIPE", "SIGXFSZ"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), signal.SIG_DFL)
    sys.stdout.flush()
    sys.stderr.flush()
    # nosemgrep: tools.opengrep.rules.python.lang.security.audit.dangerous-os-exec-tainted-env-args.dangerous-os-exec-tainted-env-args -- fixed pi argv plus adapter-provided flags, list-form exec (no shell); launching the agent CLI inside the sandbox is this runner's purpose, same trust model as the sibling tale-*-run launchers
    os.execvpe(cmd[0], cmd, env)


def main() -> int:
    parser = argparse.ArgumentParser(description="Run Pi for Tale sandbox")
    parser.add_argument("--workdir", default="/user/workspace")
    parser.add_argument("--model")
    parser.add_argument("--provider")
    parser.add_argument("--resume")
    args = parser.parse_args()

    payload = read_stdin_payload()
    if payload is None:
        return fail(
            'stdin must carry {"prompt": ..., "system_prompt"?: ..., '
            '"models"?: ..., "settings"?: ...} as JSON'
        )
    prompt = payload["prompt"]
    system_prompt = payload.get("system_prompt")
    if not isinstance(system_prompt, str) or not system_prompt.strip():
        system_prompt = None
    models = payload.get("models")
    if not isinstance(models, dict):
        models = None
    settings = payload.get("settings")
    if not isinstance(settings, dict):
        settings = {}

    home = os.environ.get("HOME") or os.path.expanduser("~")
    stage_dir = None
    try:
        remove_ended_stage_dirs(tempfile.gettempdir())
        # The pid is this exec's for as long as it runs: the CLI takes it over.
        stage_dir = tempfile.mkdtemp(prefix=f"tale-pi-{os.getpid()}-")
        agent_dir = os.path.join(stage_dir, "agent")
        os.makedirs(agent_dir, exist_ok=True)
        with open(os.path.join(agent_dir, "settings.json"), "w", encoding="utf-8") as f:
            json.dump(settings, f)
        if models is not None:
            with open(
                os.path.join(agent_dir, "models.json"), "w", encoding="utf-8"
            ) as f:
                json.dump(models, f)
        if system_prompt is not None:
            with open(
                os.path.join(agent_dir, "APPEND_SYSTEM.md"), "w", encoding="utf-8"
            ) as f:
                f.write(system_prompt)

        env = dict(os.environ)
        env["PI_CODING_AGENT_DIR"] = agent_dir
        # Stable across turns — resume must find the prior session files.
        env["PI_CODING_AGENT_SESSION_DIR"] = os.path.join(
            home, ".pi", "agent", "sessions"
        )
        # No startup update-check network round-trip inside the sandbox.
        env["PI_SKIP_VERSION_CHECK"] = "1"

        cmd = [
            "pi",
            "--mode",
            "json",
            "--approve",
        ]
        if args.provider:
            cmd += ["--provider", args.provider]
        if args.model:
            cmd += ["--model", args.model]
        if args.resume:
            cmd += ["--session", args.resume]

        # stdout/stderr stay as they are: the CLI's JSON event stream goes
        # straight to the platform's stdout reader; human noise stays on
        # stderr. Once `become` succeeds the CLI runs in this process, and
        # nothing below happens.
        stdin_from(prompt)
        become(cmd, args.workdir, env)
    except FileNotFoundError as exc:
        return fail(f"pi not installed or file missing: {exc}")
    except Exception as exc:  # noqa: BLE001 — surface anything as a run error
        return fail(f"wrapper failure: {exc}")
    finally:
        # Reached only when the CLI never started: once it runs, the dir is
        # its until it ends.
        if stage_dir is not None:
            shutil.rmtree(stage_dir, ignore_errors=True)


class Cancelled(BaseException):
    """Raised when runnerd ends the exec (a process-group SIGTERM on cancel
    or at the exec's deadline) before the CLI has replaced the wrapper.
    Python's default SIGTERM disposition runs no `finally`, which would leave
    the staged config behind; a BaseException unwinds through its cleanup and
    past the generic `except Exception` in main(). The exec resets these
    handlers, so once the CLI runs the signal is its own."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def _cancel(signum: int, _frame: object) -> None:
    # The cleanup this starts must not be cut short by a second signal (a
    # group SIGTERM after a Ctrl-C, the session's stop after a cancel).
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    raise Cancelled(signum)


if __name__ == "__main__":
    for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(_sig, _cancel)
    try:
        raise SystemExit(main())
    except Cancelled as cancelled:
        raise SystemExit(128 + cancelled.signum) from None
