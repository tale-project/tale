#!/bin/sh
# Playwright MCP launcher: bridge the container egress env to Chromium flags.
# Chromium ignores HTTPS_PROXY/NO_PROXY env vars, and the sandbox network is
# internal-only — without an explicit --proxy-server the browser can only
# reach in-container addresses. Behavior flags (--headless etc.) stay in the
# agent adapters; this shim only does env→flag bridging.
[ -n "${HTTPS_PROXY:-}" ] && set -- "$@" --proxy-server "$HTTPS_PROXY"
[ -n "${NO_PROXY:-}" ] && set -- "$@" --proxy-bypass "$NO_PROXY"
exec mcp-server-playwright "$@"
