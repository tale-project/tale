#!/usr/bin/env -S python3 -Es
"""Playwright MCP launcher for agent turns.

Every managed agent turn lists the Playwright MCP server among its tools, but
most turns never open a browser, and the server is a Node process that loads
Playwright as it starts: about 100 MB and a third of a second of CPU, held for
the whole turn. So this launcher answers the start of the conversation itself
— `initialize`, `tools/list`, `ping`, and the prompt and resource lists of a
server that advertises neither (Qwen Code asks for them at the start of every
turn) — from a manifest recorded from the real server when the image was
built, and starts the real server only when the turn first asks for anything
else (a tool call). It then replays the client's `initialize` to it and passes
every message through, both ways; a server that does not answer that
`initialize` within START_TIMEOUT_S is ended, and the launcher exits with it.
Where no manifest matches the server
arguments, the server on PATH is not the one the manifest was recorded from,
PLAYWRIGHT_MCP_* settings in the environment may change its tools, or the
client asks for a protocol version the manifest has no answer for, the real
server starts at once, as it always did; TALE_PLAYWRIGHT_MCP_EAGER=1 always
starts it at once.

Managed headless Chromium uses the bundled registry's official headless
shell, recorded by the image installer in browser.json. The server's Chromium
channel otherwise selects the full browser. Its browser_install tool also
always installs that full channel, even with an explicit executable. For this
verified image default, a defensive install request is answered with the
already-installed shell; explicit browser/configuration choices remain the
real server's responsibility.

It also bridges the container's egress env to Chromium flags: Chromium ignores
HTTPS_PROXY/NO_PROXY, and the sandbox network is internal-only, so without an
explicit --proxy-server the browser can only reach in-container addresses.
Playwright force-appends <-loopback> to the Chromium bypass list whenever a
proxy is set, which overrides the explicit localhost/127.0.0.1 entries (later
rules win) and sends loopback traffic to tinyproxy, whose loopback is a
different container; that is turned off so in-container dev servers stay
reachable from the browser. Behaviour flags (--headless etc.) stay with the
agent adapters.

  tale-playwright-mcp [SERVER ARGS...]
  tale-playwright-mcp --write-manifests ARG_SETS.json    (image build)
"""

import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import threading

REAL_SERVER = 'mcp-server-playwright'
MANIFEST_DIR = os.environ.get(
    'TALE_PLAYWRIGHT_MCP_MANIFESTS', '/opt/tale/playwright-mcp'
)
# The protocol versions MCP has named. The manifest holds the server's answer
# to a client asking for each of them (its own latest, for one it does not
# speak); a client asking for another gets the real server.
PROBED_VERSIONS = (
    '2025-11-25',
    '2025-06-18',
    '2025-03-26',
    '2024-11-05',
    '2024-10-07',
)
# The lists a client may ask for at the start of a turn, by the capability a
# server must advertise to answer them: without it the server has no handler,
# and its SDK answers METHOD_NOT_FOUND.
LISTS_BY_CAPABILITY = {
    'prompts/list': 'prompts',
    'resources/list': 'resources',
    'resources/templates/list': 'resources',
}
METHOD_NOT_FOUND = {'code': -32601, 'message': 'Method not found'}
# The id of the replayed `initialize`: the client's own ids never reach it.
REPLAYED_INIT_ID = 'tale-playwright-mcp-initialize'
# How long the image build waits for the real server to answer.
PROBE_TIMEOUT_S = 120
# How long a turn waits for the server it started to answer the replayed
# `initialize`. Then the server is ended, and the launcher with it, so the
# client sees the server gone instead of waiting on its tool call.
START_TIMEOUT_S = 120


def log(message):
    sys.stderr.write(f'[tale-playwright-mcp] {message}\n')
    sys.stderr.flush()


def server_env():
    env = dict(os.environ)
    env['PLAYWRIGHT_DISABLE_FORCED_CHROMIUM_PROXIED_LOOPBACK'] = '1'
    return env


def server_argv(args, env):
    argv = [REAL_SERVER, *args]
    browser = managed_browser(args, env)
    if browser is not None:
        argv += ['--executable-path', browser['executablePath']]
    if env.get('HTTPS_PROXY'):
        argv += ['--proxy-server', env['HTTPS_PROXY']]
    if env.get('NO_PROXY'):
        argv += ['--proxy-bypass', env['NO_PROXY']]
    return argv


def managed_browser(args, env):
    """The image shell, only for the managed headless Chromium arguments.

    User-selected executables, browsers, remote connections and config files
    must retain their own launch/install behavior. Image metadata is kept away
    from the writable browser cache, and tied to the installed MCP server.
    """
    def option(name):
        found = None
        for index, arg in enumerate(args):
            if arg == name:
                found = args[index + 1] if index + 1 < len(args) else None
            if arg.startswith(name + '='):
                found = arg[len(name) + 1:]
        return found

    explicit_options = (
        '--executable-path', '--config', '--cdp-endpoint', '--endpoint',
        '--extension', '--device', '--connect-tool', '--vscode', '--port',
    )
    if '--headless' not in args or option('--browser') != 'chromium':
        return None
    if any(arg == name or arg.startswith(name + '=') for arg in args for name in explicit_options):
        return None
    explicit_env = (
        'PLAYWRIGHT_MCP_EXECUTABLE_PATH', 'PLAYWRIGHT_MCP_CONFIG',
        'PLAYWRIGHT_MCP_BROWSER', 'PLAYWRIGHT_MCP_HEADLESS',
        'PLAYWRIGHT_MCP_CDP_ENDPOINT', 'PLAYWRIGHT_MCP_ENDPOINT',
        'PLAYWRIGHT_MCP_EXTENSION', 'PLAYWRIGHT_MCP_DEVICE',
        'PLAYWRIGHT_MCP_PORT',
    )
    if any(env.get(name) for name in explicit_env):
        return None
    try:
        with open(os.path.join(MANIFEST_DIR, 'browser.json'), encoding='utf-8') as handle:
            browser = json.load(handle)
        if not isinstance(browser, dict):
            return None
        server = server_file(installed_server(env))
        if server is None or browser.get('server') != server:
            return None
        with open(os.path.join(os.path.dirname(server), 'package.json'), encoding='utf-8') as handle:
            version = json.load(handle).get('version')
        if browser.get('serverVersion') != version:
            return None
        if env.get('PLAYWRIGHT_BROWSERS_PATH') and env['PLAYWRIGHT_BROWSERS_PATH'] != browser.get('browsersPath'):
            return None
        executable = browser.get('executablePath')
        if not isinstance(executable, str) or not os.access(executable, os.X_OK):
            return None
        return browser
    except (OSError, ValueError, TypeError):
        return None


def installed_server(env):
    """The real server as the PATH in `env` finds it, or None."""
    return shutil.which(REAL_SERVER, path=env.get('PATH'))


def server_file(path):
    """The file a server path names, links resolved: what a manifest records."""
    return os.path.realpath(path) if path is not None else None


def configured_in_env(env):
    """Whether the environment holds server settings the manifest, keyed by
    the arguments, did not see: PLAYWRIGHT_MCP_CAPS adds tools,
    PLAYWRIGHT_MCP_CONFIG names a file of settings, and so on."""
    return any(key.startswith('PLAYWRIGHT_MCP_') and value for key, value in env.items())


def manifest_path(args):
    key = hashlib.sha256(json.dumps(args).encode()).hexdigest()[:32]
    return os.path.join(MANIFEST_DIR, f'{key}.json')


def load_manifest(args):
    try:
        with open(manifest_path(args), encoding='utf-8') as handle:
            manifest = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as error:
        log(f'manifest unreadable, starting the server at once: {error}')
        return None
    if manifest.get('args') != args:
        return None
    return manifest


def message(line):
    """A JSON-RPC message object from one line, or None."""
    try:
        parsed = json.loads(line)
    except ValueError:
        return None
    return parsed if isinstance(parsed, dict) else None


def encode(obj):
    return json.dumps(obj, separators=(',', ':')).encode() + b'\n'


# --- image build: record what the real server answers ----------------------


def probe(argv, env, version):
    """The real server's answers to `initialize` (asking for `version`) and
    to `tools/list`, from a server of its own."""
    proc = subprocess.Popen(
        argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env
    )
    timer = threading.Timer(PROBE_TIMEOUT_S, proc.kill)
    timer.start()
    try:

        def send(obj):
            proc.stdin.write(encode(obj))
            proc.stdin.flush()

        def answer(id_):
            for line in proc.stdout:
                msg = message(line)
                if msg is not None and msg.get('id') == id_:
                    if 'result' not in msg:
                        raise RuntimeError(f'the server refused: {line!r}')
                    return msg['result']
            raise RuntimeError('the server closed its output before answering')

        send({
            'jsonrpc': '2.0',
            'id': 1,
            'method': 'initialize',
            'params': {
                'protocolVersion': version,
                'capabilities': {},
                'clientInfo': {'name': 'tale-playwright-mcp', 'version': '1'},
            },
        })
        initialize = answer(1)
        send({'jsonrpc': '2.0', 'method': 'notifications/initialized'})
        send({'jsonrpc': '2.0', 'id': 2, 'method': 'tools/list'})
        tools = answer(2)
        return initialize, tools
    finally:
        timer.cancel()
        try:
            proc.stdin.close()
        except OSError:
            pass
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


def write_manifests(arg_sets_file):
    with open(arg_sets_file, encoding='utf-8') as handle:
        arg_sets = json.load(handle)
    env = server_env()
    server = server_file(installed_server(env))
    os.makedirs(MANIFEST_DIR, exist_ok=True)
    for args in arg_sets:
        argv = server_argv(args, env)
        initialize = {}
        tools = {}
        for version in PROBED_VERSIONS:
            initialize[version], tools[version] = probe(argv, env, version)
        path = manifest_path(args)
        with open(f'{path}.tmp', 'w', encoding='utf-8') as handle:
            json.dump(
                {
                    'args': args,
                    'server': server,
                    'initialize': initialize,
                    'tools': tools,
                },
                handle,
            )
        os.replace(f'{path}.tmp', path)
        spoken = sorted({result.get('protocolVersion') for result in initialize.values()})
        print(f'{path}: {" ".join(args)} (speaks {", ".join(map(str, spoken))})')


# --- a turn: answer the start, then pass everything through ----------------


class LazyServer:
    def __init__(self, argv, env, manifest, browser=None):
        self.argv = argv
        self.env = env
        self.manifest = manifest
        self.browser = browser
        self.server = None
        self.pump = None
        self.out = sys.stdout.buffer
        self.out_lock = threading.Lock()
        # The protocol version the client asked for, once it was answered: the
        # manifest's key for its answers.
        self.version = None
        # What it was answered: the protocol version it was told, and the
        # capabilities the server advertised.
        self.told = None
        self.capabilities = None
        self.init_params = None
        self.client_initialized = False
        # Notifications that came before the server: replayed to it.
        self.held = []

    def write(self, data):
        try:
            with self.out_lock:
                self.out.write(data)
                self.out.flush()
        except (BrokenPipeError, ValueError):
            # The client stopped reading: the turn is over.
            if self.server is not None and self.server.poll() is None:
                self.server.terminate()
            os._exit(0)

    def reply(self, id_, result):
        self.write(encode({'jsonrpc': '2.0', 'id': id_, 'result': result}))

    def refuse(self, id_, error):
        self.write(encode({'jsonrpc': '2.0', 'id': id_, 'error': error}))

    def answered(self, msg, line):
        """Answer `msg` without the server; False when it needs the server."""
        if self.manifest is None:
            return False
        method = msg.get('method')
        has_id = 'id' in msg
        if method == 'initialize' and has_id and self.version is None:
            params = msg.get('params')
            version = params.get('protocolVersion') if isinstance(params, dict) else None
            result = self.manifest['initialize'].get(version) if isinstance(version, str) else None
            if not isinstance(result, dict):
                return False
            self.version = version
            self.told = result.get('protocolVersion')
            self.capabilities = result.get('capabilities')
            self.init_params = params
            self.reply(msg['id'], result)
            return True
        if self.version is None:
            return False
        if method == 'notifications/initialized' and not has_id:
            self.client_initialized = True
            return True
        if method == 'ping' and has_id:
            self.reply(msg['id'], {})
            return True
        if method == 'tools/list' and has_id:
            params = msg.get('params')
            if not (isinstance(params, dict) and params.get('cursor')):
                self.reply(msg['id'], self.manifest['tools'][self.version])
                return True
            return False
        if isinstance(method, str) and method in LISTS_BY_CAPABILITY and has_id:
            capabilities = self.capabilities
            if isinstance(capabilities, dict) and LISTS_BY_CAPABILITY[method] not in capabilities:
                self.refuse(msg['id'], METHOD_NOT_FOUND)
                return True
            return False
        if isinstance(method, str) and not has_id:
            self.held.append(line)
            return True
        return False

    def start(self):
        self.server = subprocess.Popen(
            self.argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=self.env
        )
        if self.version is not None:
            deadline = threading.Timer(START_TIMEOUT_S, self.end_unanswered)
            deadline.daemon = True
            deadline.start()
            self.send(encode({
                'jsonrpc': '2.0',
                'id': REPLAYED_INIT_ID,
                'method': 'initialize',
                'params': self.init_params,
            }))
            for line in self.server.stdout:
                msg = message(line)
                if msg is not None and msg.get('id') == REPLAYED_INIT_ID:
                    deadline.cancel()
                    result = msg.get('result')
                    spoken = result.get('protocolVersion') if isinstance(result, dict) else None
                    if spoken != self.told:
                        log(f'the server speaks {spoken}, the client was told {self.told}')
                    break
                self.write(line)
            else:
                self.exit_with_server()
            if self.client_initialized:
                self.send(encode({'jsonrpc': '2.0', 'method': 'notifications/initialized'}))
            for line in self.held:
                self.send(line)
            self.held = []
        self.pump = threading.Thread(target=self.relay_server, daemon=True)
        self.pump.start()

    def end_unanswered(self):
        log(f'the server did not answer its start within {START_TIMEOUT_S} s, ending it')
        self.server.kill()

    def send(self, data):
        try:
            self.server.stdin.write(data)
            self.server.stdin.flush()
        except (BrokenPipeError, ValueError):
            self.exit_with_server()

    def relay_server(self):
        for line in self.server.stdout:
            self.write(line)
        self.exit_with_server()

    def exit_with_server(self):
        code = self.server.wait()
        sys.stderr.flush()
        os._exit(code if code >= 0 else 128 - code)

    def run(self):
        for line in sys.stdin.buffer:
            msg = message(line)
            if msg is not None and msg.get('method') == 'notifications/initialized':
                self.client_initialized = True
            # The pinned MCP installs the full chromium channel regardless of
            # its executable-path option. This shell is already installed;
            # do not mutate or redownload the read-only image on its behalf.
            params = msg.get('params') if msg is not None else None
            if (
                self.browser is not None and self.client_initialized
                and msg.get('method') == 'tools/call' and 'id' in msg
                and isinstance(params, dict) and params.get('name') == 'browser_install'
                and isinstance(params.get('arguments', {}), dict)
                and os.access(self.browser['executablePath'], os.X_OK)
            ):
                self.reply(msg['id'], {'content': [{
                    'type': 'text',
                    'text': 'Managed Chromium headless shell is already installed at '
                            + self.browser['executablePath'] + '.',
                }]})
                continue
            if self.server is not None:
                self.send(line)
                continue
            if msg is None or not self.answered(msg, line):
                self.start()
                self.send(line)
        # The client is gone: so is the turn.
        if self.server is None:
            os._exit(0)
        try:
            self.server.stdin.close()
        except OSError:
            pass
        self.pump.join(timeout=10)
        if self.server.poll() is None:
            self.server.terminate()
        self.exit_with_server()

    def stop(self, signum, _frame):
        if self.server is not None and self.server.poll() is None:
            self.server.send_signal(signum)
        os._exit(128 + signum)


def main():
    args = sys.argv[1:]
    if args[:1] == ['--write-manifests'] and len(args) == 2:
        write_manifests(args[1])
        return
    env = server_env()
    argv = server_argv(args, env)
    browser = managed_browser(args, env)
    manifest = None
    if env.get('TALE_PLAYWRIGHT_MCP_EAGER') != '1' and not configured_in_env(env):
        manifest = load_manifest(args)
    # A server the session installed ahead of the image's on PATH is not the
    # one the manifest was recorded from; the one that is starts by the path
    # checked here.
    server = installed_server(env)
    if manifest is not None and (server is None or server_file(server) != manifest.get('server')):
        manifest = None
    if manifest is None and browser is None:
        os.execvpe(REAL_SERVER, argv, env)
    lazy = LazyServer([server, *argv[1:]], env, manifest, browser)
    if manifest is None:
        lazy.start()
    signal.signal(signal.SIGTERM, lazy.stop)
    signal.signal(signal.SIGINT, lazy.stop)
    signal.signal(signal.SIGHUP, lazy.stop)
    lazy.run()


if __name__ == '__main__':
    main()
