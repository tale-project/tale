#!/bin/sh
# tale-git-credential — git credential helper for the Tier-2 broker.
#
# Armed per exec through GIT_CONFIG_* (`credential.helper`) by the
# platform's credential broker
# (services/platform/backend/core/node_only/sandbox/session_credentials.ts).
# On each git network operation git invokes it with `get` and the request
# attributes (protocol/host/...) on stdin; it answers from
# TALE_GIT_CREDENTIALS, the per-exec map the broker hands the turn: one
# `<host> <username> <token>` line for every equipped connector whose
# credential opens a git host (github.com, a Forgejo instance, ...).
#
# A host the map does not name gets no answer — never a token from another
# variable such as GITHUB_TOKEN — so git falls back to its next helper and
# then fails loudly, never leaking one host's token to another. git ignores
# unknown lines, and the map dies with the exec: ungranting a connector
# removes its host on the next turn. The helper never writes the token
# anywhere but to git on stdout.

[ "$1" = "get" ] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    "") break ;;
  esac
done

# Over HTTPS only: a plain http:// remote would carry the token in clear.
[ "$protocol" = "https" ] || exit 0
[ -n "$host" ] || exit 0
[ -n "${TALE_GIT_CREDENTIALS:-}" ] || exit 0

# Hosts compare case-insensitively, as git and DNS do.
host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')

printf '%s\n' "$TALE_GIT_CREDENTIALS" | while read -r entry_host entry_user entry_token; do
  if [ -z "$entry_token" ] || [ "$entry_host" != "$host" ]; then
    continue
  fi
  printf 'username=%s\npassword=%s\n' "$entry_user" "$entry_token"
  break
done
exit 0
