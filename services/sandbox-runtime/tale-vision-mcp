#!/usr/bin/env node
// Vision MCP bridge (stdio). Gives a TEXT-ONLY managed agent the ability to read
// an image by delegating to a vision model THROUGH THE PLATFORM GATEWAY — so no
// raw model key ever enters the container. Auto-injected by the claude-code
// adapter only when the run is managed AND the agent's own model lacks vision
// (see services/platform/lib/agent-adapters/claude-code/adapter.ts).
//
//   vision_read({ image, prompt }) → POST <GATEWAY>/anthropic/v1/messages
//
// It calls the SAME gateway the agent uses, with the session virtual key (which
// the platform scopes to also allow the vision model). The bridge holds no
// provider key of its own.
//
// Dependency-free: a hand-rolled, newline-delimited JSON-RPC 2.0 loop (the MCP
// stdio transport). stdout is the protocol channel — only JSON-RPC lines go
// there; everything else goes to stderr. Mirrors tale-integrations-mcp.

'use strict';

const fs = require('node:fs');
const path = require('node:path');

const PROTOCOL_VERSION = '2024-11-05';
const SERVER_INFO = { name: 'tale-vision', version: '1.0.0' };

// The platform LLM gateway root (no trailing slash) + the session virtual key.
// Both are injected by the adapter; the VK is scoped to allow TALE_VISION_MODEL.
const GATEWAY_URL = (process.env.TALE_GATEWAY_URL || '').replace(/\/$/, '');
const GATEWAY_TOKEN = process.env.TALE_GATEWAY_TOKEN || '';
const VISION_MODEL = process.env.TALE_VISION_MODEL || '';
const ANTHROPIC_VERSION = '2023-06-01';

const REQUEST_TIMEOUT_MS = 60000;
const MAX_BUFFER_CHARS = 16 * 1024 * 1024;
const MAX_TOKENS = 1024;

const MEDIA_TYPES = {
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.webp': 'image/webp',
  '.gif': 'image/gif',
};

const DEFAULT_PROMPT =
  'Read this image and extract its text and any structured fields verbatim. ' +
  'Preserve numbers, dates, and identifiers exactly. Reply with the extracted content only.';

const TOOLS = [
  {
    name: 'vision_read',
    description:
      'Read an image (e.g. an invoice, receipt, or scanned document) and return ' +
      'its text/fields. Use this whenever you must understand the CONTENTS of an ' +
      'image file and your own model cannot see images. Pass the absolute path to ' +
      'the image and, optionally, a prompt describing what to extract. Trust the ' +
      'AMOUNTS it returns (they are self-checking on a real invoice: net + VAT == ' +
      'total) but NOT long identifiers (VAT/IBAN/invoice numbers) — verify those ' +
      'against your known reference.',
    inputSchema: {
      type: 'object',
      properties: {
        image: {
          type: 'string',
          description: 'Absolute path to the image file in the workspace.',
        },
        prompt: {
          type: 'string',
          description: 'What to extract (optional; defaults to a verbatim read).',
        },
      },
      required: ['image'],
    },
  },
];

function send(obj) {
  process.stdout.write(`${JSON.stringify(obj)}\n`);
}
function sendResult(id, result) {
  send({ jsonrpc: '2.0', id, result });
}
function sendError(id, code, message) {
  send({ jsonrpc: '2.0', id, error: { code, message } });
}
function toolText(text, isError) {
  return { content: [{ type: 'text', text }], isError: isError === true };
}

async function callVision(imagePath, prompt) {
  if (!GATEWAY_URL || !GATEWAY_TOKEN || !VISION_MODEL) {
    return { ok: false, text: 'vision bridge is not configured' };
  }
  let data;
  try {
    data = fs.readFileSync(imagePath);
  } catch (err) {
    return {
      ok: false,
      text: `could not read image at ${imagePath}: ${err && err.message ? err.message : String(err)}`,
    };
  }
  const mediaType = MEDIA_TYPES[path.extname(imagePath).toLowerCase()] || 'image/png';
  const body = {
    model: VISION_MODEL,
    max_tokens: MAX_TOKENS,
    messages: [
      {
        role: 'user',
        content: [
          {
            type: 'image',
            source: { type: 'base64', media_type: mediaType, data: data.toString('base64') },
          },
          { type: 'text', text: prompt || DEFAULT_PROMPT },
        ],
      },
    ],
  };
  try {
    const res = await fetch(`${GATEWAY_URL}/anthropic/v1/messages`, {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        authorization: `Bearer ${GATEWAY_TOKEN}`,
        'anthropic-version': ANTHROPIC_VERSION,
      },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
    });
    const raw = await res.text();
    if (!res.ok) {
      return { ok: false, text: `vision model call failed (status ${res.status}): ${raw.slice(0, 500)}` };
    }
    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch {
      return { ok: false, text: `vision bridge received a non-JSON response (status ${res.status})` };
    }
    // Anthropic Messages: { content: [{ type: 'text', text }, ...] }.
    const text = Array.isArray(parsed.content)
      ? parsed.content
          .filter((b) => b && b.type === 'text' && typeof b.text === 'string')
          .map((b) => b.text)
          .join('\n')
          .trim()
      : '';
    return { ok: true, text: text || '(vision model returned no text)' };
  } catch (err) {
    const reason =
      err && err.name === 'TimeoutError'
        ? `timed out after ${REQUEST_TIMEOUT_MS}ms`
        : err && err.message
          ? err.message
          : String(err);
    return { ok: false, text: `vision bridge request failed: ${reason}` };
  }
}

async function handleToolCall(name, args) {
  if (name === 'vision_read') {
    const image = typeof args.image === 'string' ? args.image : '';
    const prompt = typeof args.prompt === 'string' ? args.prompt : '';
    if (!image) {
      return toolText('"image" (an absolute path) is required.', true);
    }
    const res = await callVision(image, prompt);
    return toolText(res.text, !res.ok);
  }
  return toolText(`Unknown tool: ${name}`, true);
}

async function handleMessage(msg) {
  const isNotification = msg.id === undefined || msg.id === null;
  const { method, id } = msg;
  if (method === 'initialize') {
    const clientProtocol =
      msg.params && typeof msg.params.protocolVersion === 'string'
        ? msg.params.protocolVersion
        : PROTOCOL_VERSION;
    sendResult(id, {
      protocolVersion: clientProtocol,
      capabilities: { tools: {} },
      serverInfo: SERVER_INFO,
    });
    return;
  }
  if (method === 'tools/list') {
    sendResult(id, { tools: TOOLS });
    return;
  }
  if (method === 'tools/call') {
    const params = msg.params || {};
    const result = await handleToolCall(params.name, params.arguments || {});
    sendResult(id, result);
    return;
  }
  if (method === 'ping') {
    sendResult(id, {});
    return;
  }
  if (isNotification) return;
  sendError(id, -32601, `Method not found: ${method}`);
}

let buffer = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  buffer += chunk;
  if (buffer.length > MAX_BUFFER_CHARS && buffer.indexOf('\n') === -1) {
    process.stderr.write(
      `[tale-vision-mcp] input line exceeded ${MAX_BUFFER_CHARS} chars; dropping\n`,
    );
    buffer = '';
    return;
  }
  let nl;
  while ((nl = buffer.indexOf('\n')) !== -1) {
    const line = buffer.slice(0, nl).trim();
    buffer = buffer.slice(nl + 1);
    if (!line) continue;
    let msg;
    try {
      msg = JSON.parse(line);
    } catch (err) {
      process.stderr.write(`[tale-vision-mcp] bad JSON line: ${err}\n`);
      continue;
    }
    void handleMessage(msg).catch((err) => {
      process.stderr.write(`[tale-vision-mcp] handler error: ${err}\n`);
      if (msg && msg.id !== undefined && msg.id !== null) {
        sendError(
          msg.id,
          -32603,
          `Internal error: ${err && err.message ? err.message : String(err)}`,
        );
      }
    });
  }
});
process.stdin.on('end', () => process.exit(0));
