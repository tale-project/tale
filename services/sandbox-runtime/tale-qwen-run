#!/usr/bin/env python3
"""Tale sandbox wrapper for Qwen Code — stages per-exec config, then runs
`qwen --output-format stream-json` (NDJSON on stdout, passed through).

The platform adapter sends ONE JSON object on stdin:
  {"prompt": ..., "system_prompt"?: ..., "settings"?: {...}}
Qwen Code is a gemini-cli fork, so this is tale-gemini-run's shape with the
fork's deltas (verified against @qwen-code/qwen-code 0.23.3):

  - settings (auth-type pin, tools.exclude, mcpServers, maxSessionTurns) —
    staged to a private per-exec file and pointed at via
    QWEN_CODE_SYSTEM_SETTINGS_PATH (system scope wins over any repo
    .qwen/settings.json).
  - the system-prompt APPEND — staged as a per-exec context file under
    ~/.qwen/ and added to `context.fileName` alongside QWEN.md (the fork's
    context file name), so it is appended to the model context without
    replacing the CLI's core system prompt. The per-exec filename keeps
    concurrent execs sharing this HOME from reading each other's append.
  - no --skip-trust: the fork gates its approval mode on folder trust through
    the `security.folderTrust.enabled` setting, staged false here so a
    headless yolo run never downgrades to interactive approvals.
  - the headless stream is the Claude-style stream-json dialect
    (system/init, stream_event, assistant, result), parsed by the platform's
    claude-stream-json family; --include-partial-messages turns on the text
    deltas. Chat recording defaults on, which is what makes `--resume <id>`
    continue the recorded conversation.

The prompt itself rides the child's stdin — the CLI's native headless prompt
source — never argv (process lists leak argv, and a leading-dash prompt would
parse as a flag).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import uuid


def emit(event: dict) -> None:
    """One NDJSON line on stdout, in the CLI's own stream-json dialect so the
    platform parser handles wrapper failures like CLI failures."""
    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def fail(message: str, code: int = 1) -> int:
    emit(
        {
            "type": "result",
            "subtype": "error_during_execution",
            "is_error": True,
            "result": message,
        }
    )
    return code


def read_stdin_payload() -> dict | None:
    try:
        payload = json.loads(sys.stdin.read())
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(payload, dict):
        return None
    prompt = payload.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        return None
    return payload


def main() -> int:
    parser = argparse.ArgumentParser(description="Run Qwen Code for Tale sandbox")
    parser.add_argument("--workdir", default="/user/workspace")
    parser.add_argument("--model")
    parser.add_argument("--resume")
    parser.add_argument("--include-directories", action="append", default=[])
    args = parser.parse_args()

    payload = read_stdin_payload()
    if payload is None:
        return fail(
            'stdin must carry {"prompt": ..., "system_prompt"?: ..., "settings"?: ...} as JSON'
        )
    prompt = payload["prompt"]
    system_prompt = payload.get("system_prompt")
    if not isinstance(system_prompt, str) or not system_prompt.strip():
        system_prompt = None
    settings = payload.get("settings")
    if not isinstance(settings, dict):
        settings = {}

    home = os.environ.get("HOME") or os.path.expanduser("~")
    qwen_dir = os.path.join(home, ".qwen")
    context_path = None
    stage_dir = None
    try:
        if system_prompt is not None:
            # Per-exec context file: ~/.qwen/<name> is a global context path
            # for every name in context.fileName (gemini-cli's memoryDiscovery,
            # kept by the fork). QWEN.md stays first so the working repo's own
            # context files still load.
            os.makedirs(qwen_dir, exist_ok=True)
            context_name = f"tale-context-{uuid.uuid4().hex}.md"
            context_path = os.path.join(qwen_dir, context_name)
            with open(context_path, "w", encoding="utf-8") as f:
                f.write(system_prompt)
            settings.setdefault("context", {})
            if isinstance(settings["context"], dict):
                settings["context"]["fileName"] = ["QWEN.md", context_name]

        # Headless yolo must not depend on a trust prompt nobody can answer:
        # the fork reads `security.folderTrust.enabled` (a boolean) and, when
        # trust is on and the folder unknown, drops to interactive approvals.
        security = settings.setdefault("security", {})
        if isinstance(security, dict):
            trust = security.setdefault("folderTrust", {})
            if isinstance(trust, dict):
                trust.setdefault("enabled", False)

        stage_dir = tempfile.mkdtemp(prefix="tale-qwen-")
        settings_path = os.path.join(stage_dir, "settings.json")
        with open(settings_path, "w", encoding="utf-8") as f:
            json.dump(settings, f)

        env = dict(os.environ)
        env["QWEN_CODE_SYSTEM_SETTINGS_PATH"] = settings_path
        # The container is the safety boundary; the CLI's yolo notice on
        # stderr is noise in the run log.
        env.setdefault("QWEN_CODE_SUPPRESS_YOLO_WARNING", "1")

        cmd = [
            "qwen",
            "--output-format",
            "stream-json",
            "--include-partial-messages",
            "--approval-mode",
            "yolo",
        ]
        if args.model:
            cmd += ["--model", args.model]
        if args.resume:
            cmd += ["--resume", args.resume]
        for directory in args.include_directories:
            cmd += ["--include-directories", directory]

        proc = subprocess.Popen(
            # nosemgrep: tools.opengrep.rules.python.lang.security.audit.dangerous-subprocess-use-tainted-env-args.dangerous-subprocess-use-tainted-env-args -- fixed qwen argv plus adapter-provided flags, list-form exec (no shell); launching the agent CLI inside the sandbox is this runner's purpose, same trust model as the sibling tale-*-run launchers
            cmd,
            cwd=args.workdir,
            env=env,
            stdin=subprocess.PIPE,
            # stdout/stderr inherit: the CLI's stream-json goes straight to the
            # platform's stdout reader; human-oriented noise stays on stderr.
        )
        try:
            proc.stdin.write(prompt.encode("utf-8"))
            proc.stdin.close()
        except BrokenPipeError:
            print("[tale-qwen-run] qwen exited before reading stdin", file=sys.stderr)
        return proc.wait()
    except FileNotFoundError as exc:
        return fail(f"qwen-code not installed or file missing: {exc}")
    except Exception as exc:  # noqa: BLE001 — surface anything as a run error
        return fail(f"wrapper failure: {exc}")
    finally:
        if context_path is not None:
            try:
                os.unlink(context_path)
            except OSError as exc:
                print(f"[tale-qwen-run] context cleanup failed: {exc}", file=sys.stderr)
        if stage_dir is not None:
            shutil.rmtree(stage_dir, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
