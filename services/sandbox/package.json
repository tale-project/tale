{
  "name": "@tale/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Tale sandbox spawner — thin stateless docker-run service for artifact_run",
  "type": "module",
  "scripts": {
    "dev": "rm -f /tmp/tale-sandbox/sessions/.spawner.lock && SANDBOX_HOST_SESSION_ROOT=/tmp/tale-sandbox/sessions SANDBOX_SKIP_IMAGE_WARMUP=1 bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
