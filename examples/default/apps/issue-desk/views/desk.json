{
  "id": "desk",
  "title": "Issue resolution desk",
  "description": "Pull GitHub issues, turn them into tasks, and let the agent team resolve them — watch each run execute live.",
  "tabs": [
    {
      "id": "overview",
      "label": "Overview",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "WorkflowMap",
            "props": {
              "id": "workflow",
              "title": "How it works",
              "workflowSlug": "issue-desk/desk-process"
            }
          },
          {
            "type": "AgentList",
            "props": {
              "id": "agents",
              "title": "Agents",
              "roles": {
                "implementer": "issue-desk/desk-implementer",
                "reviewer": "issue-desk/desk-reviewer"
              }
            }
          }
        ]
      }
    },
    {
      "id": "issues",
      "label": "Issues",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "IssueList",
            "props": {
              "id": "issues",
              "title": "GitHub issues",
              "owner": "tale-project",
              "repo": "tale",
              "state": "open",
              "taskTemplateKey": "issueDesk.taskTemplate"
            }
          }
        ]
      }
    },
    {
      "id": "tasks",
      "label": "Tasks",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "Collection",
            "props": {
              "id": "tasks",
              "title": "Tasks",
              "query": {
                "path": "tasks/queries:listTasksByOrg",
                "args": {
                  "organizationId": "$orgId",
                  "externalSystem": "github"
                }
              },
              "columns": ["title", "status"],
              "actions": [
                {
                  "label": "Start",
                  "path": "tasks/mutations:updateTaskStatus",
                  "mode": "mutation",
                  "when": "status == backlog || status == todo",
                  "args": { "taskId": "$selected._id", "status": "in_progress" }
                },
                {
                  "label": "Mark done",
                  "path": "tasks/mutations:updateTaskStatus",
                  "mode": "mutation",
                  "when": "status != done",
                  "args": { "taskId": "$selected._id", "status": "done" }
                },
                {
                  "label": "Assign implementer",
                  "path": "tasks/mutations:assignTask",
                  "mode": "mutation",
                  "args": {
                    "taskId": "$selected._id",
                    "assigneeType": "agent",
                    "assigneeId": "issue-desk/desk-implementer"
                  }
                },
                {
                  "label": "Triage & run",
                  "variant": "primary",
                  "path": "workflow_executions/actions:startWorkflowFromFile",
                  "mode": "action",
                  "args": {
                    "organizationId": "$orgId",
                    "workflowSlug": "issue-desk/desk-process",
                    "triggeredBy": "user",
                    "input": { "task": "$selected" }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "runs",
      "label": "Runs",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "RunList",
            "props": {
              "id": "runs",
              "title": "Recent runs",
              "workflowSlug": "issue-desk/desk-process"
            }
          }
        ]
      }
    }
  ]
}
