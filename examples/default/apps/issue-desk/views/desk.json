{
  "id": "desk",
  "title": "Issue resolution desk",
  "description": "Pull GitHub issues, turn them into tasks, and let the agent team resolve them.",
  "tabs": [
    {
      "id": "issues",
      "label": "Issues",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "ExternalList",
            "props": {
              "id": "issues",
              "title": "GitHub issues",
              "source": {
                "path": "integrations/public_actions:listGitHubIssues",
                "args": {
                  "organizationId": "$orgId",
                  "owner": "tale-project",
                  "repo": "tale",
                  "state": "open"
                }
              },
              "itemsKey": "data",
              "rowWhen": "!pull_request",
              "columns": ["number", "title", "state"],
              "perPage": 30,
              "excludeBy": {
                "query": {
                  "path": "tasks/queries:listTasksByOrg",
                  "args": {
                    "organizationId": "$orgId",
                    "externalSystem": "github",
                    "limit": 500
                  }
                },
                "refField": "externalId",
                "rowKeyTemplate": "tale-project/tale#{number}"
              },
              "actions": [
                {
                  "labelKey": "issues.createTask",
                  "doneLabelKey": "list.created",
                  "variant": "primary",
                  "path": "tasks/public_actions:createTaskFromExternalIssue",
                  "mode": "action",
                  "args": {
                    "organizationId": "$orgId",
                    "externalSystem": "github",
                    "externalId": "$tpl:tale-project/tale#{number}",
                    "title": "$selected.title",
                    "externalUrl": "$selected.html_url",
                    "description": "$label:issueDesk.taskTemplate",
                    "runWorkflowSlug": "issue-desk/desk-process"
                  },
                  "onSuccess": {
                    "kind": "openDetail",
                    "subjectType": "task",
                    "id": "$result.taskId"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "tasks",
      "label": "Tasks",
      "data": {
        "root": { "props": {} },
        "zones": {},
        "content": [
          {
            "type": "Collection",
            "props": {
              "id": "tasks",
              "title": "Tasks",
              "query": {
                "path": "tasks/queries:listTasksByOrg",
                "args": {
                  "organizationId": "$orgId",
                  "externalSystem": "github"
                }
              },
              "columns": ["title", "status"],
              "subjectType": "task",
              "actions": [
                {
                  "label": "Start",
                  "path": "tasks/mutations:updateTaskStatus",
                  "mode": "mutation",
                  "when": "status == backlog || status == todo",
                  "args": { "taskId": "$selected._id", "status": "in_progress" }
                },
                {
                  "label": "Mark done",
                  "path": "tasks/mutations:updateTaskStatus",
                  "mode": "mutation",
                  "when": "status != done",
                  "args": { "taskId": "$selected._id", "status": "done" }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
