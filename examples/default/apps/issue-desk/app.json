{
  "name": "Issue resolution desk",
  "description": "A config-driven, repo-agnostic issue-resolution desk. GitHub issues (bound to tasks by the github sync) flow through a fixed process — an implementer agent resolves the issue in the platform sandbox, tests it, and opens a PR; a reviewer agent re-tests and comments; a toolless LLM judge decides merge-readiness, looping back to the implementer until approved, then a human merges. The whole app is data — a workflow + agents + views + a localized catalog — composed on the platform skeleton with no per-vertical system code.",
  "icon": "ticket",
  "messageNamespace": "issueDesk",
  "workflows": ["issue-desk/desk-process"],
  "agents": ["desk-implementer", "desk-reviewer"],
  "roles": {
    "implementer": "issue-desk/desk-implementer",
    "reviewer": "issue-desk/desk-reviewer"
  },
  "capabilities": {
    "workflows": ["issue-desk/desk-process"],
    "roles": ["issue-desk/desk-implementer", "issue-desk/desk-reviewer"],
    "functions": [
      { "path": "tasks/queries:listTasksByOrg", "mode": "query" },
      {
        "path": "approvals/queries:listActiveApprovalsByOrganization",
        "mode": "query"
      },
      { "path": "workflow_executions/queries:listExecutions", "mode": "query" },
      { "path": "agents/file_actions:listAppAgents", "mode": "action" },
      { "path": "agents/file_actions:readAgent", "mode": "action" },
      { "path": "agents/file_actions:saveAgent", "mode": "action" },
      { "path": "agents/agent_env:listAgentEnv", "mode": "query" },
      { "path": "agents/agent_env_actions:setAgentEnvVar", "mode": "action" },
      { "path": "agents/agent_env:deleteAgentEnvVar", "mode": "mutation" },
      { "path": "workflows/file_actions:readWorkflow", "mode": "action" },
      { "path": "tasks/mutations:assignTask", "mode": "mutation" },
      { "path": "tasks/mutations:updateTaskStatus", "mode": "mutation" },
      {
        "path": "integrations/public_actions:listGitHubIssues",
        "mode": "action"
      },
      {
        "path": "tasks/public_actions:createTaskFromExternalIssue",
        "mode": "action"
      },
      {
        "path": "workflow_executions/actions:startWorkflowFromFile",
        "mode": "action"
      }
    ]
  },
  "requires": {
    "integrations": ["github"]
  }
}
