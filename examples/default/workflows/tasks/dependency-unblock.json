{
  "name": "Dependency unblock",
  "description": "Keeps blocked work moving: when a task closes, every task it was blocking gets a comment with its remaining blocker count. Fully unblocked tasks restart automatically — agent-assigned ones (waiting in To do/Backlog) are re-triggered through the standard execution loop under the agent's own guardrails; human-assigned ones get an inbox notification. The automation's own comments are inert (workflow actor), so unblock chains only continue through real work.",
  "version": "1.0.0",
  "metadata": {
    "pack": "task-ops",
    "autoInstall": true
  },
  "triggers": {
    "events": [
      {
        "eventType": "task.status_changed",
        "eventFilter": { "toStatus": "done" }
      },
      {
        "eventType": "task.status_changed",
        "eventFilter": { "toStatus": "cancelled" }
      }
    ]
  },
  "config": {
    "timeout": 600000,
    "variables": {
      "workflowId": "tasks_dependency_unblock"
    }
  },
  "steps": [
    {
      "stepSlug": "start",
      "name": "start",
      "stepType": "start",
      "config": {},
      "nextSteps": {
        "success": "deps"
      }
    },
    {
      "stepSlug": "deps",
      "name": "List dependent tasks",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "list_dependents",
          "taskId": "{{input.task._id}}"
        }
      },
      "nextSteps": {
        "success": "has_deps"
      }
    },
    {
      "stepSlug": "has_deps",
      "name": "Anything blocked by this task?",
      "stepType": "condition",
      "config": {
        "expression": "(steps.deps.output.data.tasks | length) > 0",
        "description": "The loop step throws on an empty items array — route the empty case straight to done."
      },
      "nextSteps": {
        "true": "loop_deps",
        "false": "done"
      }
    },
    {
      "stepSlug": "loop_deps",
      "name": "Loop over dependents",
      "stepType": "loop",
      "config": {
        "continueOnError": true,
        "itemVariable": "dependent",
        "items": "{{steps.deps.output.data.tasks}}"
      },
      "nextSteps": {
        "loop": "blocker_comment",
        "done": "done"
      }
    },
    {
      "stepSlug": "blocker_comment",
      "name": "Note the cleared blocker",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "comment",
          "taskId": "{{loop.item.taskId}}",
          "body": "[automated] 🔓 Blocker \"{{input.task.title}}\" closed — {{loop.item.openBlockerCount}} blocker(s) remaining."
        }
      },
      "nextSteps": {
        "success": "fully_unblocked"
      }
    },
    {
      "stepSlug": "fully_unblocked",
      "name": "Fully unblocked?",
      "stepType": "condition",
      "config": {
        "expression": "loop.item.openBlockerCount == 0"
      },
      "nextSteps": {
        "true": "agent_ready",
        "false": "loop_deps"
      }
    },
    {
      "stepSlug": "agent_ready",
      "name": "Agent-assigned and waiting?",
      "stepType": "condition",
      "config": {
        "expression": "loop.item.assigneeType == 'agent' && (loop.item.status == 'todo' || loop.item.status == 'backlog') && loop.item.agentRunsPaused == false",
        "description": "Only restart parked agent work; in-flight or breaker-paused tasks are left alone."
      },
      "nextSteps": {
        "true": "retrigger",
        "false": "human_assigned"
      }
    },
    {
      "stepSlug": "retrigger",
      "name": "Re-trigger the assigned agent",
      "stepType": "action",
      "config": {
        "type": "task",
        "parameters": {
          "operation": "assign",
          "taskId": "{{loop.item.taskId}}",
          "assigneeType": "agent",
          "assigneeId": "{{loop.item.assigneeId}}"
        }
      },
      "nextSteps": {
        "success": "loop_deps"
      }
    },
    {
      "stepSlug": "human_assigned",
      "name": "Human assignee?",
      "stepType": "condition",
      "config": {
        "expression": "loop.item.assigneeType == 'user'"
      },
      "nextSteps": {
        "true": "notify_assignee",
        "false": "loop_deps"
      }
    },
    {
      "stepSlug": "notify_assignee",
      "name": "Notify the human assignee",
      "stepType": "action",
      "config": {
        "type": "notification",
        "parameters": {
          "operation": "notify_users",
          "audience": "task_assignee",
          "type": "task_status_changed",
          "titleKey": "taskUnblocked",
          "bodyKey": "taskUnblockedBody",
          "params": { "title": "{{loop.item.title}}" },
          "taskId": "{{loop.item.taskId}}"
        }
      },
      "nextSteps": {
        "success": "loop_deps"
      }
    },
    {
      "stepSlug": "done",
      "name": "Done",
      "stepType": "output",
      "config": {},
      "nextSteps": {}
    }
  ]
}
