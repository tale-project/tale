# ============================================================================
# Tale Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Generate secrets with: openssl rand -base64 32 (for base64) or openssl rand -hex 32 (for hex)

# ============================================================================
# REQUIRED: Domain Configuration
# ============================================================================
# HOST: Hostname only, without protocol (used for Docker networking, emails)
# SITE_URL: Full canonical URL with protocol (used for external links, auth callbacks)
#   Must match the URL users access in their browser, including non-standard ports.
#
# Examples:
#   Production:
#     HOST=demo.tale.dev
#     SITE_URL=https://demo.tale.dev
#   Custom port:
#     HOST=example.com
#     SITE_URL=https://example.com:8443
#   Development:
#     HOST=localhost
#     SITE_URL=https://localhost
# Authenticator entry names: the client, the product and the environment.
# TOTP_CLIENT_NAME=Acme with TOTP_ENVIRONMENT=te names entries
# "Acme Tale Platform TE" and backup-code downloads
# acme-tale-platform-te-backup-codes.txt. pr or an unset environment adds none;
# an unset client (or Tale) gives "Tale Platform".
# Client: 1–40 letters, digits, spaces or & ' . + -. Environment: 1–32 letters,
# digits, _ or -, uppercased. Read by platform and backend-api/all; applies to
# newly generated QR codes, setup links and backup-code downloads. Entries
# already saved in an authenticator app keep their current names.
# TOTP_CLIENT_NAME=Acme
# TOTP_ENVIRONMENT=te
HOST=localhost
SITE_URL=https://localhost
# Optional: serve the SAME deployment on more than one domain.
# Comma- or whitespace-separated list of extra origins (scheme + host + optional
# port, no path). Each becomes a full entry point: the proxy serves it and
# obtains a certificate for it, sign-in works on it, and every link the app
# builds for a visitor keeps them on the domain they arrived on.
#
#   ADDITIONAL_SITE_URLS=https://tale.partner.example,https://app.example.org
#
# SITE_URL stays the CANONICAL origin and is what one-per-deployment values
# still use: e-mail links, the SAML SP entityID, SCIM meta.location, passkeys
# (WebAuthn binds a credential to a single domain — one registered on the
# canonical host is not offered on the others), and the default
# OBJECT_STORE_PUBLIC_ENDPOINT.
#
# For each extra domain: point its DNS at this host, and register that domain's
# own callback URL with any OAuth/OIDC/SAML provider you use — Settings shows
# the full per-domain list. Leave unset for a single-domain deployment.
# ADDITIONAL_SITE_URLS=
# Optional: Base path for subpath deployments behind a reverse proxy
# Example: BASE_PATH=/app for accessing via https://example.com/app/
# Leave empty or unset for root deployments
# BASE_PATH=

# ============================================================================
# OPTIONAL: TLS/SSL Configuration
# ============================================================================
# TLS_MODE: Choose how SSL certificates are handled
#   - "selfsigned" (default): Self-signed certificates for development
#     Browser will show certificate warning (expected behavior)
#     To trust certs on host: docker exec tale-proxy caddy trust
#   - "letsencrypt": Free trusted certificates from Let's Encrypt
#     For production. Requires valid public domain and ports 80/443 accessible.
#   - "external": TLS handled by an external reverse proxy
#     Caddy listens on HTTP only. Set SITE_URL to your public URL.
#
# TLS_EMAIL: Email for Let's Encrypt notifications (optional but recommended)
#
# TRUSTED_PROXIES (external mode only): the addresses the TLS-terminating proxy
#   connects from, as whitespace-separated CIDR ranges, or "private_ranges"
#   (the default: every private and loopback range). Caddy accepts that
#   proxy's X-Forwarded-Proto and X-Forwarded-For from these peers only, so
#   the proxy must send the browser's scheme and keep the original Host.
#   Port 80 is published: let only that proxy reach it.
#   TRUSTED_PROXIES=10.20.0.0/16
#
# Development (default):
TLS_MODE=selfsigned
#
# Production example:
# TLS_MODE=letsencrypt
# TLS_EMAIL=admin@yourdomain.com

# ============================================================================
# REQUIRED: Security Secrets
# ============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=SB53GlYc8RaMU+stOmOWXtRU8JEyOQItpBNK5b03Aco=
# 32-byte hex key. Direct AES-256 key for OAuth/connector credentials in DB
# (lib/crypto/get_secret_key.ts), and HKDF input for the guardrails secret-box
# (lib/secret_box.ts). Auto-generated by `tale init`. Rotation invalidates
# all DB-stored ciphertexts — operators must re-enter affected secrets.
# Generate manually with: openssl rand -hex 32
ENCRYPTION_SECRET_HEX=3143246f44def075d40141fb849faffcf409fbbeb7a282a3a7c2f4396f2ed232

# ============================================================================
# REQUIRED: Database Configuration
# ============================================================================
# Database password for self-hosted PostgreSQL (required, auto-used by all services)
# Services will fail to start if this is not set. Change this password in production.
DB_PASSWORD=tale_password_change_me

# The application backend (the `backend-api` and `backend-worker` services)
# stores its state in the `tale_app` database on the `db` service. Compose
# builds DATABASE_URL from DB_PASSWORD, so a bundled stack configures nothing.
# Optional override for the application database name:
# APP_DB_NAME=tale_app
#
# Set DATABASE_URL to run against a Postgres of your own instead. It needs no
# extensions and no superuser — a database and a role that may create schemas.
# DATABASE_URL=postgresql://user:password@host:5432/tale_app?sslmode=require
#
# Connections ONE backend process opens to the application database. It costs
# this twice per replica (app pool plus job queue), with a temporary peak of
# three times this during sandbox lifecycle operations. Count that peak
# against a managed Postgres's max_connections.
# DATABASE_POOL_MAX=10
#
# Jobs ONE backend-worker process runs at once per job queue — indexing,
# crawls, automations and agent turns each get this many (1-64); agent turn
# starts get at least 8 and the drive windows of live agent turns at least 16
# per queue regardless. Every running indexing job commits through the
# knowledge pool below, so raise KNOWLEDGE_DB_POOL_MAX alongside this.
# WORKER_CONCURRENCY=5
# Agent turn starts, and drive windows of live agent turns, ONE backend-worker
# runs at once per lane (1-256). A worker keeps about 2.5x AGENT_DRIVE_SLOTS
# live turns per lane drained; raise it or add workers for more.
# AGENT_START_SLOTS=8
# AGENT_DRIVE_SLOTS=16
# Automation steps ONE organization runs at once across every backend-worker
# (0-256; 0 turns the limit off), so one organization's burst of runs cannot
# take every worker's step slots while other organizations' runs wait. One
# worker at the default WORKER_CONCURRENCY never reaches it; a deployment
# serving one organization with more step slots than this raises it or sets 0.
# AUTOMATION_ORG_CONCURRENCY=8
# How long a stopping backend process waits for its jobs, in milliseconds
# (1000-600000). Unset: 15000 for backend-api, 90000 for backend-worker. A
# stopping worker hands its automation runs to another one first; a step still
# working 20 seconds in (or a third of a shorter budget) is cut and runs again,
# except a write to an outside service, whose run then waits for a person.
# Keep the container's stop_grace_period at least 15 seconds above it
# (compose.yml: 30s api, 120s worker; tale deploy derives both from this value).
# SHUTDOWN_DRAIN_MS=90000

# Knowledge datastore (ParadeDB: pg_search + pgvector). Holds the RAG/crawler
# corpus (tale_knowledge DB, private_knowledge + public_web schemas). Split from
# the application DB so it can be relocated/replaced independently for data
# residency. The backend (api + worker) connects here via postgres.js.
# If not set, defaults to postgresql://tale:${DB_PASSWORD}@knowledge-db:5432/tale_knowledge
# An external corpus database must already have pgvector installed (Tale
# creates its own schemas and tables, never extensions); ParadeDB's pg_search
# is optional and search degrades to vector-only without it.
# KNOWLEDGE_DATABASE_URL=postgresql://user:password@host:port/tale_knowledge
KNOWLEDGE_DB_NAME=tale_knowledge
#
# Connections ONE backend process opens to the knowledge corpus. An indexing
# job holds one while it commits a slice of chunks, so keep this at or above
# WORKER_CONCURRENCY — and count it per replica against the corpus database's
# max_connections, like DATABASE_POOL_MAX.
# KNOWLEDGE_DB_POOL_MAX=10

# A PEM bundle trusted for EVERY Postgres connection — the application
# database, the knowledge corpus, and the databases organizations bring
# themselves. Needed when a URL asks for sslmode=verify-ca or verify-full
# against a provider whose root Node does not ship (Amazon RDS is the common
# one). Concatenate several roots into one file if they differ.
# POSTGRES_CA_FILE=/run/secrets/postgres-ca.pem

# NOTE: neither database may sit behind a TRANSACTION-mode connection pooler.
# The job queue holds LISTEN connections, the migrator holds a session-scoped
# advisory lock, and queries use prepared statements. PgBouncer in session mode
# is fine; transaction mode, Supabase's pooler port and a pinning RDS Proxy are
# not — point Tale at the database's own port.
# At boot the backend verifies the corpus's BM25 search indexes (pg_search
# `pdb.verify_index`) and rebuilds a corrupted one itself — inline when the
# index is at most this many bytes (default 1 GiB), otherwise in a background
# job while writes to that corpus are refused. `KNOWLEDGE_INDEX_REPAIR_DISABLED=1`
# switches the check off (a corrupted index then PANICs the database on writes).
# KNOWLEDGE_INDEX_REPAIR_INLINE_MAX_BYTES=1073741824
# KNOWLEDGE_INDEX_REPAIR_DISABLED=
# Largest document (PDF, DOCX, XLSX, PPTX, ODT — in bytes) the website crawler
# downloads and extracts (default 100 MiB); a larger one is recorded on its
# page as too large to fetch. Each fetch is held in memory while its text is
# extracted, up to five sites at once. Below 1 MiB, or not a whole number,
# falls back to the default.
# KNOWLEDGE_CRAWL_DOCUMENT_MAX_BYTES=104857600

# Website crawl targets are refused when they name a loopback, link-local,
# private-network (RFC 1918, CGNAT, ULA, *.internal, *.local, single-label)
# or cloud-metadata host — the crawler dials them from inside the deployment's
# network. Set to 1 on a deployment that crawls its own intranet; the cloud
# metadata endpoints stay refused regardless. The name's DNS answer is held
# to the same rule — at registration and again before every dial, with the
# checked address pinned for the connection — so a public-looking host whose
# record points inside the network is refused too.
# TALE_ALLOW_PRIVATE_CRAWL_HOSTS=

# ============================================================================
# REQUIRED: Instance secret
# ============================================================================
# The deployment marker the app-side key derivations hang off: the WebDAV
# app-password HMAC key (sha256("<INSTANCE_SECRET>:webdav-hmac:v1"), unless
# WEBDAV_APP_PASSWORD_HMAC_KEY is set explicitly), and with it the in-sandbox
# host-call and stage tokens. Auto-generated by `tale init`; keep it STABLE
# across deploys — rotating it stops every issued WebDAV app password from
# verifying. Generate manually with: openssl rand -hex 32
INSTANCE_SECRET=0516d5cddc8b9bbc01238b8696f13c711983f45f6dc4dbf9dc66ba42fc16f504

# ============================================================================
# Audit Log Privacy (security / compliance)
# ============================================================================
# Pepper for the HMAC-SHA256 pseudonymisation of the email + IP a failed
# sign-in writes into the audit log (retained 180–3650 days, longer than
# the login attempt itself). Set (>= 16 chars), new rows carry
# actor_email_hash / ip_address_hash; unset, they carry the plaintext email + IP
# and the backend logs a [SECURITY] warning at the first write. Auto-generated
# by `tale init`; keep it STABLE — rotating it breaks correlation across the
# rotation boundary (older rows age out under retention). An admin reproduces
# the hash for a known email with HMAC-SHA256(pepper, lowercased email).
# Generate manually with: openssl rand -hex 32
TALE_AUDIT_PEPPER=9c1e5b7d3a2f8064e1c7a9d5b3f2e8c604a7d1b9e5c3f8a2d6b0e4c7a1f9d3b5

# ============================================================================
# OPTIONAL: Error Tracking (Sentry)
# ============================================================================
# Get your DSN from https://sentry.io or use a self-hosted alternative
# (GlitchTip, Bugsink) with a compatible DSN format.
# If not set, error tracking is disabled.
# SENTRY_DSN=https://your-key@your-sentry-host/project-id
# Shared browser, backend and sandbox reporting label. Managed deployments
# default to their retained name; declare SENTRY_ENVIRONMENT to use another label.
# SENTRY_ENVIRONMENT=example-pr
# Optional backend HTTP/worker spans; 0 (default) disables them, 1 samples all.
# Requires SENTRY_DSN and a destination that accepts Sentry transactions.
# Independent of the browser's SENTRY_TRACES_SAMPLE_RATE. No outgoing trace headers.
# BACKEND_SENTRY_TRACES_SAMPLE_RATE=0.05

# ============================================================================
# OPTIONAL: Contact-support link
# ============================================================================
# Where the "contact support" link on the app's error screens points. An
# absolute http:// or https:// URL; any other value is ignored with a warning
# in the platform log. Where the error screen knows the organization, the
# link adds `organizationId=<id>` to the query string, replacing one the URL
# already carries. Read by the platform (web) service.
# Default: https://tale.dev/contact
# TALE_CONTACT_SUPPORT_URL=https://support.example.com/tale

# ============================================================================
# OPTIONAL: Monitoring / Metrics (Prometheus)
# ============================================================================
# Each service exposes /metrics (Prometheus text format) on the internal Docker
# network. Set a bearer token to enable external access via Caddy:
#
#   METRICS_BEARER_TOKEN=your-secret-token-here
#
# Endpoints (requires valid bearer token):
#   https://<host>/metrics/platform   (the web tier)
#   https://<host>/metrics/backend    (the application backend: api + worker)
#   https://<host>/metrics/sla-rules
#
# Prometheus scrape config example:
#   scrape_configs:
#     - job_name: tale-platform
#       scheme: https
#       metrics_path: /metrics/platform
#       authorization:
#         credentials: your-secret-token-here
#       static_configs:
#         - targets: ['your-tale-host.com']
#
# METRICS_BEARER_TOKEN=

# ============================================================================
# REQUIRED: Sandbox spawner authentication
# ============================================================================
# Shared HMAC secret between the backend and the sandbox spawner: the backend
# signs every spawner request with it and the spawner rejects unsigned or
# wrong-signed requests. The spawner REFUSES TO START without it — it holds the
# host docker socket and sits on the sandbox network every session container
# shares, so there is no unsigned mode.
#
# Auto-generated by `tale init` / `tale deploy` and by `bun run dev`; a compose
# stack you wrote yourself sets it here before the first boot. Rotate by
# setting a new value and restarting the backend, platform and sandbox
# services together (they must agree).
# Generate manually with: openssl rand -hex 32
# SANDBOX_TOKEN=

# ============================================================================
# OPTIONAL: Sandbox agent turn orphan window
# ============================================================================
# How long (ms) an in-sandbox coding-agent turn (Claude Code / OpenCode /
# Codex) may sit with nobody draining its output before the sandbox daemon
# reaps it. A SLIDING window, re-armed on every drain attach — not an absolute
# cap on the turn. Raise it when long agent turns on a slow host are reaped as
# orphans; defaults to 30 minutes.
# TALE_EXTERNAL_TURN_DEADLINE_MS=1800000

# Optional inner Docker address pool on Docker or Kubernetes (DinD agents only).
# Unset selects a private /16 from observed routes, interface addresses, DNS and
# service endpoints known at startup. For cluster CIDRs invisible in a Pod, choose
# a canonical RFC1918 /16 outside all Pod, Service, VPC and outer Docker networks.
# Known overlaps are rejected even with an override. Recreate sessions to apply.
# SANDBOX_DIND_INNER_POOL=10.240.0.0/16

# ============================================================================
# REQUIRED: Sandbox LLM Gateway management auth
# ============================================================================
# The LLM gateway is the only path from an in-sandbox coding agent (Claude Code
# / OpenCode) to an LLM. The platform provisions it + mints per-session virtual
# keys over the management API; inference is gated so the sandbox can only call
# the model with a minted key (client.enforce_auth_on_inference, pushed
# automatically — no env needed for that part).
#
# The admin password locks the management API (/api/*) with HTTP Basic auth. It
# is REQUIRED: the gateway is dual-homed onto the sandbox network with one port
# serving both inference and /api/*, so the backend refuses every management
# call — and therefore every sandbox agent session — until it is set; the
# management plane is never left anonymous. The username defaults to `admin`.
#
# The gateway reads the same variable: its entrypoint makes it the setup token
# a gateway without an admin account demands before it creates one, which is
# how the backend claims a fresh gateway. Give the gateway container this
# variable as well as the backend.
#
# Auto-generated by `tale init` / `tale deploy` and by `bun run dev`; set it
# here only to pin your own value. It must stay STABLE across deploys: the
# gateway stores its hash in its own volume, so a changed password locks the
# platform out. Keep the matching secret or use the gateway's supported
# credential recovery or rotation procedure; do not wipe the volume as a fix,
# since it also holds the gateway's provider keys, session keys with their
# spend, and its request log. (The pre-rename LLM_GATEWAY_* names are still
# read as a fallback for one release.)
#
#   SANDBOX_LLM_GATEWAY_ADMIN_USERNAME=admin
#   SANDBOX_LLM_GATEWAY_ADMIN_PASSWORD=change-me-to-a-strong-secret
#
# SANDBOX_LLM_GATEWAY_URL overrides where the platform reaches the management API;
# default http://sandbox-llm-gateway:8080 works in-compose. The host bun-dev path
# sets it to the loopback publish (see compose.sandbox-llm-gateway.dev.yml +
# services/platform/.env.local).
# SANDBOX_LLM_GATEWAY_ADMIN_USERNAME=admin
# SANDBOX_LLM_GATEWAY_ADMIN_PASSWORD=

# ============================================================================
# OPTIONAL: Sandbox LLM gateway stream idle timeout
# ============================================================================
# How long (in seconds) the LLM gateway waits for the next byte from a silent
# upstream model before it aborts the stream; defaults to 600 (10 minutes). A
# slow local model can stay silent for minutes while it processes a long
# prompt. The backend reads this value and configures the gateway with it.
# Claude Code and Codex agent turns wait at least as long before they give up
# on a silent stream and send the request again, so raising it for slow local
# models is safe: the agent does not send the same turn twice. A stalled
# upstream then also holds a turn longer before the gateway aborts it.
# A value above 600 also raises the gateway's per-request timeout to match.
# That timeout bounds a whole non-streaming answer, which an agent falls back
# to when a stream breaks, so a long prefill is not cut at 600 s there either.
# Recreate the backend services after changing it.
# SANDBOX_LLM_GATEWAY_STREAM_IDLE_TIMEOUT_SECONDS=600

# ============================================================================
# OPTIONAL: Sandbox LLM gateway request workers per provider
# ============================================================================
# How many requests the LLM gateway sends at once to one provider. The gateway
# keeps that many request workers for every provider it holds, from the moment
# it loads the provider and whether or not anything calls it, so the gateway's
# memory grows with these values. A request that finds every worker busy waits
# in a queue 16 times as long. A whole number from 1 to 5000: a larger one is
# held to 5000 and any other value falls back to the default, each with a
# warning in the backend log.
#
# PROVIDER_CONCURRENCY sizes a built-in provider (OpenAI, Anthropic,
# OpenRouter, ...), one shared by every organization. CUSTOM_PROVIDER_CONCURRENCY
# sizes a custom provider, which the backend sets up once per organization and
# model, so their number grows with organizations times custom models. A
# built-in provider's Anthropic lane for agent runtimes (Claude Code through
# OpenRouter's Anthropic endpoint) gets an organization-and-model provider of
# its own and is sized by CUSTOM_PROVIDER_CONCURRENCY too. Raise
# the custom value when an organization's API keys send more simultaneous
# requests to one custom model. The backend reads both and configures the
# gateway; a changed value reaches each provider at the next sandbox session
# or model-endpoint request of an organization that uses it, and a lowered one
# reaches every other provider the gateway holds two to five minutes after the
# backend's first sandbox session or model-endpoint request. Recreate the
# backend services after changing them.
# SANDBOX_LLM_GATEWAY_PROVIDER_CONCURRENCY=512
# SANDBOX_LLM_GATEWAY_CUSTOM_PROVIDER_CONCURRENCY=64

# ============================================================================
# OPTIONAL: Sandbox spawner URL
# ============================================================================
# Where the backend (api + worker) reaches the sandbox spawner. session_client.ts
# defaults to http://localhost:8003 for host bun-dev. A container worker without
# this hits that default and every agent run dies with "fetch failed". Compose
# and the platform entrypoint default it to the in-compose alias; set this only
# to override.
# SANDBOX_URL=http://sandbox:8003

# ============================================================================
# OPTIONAL: Sandbox devices
# ============================================================================
# Organizations can run their sandboxes on their own machines (Settings →
# Sandboxes → Devices → Add device, which hands out a one-line
# `tale sandbox connect` command). A device dials out to <SITE_URL>/sandbox/tunnel,
# which the proxy forwards to the spawner's device hub on this port; nothing
# else of the spawner is published. Set 0 to turn devices off.
# SANDBOX_HUB_PORT=8004
# Where devices dial, when the proxy in front of Tale does not publish the hub
# at <SITE_URL>/sandbox/tunnel (a separate host or path). Read by the backend.
# SANDBOX_DEVICE_TUNNEL_URL=wss://tale.example.com/sandbox/tunnel
# Where devices pull release images from. Defaults to GHCR_REGISTRY, else the
# public ghcr.io/tale-project/tale. Read by the backend.
# SANDBOX_DEVICE_IMAGE_REGISTRY=
# The hub the proxy forwards /sandbox/tunnel to, when the spawner is not the
# `sandbox` service. Read by the proxy.
# SANDBOX_HUB_UPSTREAM=sandbox:8004

# ============================================================================
# OPTIONAL: Application backend URL for the web tier
# ============================================================================
# Where the platform (web) container reaches the application backend: the
# public /status page probes it and the web server asks it for the answers
# only a database can give. Compose and the platform entrypoint default it to
# the in-compose alias; set this only when your backend service has another
# name. The backend roles never read it.
# TALE_BACKEND_URL=http://backend-api:3005

# Deployment capacity shared by all organizations. Pass this into the sandbox
# service's environment and recreate it to apply. Counts include running idle
# containers; the cap does not reserve CPU/RAM. An organization's three workload
# limits add up automatically and cannot be saved above this capacity.
# Unset on a Docker host, the spawner sizes it from the host's memory (8 to 256:
# 19 on 16 GiB, 9 where agent sessions run Docker inside) and starts a new
# session only while the host keeps SANDBOX_MIN_FREE_MEMORY free. Set it on
# Kubernetes, with a remote Docker daemon or beside other heavy workloads,
# starting from measured task peaks and leaving CPU/RAM for platform services
# and the host. See docs/en/self-hosted/configuration/environment-reference.md
# for sizing and applying changes. Explicitly configured values remain in effect.
# SANDBOX_MAX_SESSIONS=8
# Memory a new session must leave free on the Docker host (default: a tenth of
# it, at least 1g).
# SANDBOX_MIN_FREE_MEMORY=2g
# Free space a new session must leave on the disk the session workspaces live
# on (default: a twentieth of it, at least 2g, at most 20g; 0 turns the check
# off). Below it, new sessions wait and the build caches of organizations that
# are not building go first.
# SANDBOX_MIN_FREE_DISK=10g
# How long a session that no turn or run holds stays up once idle, in ms (agent
# sessions with Docker inside keep the full idle window).
# SANDBOX_SESSION_RELEASED_IDLE_MS=300000
# Workloads allowed to start inner Docker when DinD is enabled. Unset keeps
# project,workflow; project allows Docker only for project agents; none disables
# it for both. Applies to newly created sessions; existing compute is retained.
# SANDBOX_DOCKER_WORKLOADS=project
# Per-agent resource limits, applied to newly created sandbox sessions.
# Leave memory unset for 4g per session without inner Docker, or 8g with it.
# SANDBOX_AGENT_CPUS=2
# SANDBOX_AGENT_MEMORY=4g
# CPU weight of agent sessions and their build-cache helpers when the host is
# saturated (Docker's default, which the platform services keep, is 1024;
# default-profile sessions use 128). An idle host still grants the full quota.
# SANDBOX_AGENT_CPU_SHARES=256
# Backend API + worker: profile for NEW agent/workflow workspaces. agent-light
# keeps coding tools and persistent files without Docker/BuildKit. Existing
# workspace rows retain their profile. Recreate backend services after changing.
# SANDBOX_AGENT_PROFILE=agent
# Backend API + worker: optional Claude Code effort (low|medium|high|max).
# Lower values omit automatic Ultrathink; adaptive thinking remains enabled.
# Unset inherits the harness default; compare representative task outcomes
# before lowering effort.
# TALE_SANDBOX_CLAUDE_EFFORT=max
# Total spawner startup deadline, including optional cache setup and readiness.
# SANDBOX_SESSION_CREATE_TIMEOUT_MS=180000
# Optional explicit Docker-data monitor, preferred over automatic verification
# of the existing hostname bind. ROOT must match DockerRootDir; the CLI mounts
# it read-only at PATH. Raw compose needs an override bind mount.
# Configured unreadable or mismatched mounts block new/reactivated sessions.
# Without an explicit path, failed discovery leaves workspace admission active.
# SANDBOX_DOCKER_DATA_ROOT=/var/lib/docker
# SANDBOX_DOCKER_DATA_PATH=/var/lib/tale-sandbox/docker-data
# Shared builder CPU/memory limits. Solver parallelism follows whole CPUs,
# with a minimum of one; it takes effect when an idle helper is recreated.
# SANDBOX_BUILDKITD_CPUS=2
# SANDBOX_BUILDKITD_MEMORY=16g
# Shared-cache producer budget (100–60000 ms), including queued Docker calls.
# A session waits at most this budget or one quarter of its startup budget;
# expiry falls back to local builds. Cancelling one wait preserves shared setup.
# SANDBOX_BUILDKITD_PROVISION_TIMEOUT_MS=5000
# Build cache an organization's build-cache helper (Docker inside the sandbox)
# keeps when it stops for want of agent sessions: pruned to this size, least
# recently used first, right before the stop.
# SANDBOX_BUILDKITD_IDLE_CACHE=5g
# How long an organization's stopped build-cache helpers keep their caches
# before the spawner removes them (whole days or hours; off keeps them).
# SANDBOX_BUILDKITD_CACHE_RETENTION=14d
# Connections the sandbox egress proxy serves at once for all sessions together
# (read by sandbox-egress; recreate it to apply). A higher value needs the
# egress container's pids and open-file limits raised with it.
# SANDBOX_EGRESS_MAX_CLIENTS=2000

# ============================================================================
# Object store — the deployment's blob backend
# ============================================================================
# Uploaded documents, chat attachments, audio and generated media live in an
# S3-compatible store: the bundled `object-store` service, or any bucket you
# bring (AWS S3, MinIO, R2, Wasabi). It is the ONLY blob backend, so a
# deployment that cannot reach it refuses every upload. An organization that
# points its own blobs at a bucket of its own (Settings > Data residency) is
# resolved BEFORE this deployment default and is unaffected by these values.
#
# These variables are read on EVERY start and the backend keeps the deployment
# default (default/object-storage/connection.json in the config volume) in step
# with them — so repointing the store, or rotating an external bucket's
# credentials, is an edit here plus a restart of backend-api and
# backend-worker. The boot log says what happened: seeded / reconciled /
# adopted / ignored / skipped. To manage that file by hand instead, set
# "managedBy": "operator" in it and the backend will never touch it.
#
# For the BUNDLED store, OBJECT_STORE_SECRET_KEY is the store's own root
# password and must stay STABLE — changing it orphans every blob written under
# the old credential. For an EXTERNAL bucket it is just a credential, and
# changing it here is how you rotate it.
#
# A compose stack you wrote yourself must set the ACCESS and SECRET keys: the
# backend has no defaults for them (the shipped compose files pass `tale` and
# the generated secret), and with either missing it logs
# `object store (skipped)` at boot and refuses every upload.
#
# OBJECT_STORE_ACCESS_KEY=tale
# OBJECT_STORE_SECRET_KEY=change-me-to-a-strong-secret
# OBJECT_STORE_BUCKET=tale-blobs
#
# OBJECT_STORE_ENDPOINT is where the backend reaches the store; the in-compose
# default http://object-store:9000 works as-is. `bun dev` runs the backend on
# the host and uses the published port instead (see compose.dev.yml). LEAVE IT
# UNSET for AWS S3 proper — the bucket is then addressed at
# https://<bucket>.s3.<region>.amazonaws.com.
# OBJECT_STORE_ENDPOINT=http://object-store:9000
#
# OBJECT_STORE_REGION is the signing region: meaningful on AWS, arbitrary but
# required by the signer for a self-hosted store.
# OBJECT_STORE_REGION=us-east-1
#
# OBJECT_STORE_FORCE_PATH_STYLE addresses the bucket as endpoint/bucket/key
# rather than bucket.endpoint/key. It follows the endpoint by default — true
# when one is set (a self-hosted store has no per-bucket DNS), false when it is
# not (AWS deprecated path-style) — so set it only for a store that disagrees
# with its own shape.
# OBJECT_STORE_FORCE_PATH_STYLE=true
#
# OBJECT_STORE_PREFIX namespaces Tale's blobs inside the bucket, so one bucket
# can hold other data too. Empty means the bucket root.
# OBJECT_STORE_PREFIX=tale/prod
#
# The bucket is CREATED only if it is absent: the backend probes with
# HeadBucket first, so a key that may read/write/delete objects but not create
# buckets works fine against a bucket you provisioned yourself.
#
# OBJECT_STORE_PUBLIC_ENDPOINT is where the BROWSER reaches the store: the
# proxy publishes the store at `/<bucket>/*` and forwards it verbatim, so
# presigned upload/download URLs work from the browser without exposing the
# store itself. Uploads and downloads then run browser↔store directly — the
# store, not the app server, answers the Range requests media seeking needs.
# The shipped compose files pass your SITE_URL; a compose you wrote yourself
# must set it, and set it BEFORE THE FIRST BOOT — the deployment-default blob
# connection is seeded once and is not rewritten afterwards, so a stack that
# started without it hands browsers URLs on the internal hostname and every
# upload fails there. Override the value only if you publish the store
# elsewhere. With ADDITIONAL_SITE_URLS, a browser on another configured origin
# gets links signed for that origin instead (the proxy publishes the bucket
# path on each of them), as long as this value is itself one of the site
# origins; background work, which has no browser, keeps this value.
# OBJECT_STORE_PUBLIC_ENDPOINT=https://tale.example.com

# ============================================================================
# Provider Secrets Encryption (SOPS + age)
# ============================================================================
# Controls how provider API key files (providers/*.secrets.json) are stored
# on disk. `tale init` provisions SOPS_AGE_KEY by default — the encrypted
# mode is the default; the other two modes below are reachable via post-init
# .env edits.
#
#   - SOPS_AGE_KEY=AGE-SECRET-KEY-1...   inline age secret key. Default after
#                                        `tale init`. Files written encrypted.
#                                        Multiple keys are NOT supported in
#                                        the inline form — use the file form
#                                        below for rotation.
#
#   - SOPS_AGE_KEY_FILE=/path/to/key     path to a file containing one OR
#                                        MORE age secret keys, one per line
#                                        (`#` comments allowed). Use this
#                                        when the key is supplied by Vault,
#                                        a Kubernetes Secret mount, systemd
#                                        LoadCredential, etc., AND for key
#                                        rotation (see below).
#
#   - Both unset                         providers/*.secrets.json stored as
#                                        plaintext JSON at mode 0600. Reach
#                                        this mode by clearing SOPS_AGE_KEY
#                                        in this file post-init and re-saving
#                                        keys via Settings → AI providers.
#                                        Choose this only if (a) the host
#                                        disk is encrypted at rest, or (b)
#                                        you write the *.secrets.json files
#                                        yourself via external tooling (K8s
#                                        Secret volume, Vault agent
#                                        template). In case (b) do not use
#                                        the UI to save keys — it would
#                                        overwrite the mount.
#
# Key rotation (SOPS_AGE_KEY_FILE only):
#   1. Append the new age key as a new line in SOPS_AGE_KEY_FILE.
#   2. Re-save each provider's API key via Settings → AI providers. Each
#      save now produces ciphertext readable by BOTH old and new keys.
#   3. Once every provider has been re-saved, remove the old key from the
#      file. New saves only encrypt to the new recipient; existing files
#      continue to decrypt because sops walks all keys in the file.
#
# Note: ENCRYPTION_SECRET_HEX (above) drives the guardrails secret-box and is
# independent of these settings.
# Generate a new age key manually with: age-keygen
SOPS_AGE_KEY=
# SOPS_AGE_KEY_FILE=

# ---------------------------------------------------------------------------
# Provider API keys from environment variables (issue #1711)
# ---------------------------------------------------------------------------
# A provider may read its API key from an env var (instead of a *.secrets.json
# file) via a `secretsEnv` field in its provider config. The referenced name
# must start with the reserved prefix TALE_PROVIDER_KEY_ — any other name is
# rejected (fail-closed), so `secretsEnv` can never point at a deployment secret
# (SOPS_AGE_KEY, BETTER_AUTH_SECRET, DB_PASSWORD, ...) and have it sent as a
# bearer token to a provider's base URL. The suffix is 1-64 characters of
# A-Z, 0-9 and _. Define the variable here / in your secret manager so the
# backend (api + worker) can read it.
#
#   TALE_PROVIDER_KEY_OPENROUTER=sk-or-...

# ---------------------------------------------------------------------------
# Subscription-broker credentials — the broker's own auth secret
# ---------------------------------------------------------------------------
# A provider credential with the `subscription-broker` auth method fetches a
# pool of rotating LLM keys from an external broker. The broker's own auth
# secret can live in an encrypted <slug>.secrets.json sidecar, OR be read from
# an env var named by the credential's `secretEnv` field. The referenced name
# must start with the reserved prefix TALE_TOKEN_SOURCE_ — any other name is
# rejected (fail-closed), so `secretEnv` can never point at an unrelated
# deployment secret and leak it to the broker. The suffix is per-credential
# (one var per broker). Define the variable here / in your secret manager so
# the backend (api + worker) can read it.
#
#   TALE_TOKEN_SOURCE_COOLAI=brk_live_...

# ---------------------------------------------------------------------------
# Video-link ingestion (yt-dlp) — anti-bot-detection options
# ---------------------------------------------------------------------------
# Pasting a video link (YouTube, Vimeo, …) fetches its transcript for the
# agent. YouTube blocks automated access from datacenter/server IPs with a
# "Sign in to confirm you're not a bot" wall, so ingestion can fail on a
# typical cloud deployment. The self-hosted stack ships a PO-token provider
# (bgutil) wired up by default to counter this — no config needed. The options
# below are OPTIONAL overrides/escalations; none guarantees a bypass (YouTube's
# countermeasures are adversarial), but each makes traffic look more legitimate.
# Highest leverage first. See docs/self-hosted/configuration/environment-reference.
#
# Route extraction through an egress proxy (residential/ISP IPs work best;
# datacenter proxies are usually flagged too). socks5h:// resolves DNS at the
# proxy. Schemes: http, https, socks4, socks4a, socks5, socks5h.
#   VIDEO_INGEST_PROXY_URL=socks5h://user:pass@residential.example:1080
#
# PO-token provider (bgutil HTTP server) base URL — supplies the GVS tokens
# that dissolve the bot wall for the mweb/web/tv_simply clients. ZERO CONFIG in
# the self-hosted stack: the bgutil plugin is baked into the platform image and
# the `bgutil-provider` compose sidecar serves tokens, so this defaults to
# http://bgutil-provider:4416 automatically. Only set this to point at a
# provider on a different host/port.
#   VIDEO_INGEST_POT_PROVIDER_URL=http://127.0.0.1:4416
#
# yt-dlp plugin directory (--plugin-dirs root). Defaults to the baked-in
# /opt/yt-dlp/plugins when present. The bgutil zip must live in a NAMED child
# (plugins/bgutil/yt_dlp_plugins/…) — yt-dlp iterates children of this root.
#   VIDEO_INGEST_YTDLP_PLUGIN_DIRS=/opt/yt-dlp/plugins
#
# A Netscape cookie jar. Guest cookies from an anonymous incognito session
# raise the rate limit with no account-ban risk; account cookies unlock gated
# content but risk the account. The file lives on your disk; only its path is
# passed to yt-dlp.
#   VIDEO_INGEST_COOKIES_FILE=/secrets/yt-cookies.txt
#
# YouTube player-client list (comma-separated, tried in order). Default is
# `default,tv_simply` without a PO provider, or `default,mweb,tv_simply` when
# the baked bgutil provider is present (mweb needs a GVS token). Override to
# force a list:
#   VIDEO_INGEST_PLAYER_CLIENT=default,mweb
#
# When yt-dlp asks the provider for PO tokens (never|auto|always). Defaults to
# `always` whenever a provider is wired — yt-dlp's own `auto` never requests a
# token for the player request, which is exactly where the bot wall hits. Set
# `never` to bypass a misbehaving provider without tearing it down.
#   VIDEO_INGEST_FETCH_POT=always
#
# Manually pinned PO token (CLIENT.CONTEXT+TOKEN). Mainly for testing — tokens
# are video-ID-bound and short-lived; prefer the provider above.
#   VIDEO_INGEST_PO_TOKEN=mweb.gvs+XXXX
#
# Browser TLS/JA3 impersonation for the web clients. Requires curl_cffi in the
# image; leave unset unless you know it's available.
#   VIDEO_INGEST_IMPERSONATE=safari
#
# Toolchain location (self-provisioned yt-dlp/ffmpeg). The platform image bakes
# both into the pinned PATH, so leave these unset there; set them on a host or
# dev box that provides its own binaries.
#   VIDEO_INGEST_BIN_DIR: directory PREPENDED to the child PATH so a yt-dlp (and
#   its Deno runtime) installed outside the pinned dirs is found first.
#   VIDEO_INGEST_BIN_DIR=/home/tale/.local/bin
#   VIDEO_INGEST_FFMPEG_LOCATION: absolute path to ffmpeg for yt-dlp's post-
#   processing. Defaults to /usr/bin/ffmpeg; point it at e.g. Homebrew's build.
#   VIDEO_INGEST_FFMPEG_LOCATION=/opt/homebrew/bin/ffmpeg

# ---------------------------------------------------------------------------
# Connector OAuth apps (Settings > Connectors → Connect)
# ---------------------------------------------------------------------------
# Each oauth2 connector needs a vendor app registration. An org admin can
# configure one per organization under Settings > Connectors > OAuth apps;
# the variables here are the deployment-wide default underneath (and the only
# source for Slack). Never in connector.yml. Naming is mechanical:
#   CONNECTOR_OAUTH_<SLUG>_CLIENT_ID
#   CONNECTOR_OAUTH_<SLUG>_CLIENT_SECRET
# with the slug upper-cased and dashes turned into underscores. Redirect URI
# (register on the vendor app): ${SITE_URL}${BASE_PATH}/api/connectors/oauth2/callback
#
# Slack additionally needs its app's signing secret: the inbound Events
# endpoint verifies every delivery with it before anything is parsed, and
# answers 503 while it is unset. Events Request URL (register on the Slack
# app): ${SITE_URL}${BASE_PATH}/api/connectors/slack/events — deliveries are
# verified, routed to the connected organization and acknowledged; no
# surface processes them further in this version.
#   CONNECTOR_SLACK_SIGNING_SECRET=
#
# Knowledge Documents cloud import (per-user OneDrive/Google Drive grants —
# NOT an org connector). Org-level OAuth apps configured in the UI take
# precedence here too. Redirect URI to register on the vendor app:
#   ${SITE_URL}${BASE_PATH}/api/cloud-import/oauth2/callback
# Credential resolution order for OneDrive / Microsoft 365:
#   CLOUD_IMPORT_MICROSOFT_CLIENT_ID / _SECRET / _TENANT_ID
#   AUTH_MICROSOFT_ENTRA_ID_ID / _SECRET / _TENANT_ID
# Single-tenant Entra apps require the Directory (tenant) ID — `/common` is
# rejected (AADSTS50194). Use `organizations` or `common` for multi-tenant
# apps (`common` also allows personal Microsoft accounts).
# Optional dedicated Microsoft pair:
#   CLOUD_IMPORT_MICROSOFT_CLIENT_ID=
#   CLOUD_IMPORT_MICROSOFT_CLIENT_SECRET=
#   CLOUD_IMPORT_MICROSOFT_TENANT_ID=
# Google Drive (required for From Google Drive — no login-app fallback):
#   CLOUD_IMPORT_GOOGLE_DRIVE_CLIENT_ID=
#   CLOUD_IMPORT_GOOGLE_DRIVE_CLIENT_SECRET=

# --- Docs screenshot pipeline (dev-only; services/platform/tests/docs-screenshots) ---
# Docs/marketing screenshots can isolate reusable authentication and org IDs
# outside the checkout. CLI --state-dir takes precedence; config writes need
# an explicit --config-dir flag. See tests/docs-screenshots/README.md.
# TALE_SCREENSHOT_STATE_DIR=/absolute/path/to/capture-state

# --- Docs video pipeline (dev-only; services/platform/tests/docs-videos) ---
# `bun run docs:videos` narrates with ElevenLabs. Its key, ELEVENLABS_API_KEY,
# goes in the gitignored repo-root .env.dev (the pipeline loads it itself),
# never in this file: Bun loads the .env copied from here into the pipeline,
# and a value there wins over .env.dev. Setup and runbook:
# services/platform/tests/docs-videos/README.md.

# --- Tale CLI configuration releases (operator process only) ---
# `tale config deploy` and `tale config verify-native` read this cookie from
# their process environment. Inject the authorized native session privately;
# do not pass it as a CLI argument or add it to platform/container variables.
# The CLI does not load this example file. See the configuration release guide.
# TALE_CONFIG_COOKIE=
# `tale deploy prepare` and source-bound `tale inference prepare` acquire private client source with the contents
# of a read-only SSH key. Inject it only into that CLI process; it is never
# placed in the prepared bundle, platform environment or native receipts.
# TALE_SOURCE_SSH_KEY=
# --- Private inference (declared operator/target environments only) ---
# The client inference spec names its own TALE_* admin/service key variables.
# Inject distinct 32–256 character URL-safe keys privately; never put real
# values in the source spec or prepared bundle. The admin key stays on the Mac.
# The managed CLI maps the service key to this native provider alias and
# explicitly enables private provider endpoints only for that deployment.
# TALE_PROVIDER_KEY_LOCAL_INFERENCE=
# TALE_ALLOW_PRIVATE_PROVIDER_HOSTS=1
# --- Account creation ---
# `/api/auth/sign-up/email` closes once this deployment holds an account: the
# setup flow (or the managed CLI) creates the first, an administrator creates
# the rest under Settings > Members. Set to exactly `true` ONLY on a throwaway
# test stack that mints its own accounts over HTTP; local dev already sets it
# for you (services/platform/scripts/dev-engine.ts, compose.dev.yml).
# TALE_ALLOW_OPEN_SIGN_UP=true
# --- Organization creation ---
# Unset, every signed-in user may create an organization, as every
# self-managed deployment always could. Set it to the sign-in addresses that
# may (commas, semicolons or spaces; matched case-insensitively) and everyone
# else is refused with 403 ORGANIZATION_CREATION_FORBIDDEN once the deployment
# holds its first organization; that first one, the setup flow's, is always
# allowed. Set but empty closes creation to everyone. A managed deployment
# writes this from `organizations.creators` in its specification.
# TALE_ORGANIZATION_CREATORS=ops@example.org,lead@example.org

# ============================================================================
# Application backend — always part of the stack
# ============================================================================
# The platform image runs the Postgres-backed backend as two services that
# every deployment brings up: `backend-api` (auth, the app API, the hint
# stream, both machine doors, SSO/SCIM/trusted headers, the control channel,
# cloud-import OAuth, WebDAV) and `backend-worker` (schedules, watchdogs,
# agent turns). Scale either with --scale. No extra secrets: they reuse
# DB_PASSWORD and store state in the `tale_app` database (APP_DB_NAME, above);
# TALE_ROLE and DATABASE_URL are set by compose. Schema migrations apply
# themselves at backend boot, and `tale migrate` re-provisions the built-in
# defaults into every org.
#
# BACKEND_UPSTREAM is where the proxy reaches the api. The default
# `backend-api:3005` is the in-compose service; set it only for a split
# deployment that runs the backend elsewhere.
# BACKEND_UPSTREAM=backend-api:3005

# Optional aggregate analytics, read at runtime; all three values are required.
# Empty UMAMI_WEBSITE_ID disables tracking. The token stays server-side.
# UMAMI_URL is the HTTPS origin of the authenticated /_collect gateway.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_PROXY_TOKEN=
