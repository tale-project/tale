{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rangeStrategy": "pin",
  "automerge": false,
  "minimumReleaseAge": "90 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Zurich",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [],
    "prCreation": "immediate",
    "labels": ["dependencies", "security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Patch updates: 30 day stabilization, grouped",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "minimumReleaseAge": "30 days",
      "groupName": "patch updates"
    },
    {
      "description": "Minor updates: 60 day stabilization, grouped",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "60 days",
      "groupName": "minor updates"
    },
    {
      "description": "GitHub Actions: keep SHA-digest pins current (grouped, short stabilization) so the supply-chain pins don't silently age",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Disable Convex-related packages (manual upgrades only)",
      "matchPackageNames": ["convex", "/^convex-/", "/^@convex-dev\\//"],
      "enabled": false
    },
    {
      "description": "Disable AI SDK packages (manual upgrades only)",
      "matchPackageNames": ["ai", "/^@ai-sdk\\//"],
      "enabled": false
    },
    {
      "description": "WebAuthn/passkey deps (#1508) must move in lockstep with better-auth core, which is upgraded manually. Group them and waive the generic minimumReleaseAge so a security or compatibility bump isn't held back out of sync with better-auth.",
      "matchPackageNames": [
        "better-auth",
        "/^@better-auth\\//",
        "/^@simplewebauthn\\//"
      ],
      "minimumReleaseAge": null,
      "groupName": "better-auth"
    }
  ]
}
