{
  "$schema": "https://turbo.build/schema.v2.json",
  "globalEnv": ["TALE_CI_RUNTIME"],
  "globalPassThroughEnv": [
    "DO_NOT_TRACK",
    "TURBO_TELEMETRY_DISABLED",
    "STORYBOOK_DISABLE_TELEMETRY",
    "TELEMETRY_DISABLED",
    "SCARF_ANALYTICS",
    "NODE_COMPILE_CACHE",
    "SANDBOX_TOKEN",
    "GITHUB_TOKEN",
    "GH_TOKEN"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "setup": {
      "cache": false,
      "outputs": [".venv/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/bin/build-client.ts"
      ]
    },
    "@tale/db#build": {
      "outputs": []
    },
    "@tale/proxy#build": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["setup"],
      "cache": false,
      "persistent": true
    },
    "serve": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "@tale/cli#generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "env": [
        "YOUTUBE_LIVE_TEST",
        "VIDEO_INGEST_YTDLP_PLUGIN_DIRS",
        "VIDEO_INGEST_POT_PROVIDER_URL"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:ui": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": []
    },
    "test:prerender": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"]
    },
    "knip": {
      "cache": false,
      "outputs": []
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "dependsOn": ["^transit"],
      "outputs": ["storybook-static/**"]
    },
    "docker:build": {
      "cache": false,
      "outputs": []
    },
    "@tale/cli#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    }
  },
  "globalDependencies": [
    ".github/actions/setup-turbo/action.yml",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "tsconfig*.json",
    "bunfig.toml",
    "patches/**"
  ]
}
