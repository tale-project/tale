# EditorConfig — cross-editor baseline so non-VS-Code contributors match the
# formatter (oxfmt for JS/TS). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Don't strip trailing whitespace in Markdown — two trailing spaces are a
# hard line break.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
