{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/services/platform/backend/core/lib/config_store/value_hash.ts",
        "$TURBO_ROOT$/services/platform/lib/shared/utils/stable-stringify.ts",
        "$TURBO_ROOT$/scripts/publish-package.ts",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/packages/ui/package.json",
        "$TURBO_ROOT$/packages/ui/README.md",
        "$TURBO_ROOT$/packages/marketing-ui/package.json",
        "$TURBO_ROOT$/packages/marketing-ui/README.md",
        "$TURBO_ROOT$/.github/workflows/publish-packages.yml",
        "$TURBO_ROOT$/docs/*/self-hosted/install/cli-install.md",
        "$TURBO_ROOT$/scripts/install-cli.sh",
        "$TURBO_ROOT$/scripts/install-cli.ps1",
        "$TURBO_ROOT$/.github/workflows/build.yml",
        "$TURBO_ROOT$/.github/workflows/checks.yml",
        "$TURBO_ROOT$/.github/workflows/cleanup-pr-images.yml",
        "$TURBO_ROOT$/.github/workflows/commitlint.yml",
        "$TURBO_ROOT$/.github/workflows/e2e.yml",
        "$TURBO_ROOT$/.github/workflows/release-candidate-receipt.yml",
        "$TURBO_ROOT$/.github/workflows/release-candidate-source.yml",
        "$TURBO_ROOT$/.github/workflows/sast.yml",
        "$TURBO_ROOT$/.github/workflows/security.yml",
        "$TURBO_ROOT$/.github/actions/setup-cli/action.yml",
        "$TURBO_ROOT$/.github/workflows/cli.yml",
        "$TURBO_ROOT$/.github/workflows/release.yml",
        "$TURBO_ROOT$/compose.yml",
        "$TURBO_ROOT$/services/proxy/Caddyfile",
        "$TURBO_ROOT$/services/proxy/docker-entrypoint.sh",
        "$TURBO_ROOT$/services/platform/Dockerfile",
        "$TURBO_ROOT$/services/platform/docker-entrypoint.sh",
        "$TURBO_ROOT$/services/platform/env.sh",
        "$TURBO_ROOT$/services/db/Dockerfile",
        "$TURBO_ROOT$/services/sandbox-egress/Dockerfile",
        "$TURBO_ROOT$/services/platform/turbo.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/services/*/package.json",
        "$TURBO_ROOT$/services/sandbox-runtime/daemon/package.json",
        "$TURBO_ROOT$/tools/*/package.json",
        "$TURBO_ROOT$/configs/platform/custom/skills/*/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.github/actions/setup-turbo/action.yml",
        "$TURBO_ROOT$/services/platform/backend/core/**",
        "$TURBO_ROOT$/services/platform/lib/**",
        "$TURBO_ROOT$/configs/platform/**",
        "!$TURBO_ROOT$/configs/platform/**/.turbo/**"
      ],
      "dependsOn": ["generate", "^transit"]
    },
    "generate": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/services/platform/backend/core/**",
        "$TURBO_ROOT$/services/platform/lib/**",
        "$TURBO_ROOT$/configs/platform/**",
        "!$TURBO_ROOT$/configs/platform/**/.turbo/**"
      ]
    },
    "setup": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/services/platform/backend/core/**",
        "$TURBO_ROOT$/services/platform/lib/**",
        "$TURBO_ROOT$/configs/platform/**",
        "!$TURBO_ROOT$/configs/platform/**/.turbo/**"
      ]
    },
    "lint": {
      "dependsOn": ["generate", "^transit"]
    }
  }
}
