{
  "name": "@tale/cli",
  "version": "1.0.0-dev",
  "type": "module",
  "scripts": {
    "generate": "bun run scripts/generate-embedded.ts",
    "setup": "bun run generate",
    "build": "bun run generate && bun run build:linux && bun run build:mac && bun run check:bundle",
    "build:linux": "bun build --compile --define TALE_COMPILED=true --target=bun-linux-x64 --outfile=dist/tale src/index.ts",
    "build:linux-arm64": "bun build --compile --define TALE_COMPILED=true --target=bun-linux-arm64 --outfile=dist/tale src/index.ts",
    "build:mac": "bun build --compile --define TALE_COMPILED=true --target=bun-darwin-arm64 --outfile=dist/tale src/index.ts",
    "build:mac-x64": "bun build --compile --define TALE_COMPILED=true --target=bun-darwin-x64 --outfile=dist/tale src/index.ts",
    "build:windows": "bun run generate && bun build --compile --define TALE_COMPILED=true --target=bun-windows-x64 --outfile=dist/tale.exe src/index.ts && bun run scripts/check-bundle.ts dist/tale.exe",
    "check:bundle": "bun run scripts/check-bundle.ts dist/tale",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@inquirer/prompts": "8.4.1",
    "@noble/curves": "1.9.7",
    "@scure/base": "2.0.0",
    "@tale/shared": "workspace:*",
    "ajv": "8.20.0",
    "commander": "14.0.3",
    "crc-32": "1.2.2",
    "jszip": "3.10.1",
    "yaml": "2.8.3",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@better-auth/core": "1.6.30",
    "@types/bun": "1.3.11",
    "@types/yauzl": "3.4.0",
    "better-auth": "1.6.30",
    "typescript": "6.0.2"
  }
}
