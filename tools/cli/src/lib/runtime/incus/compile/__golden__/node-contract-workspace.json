{
  "schemaVersion": 1,
  "kind": "tale.incus.node-contract",
  "path": "workspace",
  "stack": "tale",
  "extensions": [
    "instance_oci",
    "instance_oci_entrypoint",
    "oci_network_config",
    "storage_shifted",
    "storage_initial_owner",
    "file_storage_volume",
    "projects_restricted_backups_and_snapshots",
    "projects_restricted_image_servers",
    "instance_auto_restart"
  ],
  "server": {
    "clustered": false,
    "idmappedMounts": true,
    "minimumZfs": "2.2"
  },
  "project": {
    "name": "tale-stack",
    "config": {
      "features.images": "true",
      "features.networks": "false",
      "features.profiles": "true",
      "features.storage.volumes": "true",
      "limits.instances": "22",
      "limits.memory": "112384MiB",
      "limits.processes": "55296",
      "limits.virtual-machines": "0",
      "restricted": "true",
      "restricted.backups": "block",
      "restricted.containers.interception": "block",
      "restricted.containers.lowlevel": "block",
      "restricted.containers.nesting": "block",
      "restricted.containers.privilege": "isolated",
      "restricted.devices.disk": "managed",
      "restricted.devices.nic": "managed",
      "restricted.devices.proxy": "allow",
      "restricted.images.servers": "docker.io,ghcr.io",
      "restricted.networks.access": "talebr0",
      "restricted.snapshots": "allow",
      "restricted.storage-pools.access": "tale"
    }
  },
  "profile": {
    "name": "tale-stack",
    "config": {
      "limits.memory": "2GiB",
      "limits.processes": "2048"
    },
    "devices": {
      "root": {
        "type": "disk",
        "path": "/",
        "pool": "tale",
        "size": "10GiB"
      }
    }
  },
  "network": {
    "name": "talebr0",
    "type": "bridge",
    "subnet": "10.30.0.0/16",
    "gateway": "10.30.0.1",
    "block": "10.30.1.0/24",
    "config": {
      "ipv4.address": "10.30.0.1/16",
      "ipv4.dhcp.ranges": "10.30.2.0-10.30.255.254",
      "ipv4.nat": "true",
      "ipv6.address": "none",
      "security.acls": "tale-tale-stack",
      "security.acls.default.egress.action": "drop",
      "security.acls.default.ingress.action": "drop"
    }
  },
  "acls": {
    "stack": "tale-tale-stack",
    "sessions": "tale-tale-stack-sessions",
    "rules": [
      {
        "id": "stack-to-stack",
        "acl": "stack",
        "direction": "egress",
        "source": ["10.30.1.0/24"],
        "destination": ["10.30.1.0/24"],
        "purpose": "Traffic between the stack's own instances on the app bridge.",
        "check": "listed"
      },
      {
        "id": "stack-from-stack",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.30.1.0/24"],
        "destination": ["10.30.1.0/24"],
        "purpose": "Traffic between the stack's own instances on the app bridge.",
        "check": "listed"
      },
      {
        "id": "names-to-gateway-udp",
        "acl": "stack",
        "direction": "egress",
        "source": ["10.30.1.2/32", "10.30.1.3/32", "10.30.1.16/28"],
        "destination": ["10.30.0.1/32"],
        "protocol": "udp",
        "ports": [53],
        "purpose": "The stack resolver forwards every name it does not hold to the bridge's own DNS.",
        "check": "probe"
      },
      {
        "id": "names-to-gateway-tcp",
        "acl": "stack",
        "direction": "egress",
        "source": ["10.30.1.2/32", "10.30.1.3/32", "10.30.1.16/28"],
        "destination": ["10.30.0.1/32"],
        "protocol": "tcp",
        "ports": [53],
        "purpose": "The stack resolver forwards every name it does not hold to the bridge's own DNS.",
        "check": "listed"
      },
      {
        "id": "spawner-to-incus",
        "acl": "stack",
        "direction": "egress",
        "source": ["10.30.1.11/32", "10.30.1.16/28"],
        "destination": ["10.30.0.1/32"],
        "protocol": "tcp",
        "ports": [8443],
        "purpose": "The sandbox spawner drives the sessions through the Incus API (runtime.incus.endpoint).",
        "check": "probe"
      },
      {
        "id": "spawner-to-sessions",
        "acl": "stack",
        "direction": "egress",
        "source": ["10.30.1.11/32", "10.30.1.16/28"],
        "destination": ["10.40.0.0/24"],
        "protocol": "tcp",
        "ports": [8200],
        "purpose": "The sandbox spawner calls each session's runner.",
        "check": "probe"
      },
      {
        "id": "public-egress",
        "acl": "stack",
        "direction": "egress",
        "source": [
          "10.30.1.64/28",
          "10.30.1.128/28",
          "10.30.1.80/28",
          "10.30.1.144/28",
          "10.30.1.96/28",
          "10.30.1.160/28",
          "10.30.1.4/32",
          "10.30.1.10/32",
          "10.30.1.9/32",
          "10.30.1.12/32",
          "10.30.1.16/28"
        ],
        "purpose": "The roles that reach the internet: the backend, the platform, the sessions egress proxy, the LLM gateway, the proxy (ACME) and the bgutil provider.",
        "check": "probe"
      },
      {
        "id": "public-to-proxy",
        "acl": "stack",
        "direction": "ingress",
        "destination": ["10.30.1.4/32"],
        "protocol": "tcp",
        "ports": [80, 443],
        "purpose": "The public reaches the proxy (proxy-device ingress).",
        "check": "listed"
      },
      {
        "id": "sessions-to-backend-api",
        "acl": "sessions",
        "direction": "egress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.5/32"],
        "protocol": "tcp",
        "ports": [3005],
        "purpose": "A session calls the backend API through the switch.",
        "check": "listed"
      },
      {
        "id": "stack-from-sessions-backend-api",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.5/32"],
        "protocol": "tcp",
        "ports": [3005],
        "purpose": "A session calls the backend API through the switch.",
        "check": "listed"
      },
      {
        "id": "sessions-to-llm-gateway",
        "acl": "sessions",
        "direction": "egress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.9/32"],
        "protocol": "tcp",
        "ports": [8080],
        "purpose": "A session calls the LLM gateway.",
        "check": "listed"
      },
      {
        "id": "stack-from-sessions-llm-gateway",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.9/32"],
        "protocol": "tcp",
        "ports": [8080],
        "purpose": "A session calls the LLM gateway.",
        "check": "listed"
      },
      {
        "id": "sessions-to-egress-proxy",
        "acl": "sessions",
        "direction": "egress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.10/32"],
        "protocol": "tcp",
        "ports": [3128],
        "purpose": "A session's outbound traffic goes through the stack's egress proxy.",
        "check": "listed"
      },
      {
        "id": "stack-from-sessions-egress-proxy",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.10/32"],
        "protocol": "tcp",
        "ports": [3128],
        "purpose": "A session's outbound traffic goes through the stack's egress proxy.",
        "check": "listed"
      },
      {
        "id": "sessions-to-names-udp",
        "acl": "sessions",
        "direction": "egress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.3/32"],
        "protocol": "udp",
        "ports": [53],
        "purpose": "A session resolves the names it may reach.",
        "check": "listed"
      },
      {
        "id": "stack-from-sessions-names-udp",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.3/32"],
        "protocol": "udp",
        "ports": [53],
        "purpose": "A session resolves the names it may reach.",
        "check": "listed"
      },
      {
        "id": "sessions-to-names-tcp",
        "acl": "sessions",
        "direction": "egress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.3/32"],
        "protocol": "tcp",
        "ports": [53],
        "purpose": "A session resolves the names it may reach.",
        "check": "listed"
      },
      {
        "id": "stack-from-sessions-names-tcp",
        "acl": "stack",
        "direction": "ingress",
        "source": ["10.40.0.0/24"],
        "destination": ["10.30.1.3/32"],
        "protocol": "tcp",
        "ports": [53],
        "purpose": "A session resolves the names it may reach.",
        "check": "listed"
      },
      {
        "id": "sessions-from-spawner",
        "acl": "sessions",
        "direction": "ingress",
        "source": ["10.30.1.11/32"],
        "destination": ["10.40.0.0/24"],
        "protocol": "tcp",
        "ports": [8200],
        "purpose": "The sandbox spawner calls each session's runner.",
        "check": "listed"
      }
    ]
  },
  "sessions": {
    "subnet": "10.40.0.0/24",
    "egressProxy": "http://10.30.1.10:3128"
  },
  "storage": {
    "pool": "tale",
    "rootSize": "10GiB",
    "volumes": [
      {
        "name": "caddy-config",
        "kind": "data",
        "config": {}
      },
      {
        "name": "caddy-data",
        "kind": "data",
        "config": {}
      },
      {
        "name": "config-data",
        "kind": "data",
        "config": {}
      },
      {
        "name": "db-backup",
        "kind": "data",
        "config": {}
      },
      {
        "name": "db-data",
        "kind": "data",
        "size": "50GiB",
        "config": {
          "snapshots.expiry": "14d"
        }
      },
      {
        "name": "llm-gateway-data",
        "kind": "data",
        "config": {}
      },
      {
        "name": "object-store-data",
        "kind": "data",
        "config": {}
      },
      {
        "name": "static-assets",
        "kind": "data",
        "config": {}
      },
      {
        "name": "names-config",
        "kind": "runtime",
        "config": {}
      },
      {
        "name": "sandbox-credentials",
        "kind": "runtime",
        "config": {}
      },
      {
        "name": "switch-config",
        "kind": "runtime",
        "config": {}
      }
    ]
  },
  "peak": {
    "description": "the stateful tier, two colours during a flip, and 2 helpers",
    "instances": 22,
    "memoryBytes": 117843165184,
    "processes": 55296,
    "diskBytes": null,
    "imageVersions": 2
  },
  "registries": ["docker.io", "ghcr.io"],
  "certificate": {
    "name": "tale-tale-stack",
    "type": "client",
    "restricted": true,
    "projects": ["tale-stack"]
  },
  "stopPriorities": {
    "groups": {
      "edge": 90,
      "middle": 50,
      "data": 10
    },
    "reservedBand": {
      "from": 10,
      "to": 90
    },
    "dataSignalWithinSeconds": 60,
    "boundHolds": "on a host that runs only Tale"
  },
  "ingress": {
    "mode": "proxy-device",
    "proxy": "10.30.1.4",
    "ports": [80, 443]
  },
  "notes": [
    "Instance-to-instance traffic on the app bridge and DNS to the bridge itself pass an Incus bridge ACL without a rule; their rules are listed for operators who enforce them elsewhere, and check expects no drop there.",
    "Host firewall state cannot be read with the stack's restricted certificate: check judges forwarding by a helper's connections from the app bridge.",
    "The 10/50/90 stop groups bound the data services' signal to about 60 s on a host that runs only Tale; another project's stop priority inside the band adds 30 s per group, so a shared host stops Tale with tale stop first.",
    "limits.disk.pool.tale is left out: Incus refuses a volume without a size in a project that limits the pool, and caddy-config, caddy-data, config-data, db-backup, llm-gateway-data, object-store-data, static-assets, names-config, sandbox-credentials, switch-config declare none (runtime.incus.volumes)."
  ]
}
