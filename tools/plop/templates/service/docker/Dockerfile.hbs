# Tale {{upperFirst name}} — pure-Docker service
ARG VERSION=dev

FROM debian:bookworm-slim

ENV DO_NOT_TRACK=1

WORKDIR /app

# Two-file entrypoint pair. See script header for the split rationale.
COPY services/{{kebabCase name}}/docker-entrypoint.sh /docker-entrypoint.sh
COPY services/{{kebabCase name}}/entrypoint.sh /entrypoint.sh
RUN chmod +x /docker-entrypoint.sh /entrypoint.sh

# Keep VERSION metadata after filesystem layers so version-only builds reuse them.
ARG VERSION=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="tale-{{kebabCase name}}" \
      org.opencontainers.image.description="{{description}}"
ENV TALE_VERSION=${VERSION}

ENTRYPOINT ["/docker-entrypoint.sh"]
