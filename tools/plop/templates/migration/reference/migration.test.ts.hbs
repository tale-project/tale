import { convexTest } from 'convex-test';
import { defineSchema, defineTable } from 'convex/server';
import { v } from 'convex/values';
import { describe, expect, it } from 'vitest';

import { buildModules } from '../../../framework/test_helpers';
import { migration as module } from './migration';

const migration = module.spec;

const DIR = 'migrations/versions/{{versionDirName}}/{{folderName}}';
const modules = buildModules(import.meta.glob('../../../../**/*.*s'), DIR);

// Reference migrations never run through the runner — the round-trip test
// calls the handlers directly over a local fixture schema that carries BOTH
// the pre- and post-change shapes (all changed fields optional).
const fixtureSchema = defineSchema({
  '{{table}}': defineTable({
    // TODO(author): the union of the pre- and post-change row shapes.
    placeholder: v.optional(v.string()),
  }),
});

describe('{{id}} (reference)', () => {
  it('up/down round-trip the documented shape change (idempotent)', async () => {
    const t = convexTest(fixtureSchema, modules);
    void migration;
    void t;
    expect.unreachable('TODO(author): seed pre-change rows and round-trip');
  });
});
