{
  "name": "tale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "services/sandbox-runtime/daemon",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "serve": "bunx turbo run serve",
    "build": "bunx turbo run build",
    "lint": "bunx turbo run lint",
    "lint:fix": "bunx turbo run lint:fix",
    "lint:sast": "bash tools/opengrep/run.sh",
    "format": "oxfmt && bunx turbo run format",
    "format:check": "oxfmt --check && bunx turbo run format:check",
    "check": "bun run format:check && bunx turbo run lint typecheck test",
    "verify": "bun run check && bunx turbo run test:ui && bun run knip:check && bun run lint:sast",
    "test": "bunx turbo run test",
    "test:e2e": "bunx turbo run test:e2e",
    "test:ui": "bunx turbo run test:ui",
    "test:watch": "bunx turbo run test:watch",
    "test:coverage": "bunx turbo run test:coverage",
    "typecheck": "bunx turbo run typecheck",
    "knip": "bunx knip --fix && bunx turbo run format",
    "knip:check": "bunx knip",
    "setup": "bunx turbo run setup",
    "setup:check": "bun services/platform/scripts/setup-check.ts",
    "setup:clean": "bun services/platform/scripts/setup-clean.ts",
    "docker:build": "bunx turbo run docker:build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:test": "bun services/platform/tests/integration/container-smoke-test.ts",
    "docker:test:image": "bun services/platform/tests/integration/container-image-test.ts",
    "docker:test:web": "bun services/platform/tests/integration/container-web-test.ts",
    "docker:test:docs": "bun services/platform/tests/integration/container-docs-test.ts",
    "docker:test:sandbox-runtime": "bun services/platform/tests/integration/container-sandbox-runtime-test.ts",
    "docker:test:vulnerability": "bun services/platform/tests/integration/container-vulnerability-scan.ts",
    "docker:e2e": "bun services/platform/tests/integration/master-e2e-test.ts",
    "commit": "bunx cz",
    "storybook": "bunx turbo run storybook",
    "storybook:ui": "bun run --filter @tale/ui storybook",
    "storybook:platform": "bun run --filter @tale/platform storybook",
    "storybook:web": "bun run --filter @tale/web storybook",
    "storybook:docs": "bun run --filter @tale/docs storybook",
    "gen": "bunx --bun plop --plopfile plopfile.ts",
    "gen:react-service": "bun run gen react-service",
    "gen:react-package": "bun run gen react-package",
    "gen:typescript-package": "bun run gen typescript-package",
    "gen:docker-service": "bun run gen docker-service",
    "gen:tool": "bun run gen tool",
    "prepare": "bunx husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "4.2.2",
    "@tanstack/react-router": "1.168.10",
    "framer-motion": "12.38.0",
    "i18next": "26.0.4",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@storybook/addon-a11y": "10.3.5",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-themes": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tanstack/router-plugin": "1.167.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "knip": "6.3.1",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "plop": "4.0.1",
    "postcss": "8.5.10",
    "postcss-load-config": "6.0.1",
    "storybook": "10.3.5",
    "turbo": "2.9.14",
    "typescript": "6.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vitest-axe": "1.0.0-pre.5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "axios": "1.16.0",
    "brace-expansion": "5.0.6",
    "defu": "6.1.6",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.2",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.12.25",
    "immutable": "3.8.3",
    "ip-address": "10.1.1",
    "kysely": "0.28.17",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "magic-string": "0.30.21",
    "qs": "6.15.2",
    "react-is": "19.2.5",
    "tmp": "0.2.7",
    "uuid": "14.0.0",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "convex-helpers@0.1.114": "patches/convex-helpers@0.1.114.patch",
    "@convex-dev/agent@0.6.1": "patches/@convex-dev%2Fagent@0.6.1.patch"
  },
  "scarfSettings": {
    "enabled": false
  },
  "trustedDependencies": [
    "core-js-pure",
    "esbuild"
  ]
}
