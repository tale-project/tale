{
  "name": "tale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "services/sandbox-runtime/daemon",
    "configs/platform/custom/skills/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "serve": "bunx turbo run serve",
    "build": "bunx turbo run build",
    "lint": "bunx turbo run lint",
    "lint:fix": "bunx turbo run lint:fix",
    "lint:sast": "bash tools/opengrep/run.sh",
    "format": "oxfmt && uvx ruff@0.15.0 format && bunx turbo run format",
    "format:check": "oxfmt --check && uvx ruff@0.15.0 format --check && bunx turbo run format:check",
    "check": "bun run format:check && bunx turbo run lint typecheck test test:ui",
    "verify": "bun run check && bunx turbo run test:ui && bun run knip:check && bun run lint:sast",
    "test": "bunx turbo run test",
    "test:e2e": "bunx turbo run test:e2e",
    "test:ui": "bunx turbo run test:ui",
    "test:watch": "bunx turbo run test:watch",
    "test:coverage": "bunx turbo run test:coverage",
    "typecheck": "bunx turbo run typecheck",
    "knip": "bunx knip --fix && bunx turbo run format",
    "knip:check": "bunx knip",
    "setup": "bunx turbo run setup",
    "setup:check": "bun services/platform/scripts/setup-check.ts",
    "docker:build": "bunx turbo run docker:build",
    "docker:up": "docker compose up -d",
    "docker:dev": "bun scripts/ensure-sandbox-runtime-image.ts && ( docker network inspect tale-sandbox-net >/dev/null 2>&1 || docker network create --internal --ipv6=false --driver=bridge tale-sandbox-net ) && bun scripts/docker-dev-env-override.ts | docker compose -f compose.yml -f compose.dev.yml -f compose.docs.yml -f - up --build -d",
    "docker:dev:down": "docker compose -f compose.yml -f compose.dev.yml -f compose.docs.yml down",
    "docker:dev:logs": "docker compose -f compose.yml -f compose.dev.yml -f compose.docs.yml logs -f",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:test": "bun services/platform/tests/integration/container-smoke-test.ts",
    "docker:test:image": "bun services/platform/tests/integration/container-image-test.ts",
    "docker:test:web": "bun services/platform/tests/integration/container-web-test.ts",
    "docker:test:docs": "bun services/platform/tests/integration/container-docs-test.ts",
    "docker:test:sandbox-runtime": "bun services/platform/tests/integration/container-sandbox-runtime-test.ts",
    "docker:test:vulnerability": "bun services/platform/tests/integration/container-vulnerability-scan.ts",
    "docker:e2e": "bun services/platform/tests/integration/master-e2e-test.ts",
    "docs:screenshots": "bun services/platform/tests/docs-screenshots/capture.ts",
    "docs:videos": "bun services/platform/tests/docs-videos/produce.ts",
    "readme:assets": "bun services/platform/tests/docs-screenshots/readme-assets.ts",
    "commit": "bunx cz",
    "storybook": "bunx turbo run storybook",
    "storybook:ui": "bun run --filter @tale/ui storybook",
    "storybook:platform": "bun run --filter @tale/platform storybook",
    "storybook:web": "bun run --filter @tale/web storybook",
    "storybook:docs": "bun run --filter @tale/docs storybook",
    "gen": "bunx --bun plop --plopfile plopfile.ts",
    "gen:package": "bun run gen package",
    "gen:service": "bun run gen service",
    "gen:tool": "bun run gen tool",
    "gen:skill": "bun run gen skill",
    "skills:sync": "rm -rf .claude/skills && cp -R .agents/skills .claude/skills",
    "gen:migration": "bun run gen migration",
    "gen:episode": "bun run gen video-episode",
    "generate:icons": "bun scripts/generate-connector-icons.ts",
    "prepare": "bunx husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "4.3.2",
    "@tanstack/react-router": "1.170.17",
    "i18next": "26.3.5",
    "lucide-react": "1.23.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.81.0",
    "tailwindcss": "4.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@iconify-json/logos": "1.2.11",
    "@iconify/utils": "3.1.3",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tale/shared": "workspace:*",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.8",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.25.0",
    "lint-staged": "17.4.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "plop": "4.0.1",
    "postcss": "8.5.23",
    "postcss-load-config": "6.0.1",
    "storybook": "10.4.6",
    "turbo": "2.10.11",
    "typescript": "6.0.2",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "vitest-axe": "1.0.0-pre.5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.18.0",
    "brace-expansion": "5.0.9",
    "defu": "6.1.6",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "html-to-text": "10.0.1",
    "immutable": "4.3.9",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "kysely": "0.29.3",
    "linkify-it": "6.1.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "magic-string": "0.30.21",
    "postcss": "8.5.23",
    "qs": "6.16.0",
    "react-is": "19.2.5",
    "seroval": "1.5.3",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "uuid": "14.0.0",
    "vite": "8.1.3",
    "ws": "8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,md,mdx,css,scss,yaml,yml,html}": "oxfmt -c .oxfmtrc.json --no-error-on-unmatched-pattern",
    "*.py": "uvx ruff@0.15.0 format",
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,py}": "bash -c 'OPENGREP_SKIP_IF_UNCACHED=1 OPENGREP_LOCAL_ONLY=1 tools/opengrep/run.sh \"$@\"' --"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "linkedom@0.18.13": "patches/linkedom@0.18.13.patch"
  },
  "scarfSettings": {
    "enabled": false
  },
  "trustedDependencies": [
    "core-js-pure",
    "esbuild"
  ]
}
