# Exclude design sources from GitHub language statistics (Linguist).
design/sources/** linguist-vendored

# Exclude the generated .claude/skills mirror from Linguist — it is regenerated
# from .agents/skills by `bun run skills:sync` (see tools/skills), not hand-written.
.claude/skills/** linguist-vendored

# Exclude migration schema/config baselines from Linguist — large generated JSON
# fingerprints (see services/platform/scripts/check-{schema,config}-snapshot.ts).
services/platform/convex/migrations/*.snapshot.json linguist-vendored

# These legacy E2E links point at retired builtin-configs domains. Git checkouts
# retain them, but source archives must not contain dangling links: the Actions
# runner follows links while copying a downloaded action and otherwise aborts
# before setup-cli can run. Keep valid docs-demo links and all actual assets.
services/platform/tests/e2e/fixtures/config/default/connectors export-ignore
services/platform/tests/e2e/fixtures/config/default/token-sources export-ignore
