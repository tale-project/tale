{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [
      2,
      "always",
      [
        "ai",
        "claude",
        "cli",
        "convex",
        "db",
        "deps",
        "designs",
        "docs",
        "e2e",
        "opengrep",
        "platform",
        "plop",
        "proxy",
        "sandbox",
        "shared",
        "skills",
        "storybook",
        "ui",
        "web"
      ]
    ],
    "scope-empty": [0],
    "body-max-line-length": [0],
    "footer-max-line-length": [0]
  }
}
