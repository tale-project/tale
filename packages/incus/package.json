{
  "name": "@tale/incus",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Incus REST client over mutual TLS, with an in-memory Incus for tests",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./client": "./src/client.ts",
    "./exec": "./src/exec.ts",
    "./exec-session": "./src/exec-session.ts",
    "./files": "./src/files.ts",
    "./volumes": "./src/volumes.ts",
    "./snapshots": "./src/snapshots.ts",
    "./state": "./src/state.ts",
    "./unix-transport": "./src/unix-transport.ts",
    "./tls": "./src/tls.ts",
    "./units": "./src/units.ts",
    "./fake": "./src/fake.ts",
    "./test-certificates": "./src/test-certificates.ts"
  },
  "scripts": {
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:real": "TALE_INCUS_REAL=1 bun test tests/real"
  },
  "devDependencies": {
    "@peculiar/x509": "1.14.3"
  }
}
